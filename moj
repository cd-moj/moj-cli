#!/usr/bin/env bash
# moj — CLI de autoria de problemas do MOJ. Você não precisa de git nem de chave SSH. Você precisa
# só do seu login do MOJ. Há dois jeitos de trabalhar:
#   • Editor interativo (os campos da página):     moj edit <id|pasta>
#   • Arquivos locais (edite com o seu editor):    moj clone <id> ; edite ; moj push
#     Alguém mudou o problema na web?               moj pull   (traz as mudanças para a pasta)
#
# Conceitos: ORG = quem edita. É o prefixo do id <org>#<prob>. Um problema tem uma org.
#            COLEÇÃO = rótulo de agrupamento. Um problema pode ter várias. O nome pode ter espaços.
# Id implícito: dentro da pasta de um problema (ou de uma subpasta dela), o <id> é opcional.
#   O comando usa o id do .moj-id. Um nome sem a org (moj publish soma) usa a org do .moj-id.
#   Exceção: moj rm e moj mv sempre pedem o id.
#
# Sessão
#   moj login | whoami | logout           Entra, mostra quem você é, sai.
# Listas e painel
#   moj ls [mine|shared|public]           Lista problemas.
#   moj repos                             Lista orgs.
#   moj board                             Mostra o painel dos seus problemas e o que revisar.
#   moj status [<id>] | check [<id>]      status sem id: saúde do sistema. check: QA do problema
#                                         (pacote, TL por juiz, soluções × categoria, entradas,
#                                         e se está PRONTO ou o que falta).
# Pacote
#   moj new <org> <prob>                  Cria o esqueleto do pacote em ./<prob>.
#   moj clone <id> [dir]                  Baixa o pacote inteiro.
#   moj info [<id>]                       Mostra tudo do problema.
#   moj edit [<id|dir>]                   Abre o editor interativo.
#   moj push [dir] [--force] [--overwrite]  Envia o pacote. Leva scripts/ e tests/score.
#                                         Recusa se o problema mudou no servidor depois do seu
#                                         último clone, pull ou push. --overwrite envia por cima.
#   moj pull [dir] [--force]              Traz para a pasta as mudanças do servidor (web, outro autor).
#                                         Recusa se a pasta tem mudanças suas não enviadas.
#                                         --force guarda a pasta em <pasta>.local-<data> e traz a versão.
#   moj test [dir] [--run [sol]]          Faz o pré-voo local. --run julga com o mojtools
#                                         (exige Linux com bwrap real). Confere os grupos de tests/score.
#   moj preview [dir] [--lang en|es]      Renderiza o enunciado em HTML. --lang renderiza a tradução.
#   moj title [dir] [--lang en|es] [<t>]  Mostra ou define o título (o da tradução com --lang).
#   moj download [<id>] [arq] [--sha <sha>]  Baixa o pacote. --sha baixa a versão do commit.
#   moj upload [<id>] [dir|arq] [--force] [--overwrite]  Sobe o pacote inteiro. Mesma trava do push.
#   moj languages [dir] [c,cpp,py,…|all]  Define as linguagens de submissão. Obrigatória em
#                                         problema de função ou de ban.
# Idiomas do enunciado: docs/enunciado.md é o português. docs/enunciado.<lang>.md (en, es) é a
#   tradução; docs/notes/<sample>.<lang>.md a explicação traduzida; docs/solucao.<lang>.md o
#   editorial traduzido; o título traduzido fica em .moj-id `titles`. Tudo viaja no clone/push.
# Correção especial (exigem o mojtools local)
#   moj checker <dir> <checker.cpp>       Instala um checker testlib.
#   moj interactive <dir> <arbitro> [--score]   Instala o driver de problema interativo.
#   moj fn <dir> [--langs c,cpp,py,java,rs]     Instala os drivers de submissão de função.
# Histórico
#   moj log [<id>] [-n N] | moj log [<id>] <sha>  Mostra o histórico git. Com <sha>, mostra o diff.
#   moj restore [<id>] <sha>              Restaura a versão como um commit novo.
# Portão de qualidade
#   moj validate [<id>] [--no-wait]       Confere o pacote (estático) e enfileira a calibração. Não publica.
#                                         Atenção: cada chamada recalibra. Para consultar, use status/check.
#   moj public [<id>] on|off [--yes]      Publica ou despublica. Problema ainda não PRONTO: mostra as
#                                         pendências e pede confirmação (--yes mostra e segue).
#   moj publish [<id>]                    Publica. O servidor valida e calibra.
#   moj calibrate [<id>] [--hosts h1,h2|--all-judges|--per-cpu] | --judges | --all-stale
#                                         Calibra nos juízes escolhidos. --judges lista o parque.
#                                         --all-stale recalibra o lote do painel.
#   moj calib [<id>]                      Mostra a calibração por extenso: cada solução com o que a
#                                         categoria pede e o que obteve; o validador de entrada
#                                         (--json = JSON cru).
#   moj calib-report [<id>] [--host <j> --sol <s>] [-o f.html]   Baixa o report.html de uma solução.
#   moj testrun [<id|dir>] <sol> [--report f.html]   Roda uma solução no juiz, fora do history.
#   moj testrun-status <run>              Consulta um testrun.
# Issues (a revisão da banca; issue aberta = o problema não está PRONTO)
#   moj issues [<id>] [--all]             Lista as issues (--all inclui as fechadas).
#   moj issues show [<id>] <n>            Mostra uma issue com os comentários.
#   moj issues new [<id>] "<título>" [-m <texto>]   Abre uma issue.
#   moj issues comment|close|reopen [<id>] <n> [-m <texto>]   Comenta, fecha ou reabre.
#                                         O texto vem de -m ou de -F <arquivo> (-F - = stdin).
# Orgs e coleções
#   moj mkdir <org>                       Cria uma org.
#   moj share <org> <login> | unshare <org> <login>   Adiciona ou remove um membro.
#   moj org list|create|members|public|rm Gerencia orgs. rm remove só org vazia.
#   moj collection ls|create|show|add|remove|rename|delete|status   Gerencia coleções.
#                                         Na pasta do problema: moj collection add "<coleção>".
#   moj mv <id> <org>                     Move um rascunho para outra org. O id muda.
#   moj rm <id>                           Remove o problema. Pede o id para confirmar.
# Manutenção
#   moj doctor | version | update         Diagnostica, compara o build, atualiza a CLI.
#   moj contest …                         Delega ao moj-contest. Veja `moj contest help`.
# Saída crua: --json antes do subcomando (ls, board, status, check, calib, testrun*).
# Config: MOJ_URL (default https://moj.naquadah.com.br), MOJ_HOST (header Host em teste local),
#         EDITOR (editor de texto; default nano ou vi).
# Documentação: README.md (PT) e README.en.md (EN).
set -euo pipefail

MOJ_TOOL=moj
# @INLINE-BEGIN lib/core.sh  (mkdist.sh troca este bloco pelo conteúdo da lib -> 1 arquivo)
# resolução portável do caminho (readlink -f é GNU; macOS/BSD não tem — a lib traz _abspath,
# mas aqui ela ainda não foi sourceada): tenta -f, cai p/ dirname+pwd (bom o suficiente p/
# achar a lib ao lado do script; symlink multi-nível exige GNU ou o artefato dist).
_moj_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
_MOJ_LIB="$(cd "$(dirname "$_moj_self")" && pwd)/lib/core.sh"
[[ -f "$_MOJ_LIB" ]] || { printf 'moj: lib/core.sh não encontrada (rode do repo, ou use o artefato de dist/mkdist.sh)\n' >&2; exit 1; }
source "$_MOJ_LIB"
# @INLINE-END

# ---- pacote <-> JSON (fidelidade total) ---------------------------------------------------
# _pairs <dir> <sample|hidden> <outfile> — escreve NDJSON (1 objeto/linha) em <outfile>.
# Cada item sai via `jq --rawfile` (lê o teste de ARQUIVO) -> nada de conteúdo de teste no argv;
# o chamador junta com `--slurpfile` (jq lê o arquivo). Evita estourar ARG_MAX em testes grandes.
_pairs(){ local d="$1" w="$2" of="$3" nm op ex idx notes='[]'
  : > "$of"
  [[ "$w" == sample && -f "$d/docs/sample-notes.json" ]] && { notes="$(jq -c . "$d/docs/sample-notes.json" 2>/dev/null)"; [[ -n "$notes" ]] || notes='[]'; }
  local names=(); shopt -s nullglob
  if [[ "$w" == sample ]]; then mapfile -t names < <(cd "$d/tests/input" 2>/dev/null && ls -1v sample* 2>/dev/null)
  else local f; for f in "$d/tests/input"/*; do nm="$(basename "$f")"; [[ "$nm" == sample* ]] || names+=("$nm"); done; fi
  shopt -u nullglob
  for nm in "${names[@]}"; do
    op="$d/tests/output/$nm"; [[ -f "$op" ]] || op=/dev/null
    # nota do exemplo: formato de autoria docs/notes/<sample>.md (markdown puro, --rawfile —
    # nota grande nunca passa por argv); legado sample-notes.json por índice
    if [[ "$w" == sample && -f "$d/docs/notes/$nm.md" ]]; then
      jq -nc --arg nm "$nm" --rawfile i "$d/tests/input/$nm" --rawfile o "$op" --rawfile ex "$d/docs/notes/$nm.md" \
         '($ex|rtrimstr("\n")) as $e | {name:$nm,input:$i,output:$o} + (if $e=="" then {} else {explanation:$e} end)' >> "$of"
      continue
    fi
    ex=''; if [[ "$w" == sample && "$nm" =~ ^sample([0-9]+)$ ]]; then idx=$(( ${BASH_REMATCH[1]} - 1 )); ex="$(jq -r --argjson i "$idx" '.[$i] // ""' <<<"$notes" 2>/dev/null)"; fi
    jq -nc --arg nm "$nm" --rawfile i "$d/tests/input/$nm" --rawfile o "$op" --arg ex "$ex" \
       '{name:$nm,input:$i,output:$o} + (if $ex=="" then {} else {explanation:$ex} end)' >> "$of"
  done; }
# _cat <dir> <categoria> <outfile> — NDJSON (1 sol/linha) via --rawfile (sem código no argv).
_cat(){ local d="$1" c="$2" of="$3" f
  : > "$of"; shopt -s nullglob
  for f in "$d/sols/$c"/*; do [[ -f "$f" ]] || continue
    jq -nc --arg fn "$(basename "$f")" --rawfile code "$f" '{filename:$fn,code:$code}' >> "$of"
  done; shopt -u nullglob; }
# _scripts_nd <dir> <outfile> — NDJSON de scripts/ (round-trip da correção especial):
# arquivo = {path,content_b64,exec} (base64 suporta binário); symlink = {path,symlink}
# (os drivers interativos usam scripts/<lang> -> c). Conteúdo via arquivo, nunca argv.
_scripts_nd(){ local d="$1" of="$2" f rel x tb
  : > "$of"; [[ -d "$d/scripts" ]] || return 0
  tb="$(mktemp)"
  while IFS= read -r f; do
    rel="${f#"$d"/scripts/}"
    if [[ -L "$f" ]]; then jq -nc --arg p "$rel" --arg t "$(readlink "$f")" '{path:$p,symlink:$t}' >> "$of"
    elif [[ -f "$f" ]]; then _b64enc "$f" > "$tb"; x=false; [[ -x "$f" ]] && x=true
      jq -nc --arg p "$rel" --argjson x "$x" --rawfile c "$tb" '{path:$p,content_b64:$c,exec:$x}' >> "$of"
    fi
  done < <(find "$d/scripts" \( -type f -o -type l \) 2>/dev/null | LC_ALL=C sort)
  rm -f "$tb"; }
enun_path(){ local e; for e in md org tex; do [[ -f "$1/docs/enunciado.$e" ]] && { printf '%s' "$1/docs/enunciado.$e"; return; }; done; printf '%s' "$1/docs/enunciado.md"; }
pkg_to_json(){ local d="$1" enunf="" efmt=md
  local ef; for ef in docs/enunciado.md enunciado.md docs/enunciado.org docs/enunciado.tex; do [[ -f "$d/$ef" ]] && { enunf="$d/$ef"; case "$ef" in *.org) efmt=org;; *.tex) efmt=tex;; *) efmt=md;; esac; break; }; done
  # exemplos/testes/soluções vão p/ NDJSON em arquivos e entram via --slurpfile (jq lê o arquivo);
  # enun/editorial podem ser GRANDES (imagens coladas viram data:URI) -> --rawfile (arquivo). Nada
  # de conteúdo grande por argumento de jq (era o ARG_MAX). conf é pequeno -> segue por --argjson.
  local t; t="$(mktemp -d)"
  _pairs "$d" sample "$t/exs"; _pairs "$d" hidden "$t/tss"
  _cat "$d" good "$t/good"; _cat "$d" slow "$t/slow"; _cat "$d" wrong "$t/wrong"; _cat "$d" pass "$t/pass"; _cat "$d" upcoming "$t/up"
  _scripts_nd "$d" "$t/scr"
  local enf="${enunf:-/dev/null}"; [[ -f "$enf" ]] || enf=/dev/null
  local edf="$d/docs/solucao.md"; [[ -f "$edf" ]] || edf=/dev/null
  local scoref="$d/tests/score"; [[ -f "$scoref" ]] || scoref=/dev/null   # ""=remove no servidor (fidelidade)
  # round-trip de scripts/score só quando o clone é CIENTE (scripts_rt no .moj-id) ou o
  # diretório/arquivo existe localmente — clone antigo não apaga scripts/score de ninguém.
  local rtflag=n
  { [[ -d "$d/scripts" || -f "$d/tests/score" ]] || [[ "$(jq -r '.scripts_rt//false' "$d/.moj-id" 2>/dev/null)" == true ]]; } && rtflag=y
  # imagens de docs/ (docs_files): mesmo racional do scripts_rt — só manda o campo se o clone
  # é CIENTE (docs_rt) ou há imagem local; clone antigo não apaga a figura de ninguém.
  _docs_nd "$d" "$t/dfl"
  local dfflag=n
  { [[ -s "$t/dfl" ]] || [[ "$(jq -r '.docs_rt//false' "$d/.moj-id" 2>/dev/null)" == true ]]; } && dfflag=y
  # TRADUÇÕES (docs/enunciado.<lang>.md, docs/solucao.<lang>.md, docs/notes/<sample>.<lang>.md +
  # titles do .moj-id) -> translations{<lang>:{title,enunciado_md,editorial_md?,notes?}}, NDJSON
  # em arquivo, conteúdo por --rawfile. Clone CIENTE (trans_rt no .moj-id) manda o campo com TODOS
  # os idiomas — `null` p/ o que não existe localmente (= apaga no servidor o que foi removido aqui,
  # como o scripts_files); clone antigo (sem a flag e sem tradução local) não apaga a tradução de ninguém.
  _trans_nd "$d" "$t/trans"
  # trflag: y = manda o campo (há tradução local OU o clone é ciente); rtflag2: y = clone CIENTE
  # (completa com `null` os idiomas sem arquivo = apaga no servidor). Clone antigo COM tradução
  # local manda só o que tem — nunca apaga a tradução de ninguém.
  local trflag=n trrt=n
  [[ "$(jq -r '.trans_rt//false' "$d/.moj-id" 2>/dev/null)" == true ]] && trrt=y
  { [[ -s "$t/trans" ]] || [[ "$trrt" == y ]]; } && trflag=y
  jq -n --rawfile enun "$enf" --argjson conf "$(slurp "$d/conf")" --arg efmt "$efmt" \
        --arg author "$(head -1 "$d/author" 2>/dev/null || true)" \
        --argjson tags "$([[ -f "$d/tags" ]] && jq -R . "$d/tags" | jq -sc . || echo '[]')" \
        --arg title "$([[ -f "$d/.moj-id" ]] && jq -r '.title//""' "$d/.moj-id" || echo '')" \
        --argjson titles "$([[ -f "$d/.moj-id" ]] && jq -c '.titles//{}' "$d/.moj-id" || echo '{}')" \
        --slurpfile trs "$t/trans" --arg trflag "$trflag" --arg trrt "$trrt" \
        --argjson colls "$([[ -f "$d/.moj-id" ]] && jq -c '.collections//[]' "$d/.moj-id" || echo '[]')" \
        --argjson langs "$([[ -f "$d/.moj-id" ]] && jq -c '.languages//[]' "$d/.moj-id" || echo '[]')" \
        --slurpfile exs "$t/exs" --slurpfile tss "$t/tss" --slurpfile scr "$t/scr" \
        --slurpfile dfl "$t/dfl" \
        --slurpfile good "$t/good" --slurpfile slow "$t/slow" --slurpfile wrong "$t/wrong" \
        --slurpfile pass "$t/pass" --slurpfile up "$t/up" --rawfile scoretxt "$scoref" \
        --arg edflag "$([[ -f "$d/docs/solucao.md" ]] && echo y)" --rawfile editorial "$edf" \
        --arg rtflag "$rtflag" --arg dfflag "$dfflag" '
    {title:$title, author:$author, tags:$tags, collections:$colls, languages:$langs, enunciado_md:$enun, enunciado_format:$efmt,
     conf_text:$conf, examples:$exs, tests:$tss, sols:{good:$good,slow:$slow,wrong:$wrong,pass:$pass,upcoming:$up}}
    + (if $rtflag=="y" then {scripts_files:$scr, score_text:$scoretxt} else {} end)
    + (if $dfflag=="y" then {docs_files:$dfl} else {} end)
    + (if $edflag=="y" then {editorial_md:$editorial} else {} end)
    + (if $trflag=="y" then {translations:((if $trrt=="y" then {en:null, es:null} else {} end) + ($trs|from_entries)), titles:$titles} else {} end)'
  rm -rf "$t"; }
# _trans_nd <dir> <outfile> — NDJSON {key:<lang>, value:{title,enunciado_md,editorial_md?,notes?}}
# por idioma (en, es) que tem enunciado, editorial OU nota traduzida. Conteúdo via --rawfile.
STMT_LANGS_ALL="pt en es"
_trans_nd(){ local d="$1" of="$2" l ef sf nf nm args filt ttl
  : > "$of"; local tn; tn="$(mktemp)"
  for l in $STMT_LANGS_ALL; do
    [[ "$l" == pt ]] && continue
    args=(); filt='{title:$ttl}'
    ttl="$([[ -f "$d/.moj-id" ]] && jq -r --arg l "$l" '.titles[$l] // ""' "$d/.moj-id" 2>/dev/null || echo '')"
    ef="$d/docs/enunciado.$l.md"; [[ -f "$ef" ]] && { args+=(--rawfile e "$ef"); filt+=' + {enunciado_md:$e}'; }
    sf="$d/docs/solucao.$l.md"; [[ -f "$sf" ]] && { args+=(--rawfile s "$sf"); filt+=' + {editorial_md:($s|rtrimstr("\n"))}'; }
    : > "$tn"; shopt -s nullglob
    for nf in "$d/docs/notes"/*."$l".md; do nm="${nf##*/}"; nm="${nm%."$l".md}"
      jq -nc --arg n "$nm" --rawfile v "$nf" '{key:$n, value:($v|rtrimstr("\n"))}' >> "$tn"; done
    shopt -u nullglob
    [[ -s "$tn" ]] && { args+=(--slurpfile nn "$tn"); filt+=' + {notes:($nn|from_entries)}'; }
    (( ${#args[@]} )) || continue
    jq -nc --arg l "$l" --arg ttl "$ttl" "${args[@]}" "{key:\$l, value:($filt)}" >> "$of"
  done; rm -f "$tn"; }
# _docs_nd <pkg> <outfile> — NDJSON {name, content_b64} das IMAGENS de docs/ (cap 2MB; maiores
# são PULADAS com aviso — imagem de enunciado não precisa disso tudo)
_docs_nd(){ local d="$1" of="$2" f b sz; : > "$of"; b="$(mktemp)"
  shopt -s nullglob
  for f in "$d/docs"/*.png "$d/docs"/*.jpg "$d/docs"/*.jpeg "$d/docs"/*.gif "$d/docs"/*.svg "$d/docs"/*.webp \
           "$d/docs"/*.PNG "$d/docs"/*.JPG "$d/docs"/*.JPEG "$d/docs"/*.GIF "$d/docs"/*.SVG "$d/docs"/*.WEBP; do
    [[ -f "$f" ]] || continue
    sz="$(wc -c < "$f")"
    if (( sz > 2097152 )); then echo "  ⚠ imagem grande demais (>2MB), NÃO enviada: ${f##*/} — reduza-a" >&2; continue; fi
    _b64file "$f" > "$b"
    jq -nc --arg n "${f##*/}" --rawfile b64 "$b" '{name:$n, content_b64:$b64}' >> "$of"
  done
  shopt -u nullglob; rm -f "$b"; }
# base64 de arquivo numa linha, portável (GNU -w0; BSD/macOS sem -w)
_b64file(){ base64 < "$1" | tr -d '\n'; }
# json_to_pkg <json-FILE> <dir> <id> — materializa o pacote a partir do /problems/source.
#
# O JSON vem em ARQUIVO, NUNCA em variável. Duas razões, as duas graves num pacote grande (o source
# de um problema de 84 MB tem ~100 MB):
#   (a) o `--argjson s "$j"` do .moj-id passava o JSON INTEIRO como argumento do execve => estourava o
#       teto de 128 KiB POR ARGUMENTO ("Argument list too long") => `moj clone` de problema grande
#       simplesmente NÃO FUNCIONAVA (e deixava o pacote pela metade);
#   (b) cada `<<<"$j"` regrava o JSON inteiro num temp e o jq re-parseia tudo.
# Padrão (o mesmo do servidor em apply_problem_fields): uma passada de jq por coleção, stream NUL
# (--raw-output0) gravado em ARQUIVO, e o laço lê DO ARQUIVO — fd seekable, o bash lê em BLOCO (sobre
# PIPE o `read` do bash faz 1 syscall POR BYTE).
#
# E grava VERBATIM: o servidor já normaliza o \n final. O `jq -r` de antes ACRESCENTAVA um \n a cada
# arquivo, então o clone nunca era byte-exato (e o tl-checksum do clone nunca batia com o do servidor).
json_to_pkg(){ local jf="$1" d="$2" id="$3" _t
  [[ -f "$jf" ]] || { _t="$(mktemp)"; printf '%s' "$jf" > "$_t"; jf="$_t"; }   # compat: veio como string
  local T; T="$(mktemp -d)"
  mkdir -p "$d/docs" "$d/tests/input" "$d/tests/output"
  local efmt; efmt="$(jq -r '.format // .enunciado_format // "md"' < "$jf")"; [[ "$efmt" =~ ^(md|org|tex)$ ]] || efmt=md

  # escalares: 1 passada
  jq --raw-output0 '
      (.enunciado_md // ""),
      (.author // ""),
      ((.tags // []) | if length==0 then "" else (join("\n") + "\n") end),
      (.conf_text // "TLMOD[calibrafactor]=1.35\nULIMITS[-u]=10000\nALLOWPARALLELTEST=y\n"),
      (.editorial_md // ""),
      (.score_text // ""),
      ([(.examples//[])[] | (.explanation // "")] | tojson)
    ' < "$jf" > "$T/s.nul" 2>/dev/null
  local S_EN='' S_AU='' S_TG='' S_CF='' S_ED='' S_SC='' S_NT=''
  { IFS= read -r -d '' S_EN; IFS= read -r -d '' S_AU; IFS= read -r -d '' S_TG; IFS= read -r -d '' S_CF
    IFS= read -r -d '' S_ED; IFS= read -r -d '' S_SC; IFS= read -r -d '' S_NT; } < "$T/s.nul" 2>/dev/null
  printf '%s' "$S_EN" > "$d/docs/enunciado.$efmt"
  printf '%s' "$S_AU" > "$d/author"
  printf '%s' "$S_TG" > "$d/tags"
  printf '%s' "$S_CF" > "$d/conf"
  if [[ -n "$S_ED" ]]; then printf '%s' "$S_ED" > "$d/docs/solucao.md"; else rm -f "$d/docs/solucao.md"; fi
  if [[ -n "$S_SC" ]]; then printf '%s' "$S_SC" > "$d/tests/score"; else rm -f "$d/tests/score"; fi
  # notas -> docs/notes/sample<N>.md (formato de autoria: 1 markdown por exemplo; o json
  # legado NUNCA mais é materializado num clone novo)
  rm -rf "$d/docs/notes"; rm -f "$d/docs/sample-notes.json"
  if [[ "$(jq -r 'map(select(.!=""))|length' <<<"${S_NT:-[]}" 2>/dev/null)" -gt 0 ]]; then
    mkdir -p "$d/docs/notes"
    local nk=0 nc ntf; ntf="$(mktemp)"
    nc="$(jq 'length' <<<"$S_NT" 2>/dev/null)"; [[ "$nc" =~ ^[0-9]+$ ]] || nc=0
    while (( nk < nc )); do
      jq -r --argjson k "$nk" '.[$k] // ""' <<<"$S_NT" > "$ntf" 2>/dev/null
      [[ -n "$(tr -d '[:space:]' < "$ntf" 2>/dev/null)" ]] && cp "$ntf" "$d/docs/notes/sample$((nk+1)).md"
      nk=$((nk+1))
    done
    rm -f "$ntf"
  fi
  # traduções (translations{<lang>}) -> docs/enunciado.<lang>.md, docs/solucao.<lang>.md,
  # docs/notes/<sample>.<lang>.md (só idiomas da allowlist; conteúdo VERBATIM, como o PT)
  jq --raw-output0 '(.translations // {}) | to_entries[] | select(.value != null and (.key|test("^(en|es)$")))
      | .key, (.value.enunciado_md // ""), (.value.editorial_md // ""),
        ((.value.notes // {}) | to_entries | map(select(.key|test("^[A-Za-z0-9_-]+$"))) | map("\(.key)\u0001\(.value)") | join("\u0002"))
    ' < "$jf" > "$T/tr.nul" 2>/dev/null
  local TL='' TE='' TD='' TN='' _tk _tv _pair
  while IFS= read -r -d '' TL && IFS= read -r -d '' TE && IFS= read -r -d '' TD && IFS= read -r -d '' TN; do
    if [[ -n "$TE" ]]; then printf '%s' "$TE" > "$d/docs/enunciado.$TL.md"; else rm -f "$d/docs/enunciado.$TL.md"; fi
    if [[ -n "$TD" ]]; then printf '%s' "$TD" > "$d/docs/solucao.$TL.md"; else rm -f "$d/docs/solucao.$TL.md"; fi
    rm -f "$d/docs/notes"/*."$TL".md 2>/dev/null
    [[ -n "$TN" ]] && while IFS= read -r -d $'\x02' _pair || [[ -n "$_pair" ]]; do
      _tk="${_pair%%$'\x01'*}"; _tv="${_pair#*$'\x01'}"
      [[ -n "$_tk" && -n "$(tr -d '[:space:]' <<<"$_tv")" ]] || continue
      mkdir -p "$d/docs/notes"; printf '%s' "$_tv" > "$d/docs/notes/$_tk.$TL.md"
    done <<<"$TN"
  done < "$T/tr.nul"
  # imagens de docs/ (docs_files) do servidor -> arquivos locais
  jq --raw-output0 '(.docs_files//[])[] | (.name // ""), (.content_b64 // "")' < "$jf" > "$T/df.nul" 2>/dev/null
  local dfn='' dfb=''
  while IFS= read -r -d '' dfn && IFS= read -r -d '' dfb; do
    dfn="${dfn##*/}"
    [[ "$dfn" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.(png|jpg|jpeg|gif|svg|webp|PNG|JPG|JPEG|GIF|SVG|WEBP)$ ]] || continue
    printf '%s' "$dfb" | _b64dec > "$d/docs/$dfn" 2>/dev/null || rm -f "$d/docs/$dfn"
  done < "$T/df.nul"

  # exemplos e testes: 1 passada cada
  jq --raw-output0 '(.examples//[])[] | (.input // ""), (.output // "")' < "$jf" > "$T/ex.nul" 2>/dev/null
  local i=0 a b
  while IFS= read -r -d '' a && IFS= read -r -d '' b; do i=$((i+1))
    printf '%s' "$a" > "$d/tests/input/sample$i"; printf '%s' "$b" > "$d/tests/output/sample$i"
  done < "$T/ex.nul"
  jq --raw-output0 '(.tests//[])[] | (.name // ""), (.input // ""), (.output // "")' < "$jf" > "$T/t.nul" 2>/dev/null
  local nm
  while IFS= read -r -d '' nm && IFS= read -r -d '' a && IFS= read -r -d '' b; do
    nm="${nm##*/}"; [[ -n "$nm" ]] || continue
    printf '%s' "$a" > "$d/tests/input/$nm"; printf '%s' "$b" > "$d/tests/output/$nm"
  done < "$T/t.nul"

  # soluções: 1 passada p/ todas as categorias
  local cat; for cat in good slow wrong pass upcoming; do mkdir -p "$d/sols/$cat"; done
  jq --raw-output0 '(.sols // {}) | to_entries[] | .key as $c | ((.value // [])[] | $c, (.filename // ""), (.code // ""))' \
    < "$jf" > "$T/so.nul" 2>/dev/null
  local sc fn
  while IFS= read -r -d '' sc && IFS= read -r -d '' fn && IFS= read -r -d '' a; do
    [[ "$sc" =~ ^(good|slow|wrong|pass|upcoming)$ ]] || continue
    fn="${fn##*/}"; [[ "$fn" =~ ^[A-Za-z0-9._-]+$ ]] || continue
    printf '%s' "$a" > "$d/sols/$sc/$fn"
  done < "$T/so.nul"

  # scripts/ (correção especial) — round-trip: arquivos (base64, +x) e symlinks
  rm -rf "$d/scripts"
  jq --raw-output0 '(.scripts_files//[])[] | (.path // ""), (.symlink // ""), (if .exec then "1" else "0" end), (.content_b64 // "")' \
    < "$jf" > "$T/sc.nul" 2>/dev/null
  local sp st sx sb sdir
  while IFS= read -r -d '' sp && IFS= read -r -d '' st && IFS= read -r -d '' sx && IFS= read -r -d '' sb; do
    [[ -n "$sp" ]] || continue
    case "$sp" in /*|*..*) continue;; esac
    sdir="${sp%/*}"; [[ "$sdir" == "$sp" ]] && sdir=""
    mkdir -p "$d/scripts${sdir:+/$sdir}"
    if [[ -n "$st" ]]; then ln -sfn "$st" "$d/scripts/$sp"
    else printf '%s' "$sb" | _b64dec > "$d/scripts/$sp" 2>/dev/null || : > "$d/scripts/$sp"
      [[ "$sx" == 1 ]] && chmod +x "$d/scripts/$sp"
    fi
  done < "$T/sc.nul"

  # .moj-id (metadados do clone; NÃO sobe ao servidor). scripts_rt marca o clone como "ciente do
  # round-trip": só ele pode APAGAR scripts/score no servidor via push. --slurpfile (não --argjson):
  # o JSON grande NÃO cabe no argv.
  jq -n --arg id "$id" --arg r "${id%%#*}" --arg p "${id##*#}" --arg fmt "$efmt" --slurpfile s "$jf" \
    '($s[0] // {}) as $src
     | {id:$id, repo:$r, prob:$p, title:($src.title//""), titles:($src.titles//{}), format:$fmt, collections:($src.collections//[]),
        languages:($src.languages//[]), public:($src.public//false), scripts_rt:true, docs_rt:true, trans_rt:true,
        base_rev:($src.rev//"")}' > "$d/.moj-id"
  rm -rf "$T" "${_t:-}"; }

# conf get/set por chave (bash; chave entre aspas -> [ ] literais)
# SEMPRE retorna 0: sem o `return 0` final, o rc do último [[ ]] do laço vazava (chave ausente
# = rc 1) e QUALQUER atribuição `x="$(conf_get …)"` sob set -e matava o moj MUDO (foi o
# 'moj test --run' que parava sem nada depois do pré-voo em máquina com bwrap real).
conf_get(){ local d="$1" k="$2" line; [[ -f "$d/conf" ]] || return 0; while IFS= read -r line; do [[ "$line" == "$k="* ]] && { line="${line#"$k"=}"; line="${line%\"}"; printf '%s' "${line#\"}"; return 0; }; done < "$d/conf"; return 0; }
conf_set(){ local d="$1" k="$2" v="$3" line found=0 tmp; tmp="$(mktemp)"
  [[ -f "$d/conf" ]] && while IFS= read -r line; do if [[ "$line" == "$k="* ]]; then [[ -n "$v" ]] && printf '%s=%s\n' "$k" "$v" >> "$tmp"; found=1; else printf '%s\n' "$line" >> "$tmp"; fi; done < "$d/conf"
  [[ $found -eq 0 && -n "$v" ]] && printf '%s=%s\n' "$k" "$v" >> "$tmp"; mv -f "$tmp" "$d/conf"; }

