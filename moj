cmd_mkdir(){ need_login; [[ $# -ge 1 ]] || die "uso: moj mkdir <org>   (= moj org create; a org é o <org> do id)"; api POST "/problems/repo-create" "$(jq -n --arg r "$1" '{repo:$r}')" | jq -r '"org criada: \(.repo) (você é admin)"'; }
# <id> OPCIONAL nos comandos de problema: dentro da pasta dele (ou de uma subpasta) vale o do .moj-id,
# e o nome sem a org usa a org do .moj-id (issue #2). Ver id_arg/resolve_id.
# TEXTOS de "o problema está pronto?". A REGRA é do servidor (lib/calib-expect.sh + /problems/status:
# `expect` de cada solução, `summary`/`validator` da calibração, `pending`); aqui só se traduz o que ele
# devolve — as mesmas frases do web/problemas/readiness.js. Nunca refaça o juízo aqui.
_RDY_JQ='
def rdy_arg: if test(":") then sub("^[^:]*:"; "") else "" end;
def plabel: sub(":.*$"; "") as $k | rdy_arg as $a
  | if $k == "package_failed" then "pacote com erro (moj check)"
    elif $k == "package_unchecked" then "pacote não conferido (moj validate)"
    elif $k == "uncalibrated" then "sem calibração (moj calibrate)"
    elif $k == "needs_recalibration" then "precisa recalibrar (moj calibrate)"
    elif $k == "good_no_tl" then "solução good sem tempo-limite: \($a)"
    elif $k == "sols_divergent" then "\($a) solução(ões) divergente(s) (moj calib)"
    elif $k == "sols_unchecked" then "soluções não conferidas desde a última edição (moj calibrate)"
    elif $k == "inputs_invalid" then "\($a) entrada(s) inválida(s) pelo validador (moj calib)"
    elif $k == "inputs_error" then "o validador de entrada não rodou (moj calib)"
    elif $k == "issues_open" then "\($a) issue(s) aberta(s) (moj issues)"
    else . end;
def ctext: (.counts // {}) as $c | ["AC","WA","TLE","MLE","RE","UE"] | map(select($c[.] != null) | "\(.) \($c[.])") | join(" · ");
def xpill: (.state // "") as $s
  | if $s == "ok" then "✓ conforme" elif $s == "note" then "≈ conforme, outro motivo"
    elif $s == "bad" then "✗ DIVERGENTE" elif $s == "norun" then "✗ NÃO RODOU" else "•" end;
def xwant: if . == "good" then "esperado: aceita em todos os testes, dentro do TL que o juiz cobra"
  elif . == "pass" then "esperado: aceita em todos os testes, dentro do TL"
  elif . == "slow" then "esperado: TLE em pelo menos 1 teste, sem errar os outros"
  elif . == "wrong" then "esperado: ser reprovada, de preferência por WA" else "" end;
def xgot: (.why // "") as $w | (.counts // {} | del(.AC) | {counts: .} | ctext) as $n
  | if $w == "all_ac" then "aceita em todos os testes"
    elif $w == "over_tl" then "aceita, mas levou \(.tmax)s — acima do TL de \(.tl)s que o juiz cobra (TLOVERRIDE baixo?)"
    elif $w == "failed" then "não foi aceita: \($n)"
    elif $w == "tle_allowed" then "TLE permitido pelo conf (ALLOWTLEDURINGCALIBRATION=y)"
    elif $w == "tle" then "estourou o tempo"
    elif $w == "tle_and_wrong" then "estourou o tempo, mas também errou (\($n)) — a lenta deveria ser correta"
    elif $w == "wrong_no_tle" then "errou sem estourar o tempo (\($n))"
    elif $w == "no_tle" then "passou em todos no tempo — o TL não pega esta solução"
    elif $w == "wa" then "WA — os testes pegam o erro"
    elif $w == "failed_other" then "reprovada por \($n), não por WA — confira se era esse o erro"
    elif $w == "accepted" then "foi ACEITA — os testes não pegam o erro"
    elif $w == "ce" then "não compilou — não prova nada sobre os testes"
    elif $w == "lang" then "linguagem indisponível neste juiz"
    elif $w == "ue" then "erro do corretor/juiz (UE)"
    elif $w == "noverdict" then "sem veredicto" else "" end;
def vtext: (.state // "") as $s
  | if $s == "none" then "sem validador (scripts/validator.cpp)"
    elif $s == "ok" then "validador aprovou as \(.total) entradas"
    elif $s == "invalid" then "\(.invalid) de \(.total) entradas INVÁLIDAS"
    elif $s == "error" then "o validador não rodou (não compilou?)" else "não conferidas" end;
def stext: (.state // "") as $s
  | if $s == "ok" then "todas conforme"
    elif $s == "note" then "todas conforme (\(.note) por outro motivo)"
    elif $s == "bad" then "\(.bad) DIVERGENTE(S)"
    elif $s == "partial" then "parcial — há solução sem resultado (moj calibrate)"
    elif $s == "stale" then "não conferidas desde a última edição (moj calibrate)"
    else "sem resultado ainda" end;
'
cmd_publish(){ need_login; id_arg '' "$@"; shift "$IDSHIFT"; cmd_public "$ID" on "$@"; }
cmd_public(){ need_login; id_arg '^(on|off)$' "$@"; shift "$IDSHIFT"
  [[ $# -ge 1 && "$1" =~ ^(on|off)$ ]] || die "uso: moj public [<id>] on|off [--yes]"
  local id="$ID" onoff="$1" yes=0 a; shift; for a in "$@"; do [[ "$a" == --yes || "$a" == -y ]] && yes=1; done
  local v=false; [[ "$onoff" == on ]] && v=true
  # NÃO PRONTO sinaliza e confirma (decisão do Ribas, 24/09/2026): as pendências do servidor vão para
  # a tela antes da pergunta. Com --yes elas saem como aviso e a publicação segue (scripts).
  if [[ "$v" == true ]]; then
    local st pend
    st="$(api GET "/problems/status?id=$(enc "$id")" 2>/dev/null)" || st='{}'
    pend="$(jq -r "$_RDY_JQ"'(.problems // [])[0].pending // [] | .[] | "  • " + plabel' <<<"$st" 2>/dev/null)" || pend=""
    [[ -n "$pend" ]] && printf '⚠ o problema ainda NÃO está pronto:\n%s\n' "$pend" >&2
  fi
  # TORNAR PÚBLICO é ação cautelosa: confirma (provas devem ficar privadas). --yes p/ scripts.
  if [[ "$v" == true && "$yes" -eq 0 ]]; then
    echo "⚠ TORNAR PÚBLICO publica '$id' no TREINO LIVRE (visível a TODOS). Provas devem ficar privadas." >&2
    local c; read -rp "Confirmar publicação? [s/N] " c </dev/tty || true
    [[ "$c" =~ ^[sySY] ]] || die "cancelado — nada publicado."
  fi
  api POST "/problems/set-public" "$(jq -n --arg id "$id" --argjson p "$v" '{id:$id,public:$p}')" \
    | jq -r 'if .public then "\(.id): PÚBLICO — o servidor VALIDA + CALIBRA (reqid \(.reqid // "?")). Acompanhe com: moj check \(.id)" else "\(.id): despublicado (saiu do treino livre)" end'; }
# calibração: global (1 juiz livre pega), DIRECIONADA a juízes (--hosts/--all-judges/--per-cpu —
# paridade com a "Calibração direcionada" do editor web; o servidor dedupa por host), lote
# (--all-stale) e a lista de juízes p/ escolher (--judges). Gate do servidor: quem EDITA o problema.
cmd_calibrate(){ need_login
  if [[ "${1:-}" == --all-stale ]]; then
    # recalibra o LOTE inteiro do painel (tudo que "precisa recalibrar"); o servidor recomputa a
    # lista autorizada e enfileira com dedup+serialização (lote é seguro por construção)
    api POST "/problems/recalibrate-stale" '{}' | { [[ "$RAW" == 1 ]] && cat || jq -r '
      "enfileiradas: \(.count) recalibração(ões)",
      ((.queued // [])[] | "  \(.id)  (reqid \(.reqid))")'; }
    return
  fi
  if [[ "${1:-}" == --judges ]]; then     # os juízes do parque (p/ montar um --hosts)
    api GET "/problems/judges" | { [[ "$RAW" == 1 ]] && cat || {
      jq -r '.judges[]? | "  \(.host)\t\(.cpu // "?")\t\(if .online then "online" else "OFFLINE" end)"' \
        | { column -t -s$'\t' 2>/dev/null || cat; }; }; }
    return
  fi
  id_arg '' "$@"; shift "$IDSHIFT"
  local id="$ID" mode="" want="" a
  while [[ $# -gt 0 ]]; do a="$1"; shift
    case "$a" in
      --hosts) want="${1:?faltou a lista de --hosts}"; mode=hosts; shift;;
      --all-judges|--all) mode=all;;
      --per-cpu|--percpu) mode=percpu;;
      *) die "opção desconhecida: $a";;
    esac
  done
  local hosts='[]'
  if [[ -n "$mode" ]]; then
    local jl h known
    jl="$(api GET "/problems/judges")"
    case "$mode" in
      all)    hosts="$(jq -c '[.judges[]? | select(.online) | .host]' <<<"$jl")";;
      percpu) hosts="$(jq -c '[.judges[]? | select(.online)] | group_by(.cpu // "?") | map(.[0].host)' <<<"$jl")";;
      hosts)
        hosts="$(jq -cn --arg h "$want" '$h | split(",") | map(select(length>0)) | unique')"
        # valida ANTES do POST: host desconhecido = erro com a lista (o servidor o pularia em
        # SILÊNCIO); host conhecido mas offline = aviso e envia (o comando espera o juiz voltar)
        known="$(jq -r '.judges[]?.host' <<<"$jl")"
        while IFS= read -r h; do
          grep -qx -- "$h" <<<"$known" \
            || die "juiz desconhecido: '$h' — existem: $(jq -r '[.judges[]?.host] | join(", ")' <<<"$jl")"
          jq -e --arg h "$h" '.judges[]? | select(.host==$h) | .online' <<<"$jl" >/dev/null 2>&1 \
            || echo "  ⚠ $h está OFFLINE — a calibração fica na fila dele e roda quando voltar" >&2
        done < <(jq -r '.[]' <<<"$hosts")
        ;;
    esac
    [[ "$(jq 'length' <<<"$hosts")" -gt 0 ]] || die "nenhum juiz online — veja 'moj calibrate --judges'"
  fi
  api POST "/problems/request-calibration" \
    "$(jq -cn --arg id "$id" --argjson h "$hosts" '{id:$id} + (if ($h|length) > 0 then {hosts:$h} else {} end)')" \
    | out '"calibração de \(.id): " + (if .hosts then
             (.hosts | map("\(.host)\(if .status == "already_queued" then " (JÁ na fila)" else "" end)") | join(", "))
           elif .status == "already_queued" then "JÁ na fila (reqid \(.reqid // "?")) — nada novo enfileirado"
           else "enfileirada (reqid \(.reqid // "?")) — 1 juiz livre pega" end)'; }
# moj validate <id> — PORTÃO DE QUALIDADE sem publicar: roda o validador estático (enunciado, testes,
# soluções, seções obrigatórias) + gera o índice, e pede calibração ao juiz. O problema segue PRIVADO
# — publicar é `moj public <id> on`, e aí a ORG precisa permitir. Espera o relatório novo (o campo
# `at` muda) e o imprime com o mesmo formato do `moj check`.
cmd_validate(){ need_login; id_arg '' "$@"; shift "$IDSHIFT"
  local id="$ID" wait=1 a before at i
  for a in "$@"; do [[ "$a" == --no-wait || "$a" == -n ]] && wait=0; done
  # pre-check INFORMATIVO nunca pode derrubar o comando (set -e): problema recém-subido pode
  # ainda não estar visível (índice/overlay atrasado) — o GET falha e o validate seguia morrendo
  # ANTES do POST (derrubou upload em lote; ver lição jq-argmax do overlay authored)
  before="$(api GET "/problems/validation?id=$(enc "$id")" 2>/dev/null | jq -r '.at // 0')" || before=0
  api POST "/problems/validate" "$(jq -n --arg id "$id" '{id:$id}')" \
    | jq -r '"validação enfileirada: \(.id)" + (if (.reqid // "") != "" then "  (calibração reqid \(.reqid))" else "" end)'
  [[ "$wait" == 1 ]] || return 0
  for i in $(seq 1 30); do
    sleep 2
    at="$(api GET "/problems/validation?id=$(enc "$id")" 2>/dev/null | jq -r '.at // 0')" || at=0
    [[ "${at:-0}" -gt "${before:-0}" ]] && { echo; cmd_check "$id"; return 0; }
  done
  echo "  (o relatório ainda não saiu — veja depois com 'moj check $id')"; }
cmd_share(){ need_login; [[ $# -ge 2 ]] || die "uso: moj share <org> <login>   (adiciona membro à org — quem edita)"; api POST "/problems/repo-collaborators" "$(jq -n --arg r "$1" --arg u "$2" '{repo:$r,add:[$u]}')" | jq -r '"membros da org \(.repo): \(.collaborators|join(", "))"'; }
cmd_unshare(){ need_login; [[ $# -ge 2 ]] || die "uso: moj unshare <org> <login>"; api POST "/problems/repo-collaborators" "$(jq -n --arg r "$1" --arg u "$2" '{repo:$r,remove:[$u]}')" | jq -r '"membros da org \(.repo): \(.collaborators|join(", "))"'; }
# gestão de ORGS (o <org> do id <org>#<prob>): membros escrevem em qualquer problema; admins gerem a
# trava de público (privada = problemas nunca ficam públicos). Cada usuário tem a org implícita <login>.
cmd_org(){ need_login; local sub="${1:-list}"; shift || true
  case "$sub" in
    list|ls) api GET "/orgs/list" | jq -r '.orgs[]? | "  \(.name)\t\(if .implicit then "(própria)" elif .public_allowed then "público-ok" else "privada" end)\t\(.count) probs (\(.public) púb)\t[\(.members|join(","))]\(if .can_manage then "  *admin" else "" end)"' | { column -t -s$'\t' 2>/dev/null || cat; } ;;
    create|new) [[ $# -ge 1 ]] || die "uso: moj org create <nome> [--public] [--members a,b] [--admins c]"
      local name="$1" pa=false members="" admins=""; shift
      while [[ $# -gt 0 ]]; do case "$1" in --public) pa=true;; --members) members="$2"; shift;; --admins) admins="$2"; shift;; esac; shift; done
      api POST "/orgs/create" "$(jq -n --arg n "$name" --argjson pa "$pa" --arg m "$members" --arg a "$admins" '{name:$n, public_allowed:$pa, members:($m|split(",")|map(select(length>0))), admins:($a|split(",")|map(select(length>0)))}')" \
        | jq -r '"org \(.name): membros=[\(.members|join(","))] admins=[\(.admins|join(","))] permite-público=\(.public_allowed)"' ;;
    members|membros) [[ $# -ge 1 ]] || die "uso: moj org members <nome> [--add a,b] [--remove c] [--admins-add d] [--admins-remove e]"
      local name="$1"; shift
      if [[ $# -eq 0 ]]; then api GET "/orgs/members?name=$(enc "$name")" | jq -r '"membros: \(.members|join(", "))\nadmins:  \(.admins|join(", "))"'; return; fi
      local add="" rem="" aadd="" arem=""
      while [[ $# -gt 0 ]]; do case "$1" in --add) add="$2"; shift;; --remove) rem="$2"; shift;; --admins-add) aadd="$2"; shift;; --admins-remove) arem="$2"; shift;; esac; shift; done
