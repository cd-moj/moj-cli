#!/usr/bin/env bash
# moj — CLI de autoria de problemas do MOJ. SEM git, SEM chave: só o seu LOGIN do MOJ.
# Dois jeitos de trabalhar:
#   • EDITOR INTERATIVO (como os campos da página):   moj edit <id|pasta>
#   • ARQUIVOS LOCAIS (edite com seu editor favorito): moj clone <id> ; … ; moj push
#
#   moj login | whoami | logout
# Conceitos: ORG = quem edita + prefixo do id <org>#<prob> (acesso, 1 por problema);
#            COLEÇÃO = rótulo de agrupamento (tag, VÁRIAS por problema, pode ter espaços).
#   moj ls [mine|shared|public]   moj repos   moj mkdir <org>   (mkdir = criar org)
#   moj board                     (painel: seus problemas + o que precisa revisar)
#   moj status [<id>] | check <id>  (sem id: saúde do sistema; com id: QA do problema —
#                                    validação, time-limits por juiz, solução good sem TL)
#   moj new <org> <prob>          moj clone <id> [dir]            moj info <id>
#   moj edit <id|dir>             moj push [dir] [--force]        (push/clone levam scripts/ e tests/score)
#   moj test [dir] [--run [sol]]  (--run JULGA local via mojtools; exige Linux+bwrap real)
#   moj checker <dir> <checker.cpp>          (checker testlib normalizado — mojtools local)
#   moj interactive <dir> <arbitro> [--score] (problema interativo — mojtools local)
#   moj preview [dir]             moj download <id> [arquivo]     moj upload <id> [dir|arquivo] [--force]
#   moj validate <id>             (portão de qualidade + calibração; NÃO publica — pode ser privado)
#   moj public <id> on|off [--yes]   moj publish <id>  (público => o servidor VALIDA + CALIBRA)
#   moj calibrate <id>            (--json antes do subcomando = saída crua em ls/board/status/check)
#   moj share <org> <login>       moj unshare <org> <login>   (membro da org = quem edita)
#   moj org list|create|members|public|rm   (orgs: quem edita + trava de público; rm só org vazia)
#   moj collection ls|create|show|add|remove|rename|delete  (coleções = tags de agrupamento, m:n)
#   moj mv <id> <org>             (move um RASCUNHO p/ outra org — muda o id p/ <org>#<prob>)
#   moj rm <id>                   (remove o problema; pede confirmação repetindo o id)
#   moj collection ls | create <nome> [--members a,b] [--admins c]
#                  | members <nome> [--add a,b] [--remove c] [--admins-add d] [--admins-remove e]
#   moj contest …                 (GESTÃO DE CONTEST — delega ao moj-contest; `moj contest help`)
# Config: MOJ_URL (default https://moj.naquadah.com.br), MOJ_HOST (header Host p/ teste local),
#         EDITOR (editor de texto; default nano/vi).
set -euo pipefail

MOJ_TOOL=moj
# @INLINE-BEGIN lib/core.sh  (mkdist.sh troca este bloco pelo conteúdo da lib -> 1 arquivo)
# resolução portável do caminho (readlink -f é GNU; macOS/BSD não tem — a lib traz _abspath,
# mas aqui ela ainda não foi sourceada): tenta -f, cai p/ dirname+pwd (bom o suficiente p/
# achar a lib ao lado do script; symlink multi-nível exige GNU ou o artefato dist).
_moj_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
_MOJ_LIB="$(cd "$(dirname "$_moj_self")" && pwd)/lib/core.sh"
[[ -f "$_MOJ_LIB" ]] || { printf 'moj: lib/core.sh não encontrada (rode do repo, ou use o artefato de dist/mkdist.sh)\n' >&2; exit 1; }
source "$_MOJ_LIB"
# @INLINE-END

# ---- pacote <-> JSON (fidelidade total) ---------------------------------------------------
# _pairs <dir> <sample|hidden> <outfile> — escreve NDJSON (1 objeto/linha) em <outfile>.
# Cada item sai via `jq --rawfile` (lê o teste de ARQUIVO) -> nada de conteúdo de teste no argv;
# o chamador junta com `--slurpfile` (jq lê o arquivo). Evita estourar ARG_MAX em testes grandes.
_pairs(){ local d="$1" w="$2" of="$3" nm op ex idx notes='[]'
  : > "$of"
  [[ "$w" == sample && -f "$d/docs/sample-notes.json" ]] && { notes="$(jq -c . "$d/docs/sample-notes.json" 2>/dev/null)"; [[ -n "$notes" ]] || notes='[]'; }
  local names=(); shopt -s nullglob
  if [[ "$w" == sample ]]; then mapfile -t names < <(cd "$d/tests/input" 2>/dev/null && ls -1v sample* 2>/dev/null)
  else local f; for f in "$d/tests/input"/*; do nm="$(basename "$f")"; [[ "$nm" == sample* ]] || names+=("$nm"); done; fi
  shopt -u nullglob
  for nm in "${names[@]}"; do
    op="$d/tests/output/$nm"; [[ -f "$op" ]] || op=/dev/null
    ex=''; if [[ "$w" == sample && "$nm" =~ ^sample([0-9]+)$ ]]; then idx=$(( ${BASH_REMATCH[1]} - 1 )); ex="$(jq -r --argjson i "$idx" '.[$i] // ""' <<<"$notes" 2>/dev/null)"; fi
    jq -nc --arg nm "$nm" --rawfile i "$d/tests/input/$nm" --rawfile o "$op" --arg ex "$ex" \
       '{name:$nm,input:$i,output:$o} + (if $ex=="" then {} else {explanation:$ex} end)' >> "$of"
  done; }
# _cat <dir> <categoria> <outfile> — NDJSON (1 sol/linha) via --rawfile (sem código no argv).
_cat(){ local d="$1" c="$2" of="$3" f
  : > "$of"; shopt -s nullglob
  for f in "$d/sols/$c"/*; do [[ -f "$f" ]] || continue
    jq -nc --arg fn "$(basename "$f")" --rawfile code "$f" '{filename:$fn,code:$code}' >> "$of"
  done; shopt -u nullglob; }
# _scripts_nd <dir> <outfile> — NDJSON de scripts/ (round-trip da correção especial):
# arquivo = {path,content_b64,exec} (base64 suporta binário); symlink = {path,symlink}
# (os drivers interativos usam scripts/<lang> -> c). Conteúdo via arquivo, nunca argv.
_scripts_nd(){ local d="$1" of="$2" f rel x tb
  : > "$of"; [[ -d "$d/scripts" ]] || return 0
  tb="$(mktemp)"
  while IFS= read -r f; do
    rel="${f#"$d"/scripts/}"
    if [[ -L "$f" ]]; then jq -nc --arg p "$rel" --arg t "$(readlink "$f")" '{path:$p,symlink:$t}' >> "$of"
    elif [[ -f "$f" ]]; then _b64enc "$f" > "$tb"; x=false; [[ -x "$f" ]] && x=true
      jq -nc --arg p "$rel" --argjson x "$x" --rawfile c "$tb" '{path:$p,content_b64:$c,exec:$x}' >> "$of"
    fi
  done < <(find "$d/scripts" \( -type f -o -type l \) 2>/dev/null | LC_ALL=C sort)
  rm -f "$tb"; }
enun_path(){ local e; for e in md org tex; do [[ -f "$1/docs/enunciado.$e" ]] && { printf '%s' "$1/docs/enunciado.$e"; return; }; done; printf '%s' "$1/docs/enunciado.md"; }
pkg_to_json(){ local d="$1" enunf="" efmt=md
  local ef; for ef in docs/enunciado.md enunciado.md docs/enunciado.org docs/enunciado.tex; do [[ -f "$d/$ef" ]] && { enunf="$d/$ef"; case "$ef" in *.org) efmt=org;; *.tex) efmt=tex;; *) efmt=md;; esac; break; }; done
  # exemplos/testes/soluções vão p/ NDJSON em arquivos e entram via --slurpfile (jq lê o arquivo);
  # enun/editorial podem ser GRANDES (imagens coladas viram data:URI) -> --rawfile (arquivo). Nada
  # de conteúdo grande por argumento de jq (era o ARG_MAX). conf é pequeno -> segue por --argjson.
  local t; t="$(mktemp -d)"
  _pairs "$d" sample "$t/exs"; _pairs "$d" hidden "$t/tss"
  _cat "$d" good "$t/good"; _cat "$d" slow "$t/slow"; _cat "$d" wrong "$t/wrong"; _cat "$d" pass "$t/pass"; _cat "$d" upcoming "$t/up"
  _scripts_nd "$d" "$t/scr"
  local enf="${enunf:-/dev/null}"; [[ -f "$enf" ]] || enf=/dev/null
  local edf="$d/docs/solucao.md"; [[ -f "$edf" ]] || edf=/dev/null
  local scoref="$d/tests/score"; [[ -f "$scoref" ]] || scoref=/dev/null   # ""=remove no servidor (fidelidade)
  # round-trip de scripts/score só quando o clone é CIENTE (scripts_rt no .moj-id) ou o
  # diretório/arquivo existe localmente — clone antigo não apaga scripts/score de ninguém.
  local rtflag=n
  { [[ -d "$d/scripts" || -f "$d/tests/score" ]] || [[ "$(jq -r '.scripts_rt//false' "$d/.moj-id" 2>/dev/null)" == true ]]; } && rtflag=y
  jq -n --rawfile enun "$enf" --argjson conf "$(slurp "$d/conf")" --arg efmt "$efmt" \
        --arg author "$(head -1 "$d/author" 2>/dev/null || true)" \
        --argjson tags "$([[ -f "$d/tags" ]] && jq -R . "$d/tags" | jq -sc . || echo '[]')" \
        --arg title "$([[ -f "$d/.moj-id" ]] && jq -r '.title//""' "$d/.moj-id" || echo '')" \
        --argjson colls "$([[ -f "$d/.moj-id" ]] && jq -c '.collections//[]' "$d/.moj-id" || echo '[]')" \
        --argjson langs "$([[ -f "$d/.moj-id" ]] && jq -c '.languages//[]' "$d/.moj-id" || echo '[]')" \
        --slurpfile exs "$t/exs" --slurpfile tss "$t/tss" --slurpfile scr "$t/scr" \
        --slurpfile good "$t/good" --slurpfile slow "$t/slow" --slurpfile wrong "$t/wrong" \
        --slurpfile pass "$t/pass" --slurpfile up "$t/up" --rawfile scoretxt "$scoref" \
        --arg edflag "$([[ -f "$d/docs/solucao.md" ]] && echo y)" --rawfile editorial "$edf" \
        --arg rtflag "$rtflag" '
    {title:$title, author:$author, tags:$tags, collections:$colls, languages:$langs, enunciado_md:$enun, enunciado_format:$efmt,
     conf_text:$conf, examples:$exs, tests:$tss, sols:{good:$good,slow:$slow,wrong:$wrong,pass:$pass,upcoming:$up}}
    + (if $rtflag=="y" then {scripts_files:$scr, score_text:$scoretxt} else {} end)
    + (if $edflag=="y" then {editorial_md:$editorial} else {} end)'
  rm -rf "$t"; }
# json_to_pkg <json-FILE> <dir> <id> — materializa o pacote a partir do /problems/source.
#
# O JSON vem em ARQUIVO, NUNCA em variável. Duas razões, as duas graves num pacote grande (o source
# de um problema de 84 MB tem ~100 MB):
#   (a) o `--argjson s "$j"` do .moj-id passava o JSON INTEIRO como argumento do execve => estourava o
#       teto de 128 KiB POR ARGUMENTO ("Argument list too long") => `moj clone` de problema grande
#       simplesmente NÃO FUNCIONAVA (e deixava o pacote pela metade);
#   (b) cada `<<<"$j"` regrava o JSON inteiro num temp e o jq re-parseia tudo.
# Padrão (o mesmo do servidor em apply_problem_fields): uma passada de jq por coleção, stream NUL
# (--raw-output0) gravado em ARQUIVO, e o laço lê DO ARQUIVO — fd seekable, o bash lê em BLOCO (sobre
# PIPE o `read` do bash faz 1 syscall POR BYTE).
#
# E grava VERBATIM: o servidor já normaliza o \n final. O `jq -r` de antes ACRESCENTAVA um \n a cada
# arquivo, então o clone nunca era byte-exato (e o tl-checksum do clone nunca batia com o do servidor).
json_to_pkg(){ local jf="$1" d="$2" id="$3" _t
  [[ -f "$jf" ]] || { _t="$(mktemp)"; printf '%s' "$jf" > "$_t"; jf="$_t"; }   # compat: veio como string
  local T; T="$(mktemp -d)"
  mkdir -p "$d/docs" "$d/tests/input" "$d/tests/output"
  local efmt; efmt="$(jq -r '.format // .enunciado_format // "md"' < "$jf")"; [[ "$efmt" =~ ^(md|org|tex)$ ]] || efmt=md

  # escalares: 1 passada
  jq --raw-output0 '
      (.enunciado_md // ""),
      (.author // ""),
      ((.tags // []) | if length==0 then "" else (join("\n") + "\n") end),
      (.conf_text // "TLMOD[calibrafactor]=1.35\nULIMITS[-u]=10000\nALLOWPARALLELTEST=y\n"),
      (.editorial_md // ""),
      (.score_text // ""),
      ([(.examples//[])[] | (.explanation // "")] | tojson)
    ' < "$jf" > "$T/s.nul" 2>/dev/null
  local S_EN='' S_AU='' S_TG='' S_CF='' S_ED='' S_SC='' S_NT=''
  { IFS= read -r -d '' S_EN; IFS= read -r -d '' S_AU; IFS= read -r -d '' S_TG; IFS= read -r -d '' S_CF
    IFS= read -r -d '' S_ED; IFS= read -r -d '' S_SC; IFS= read -r -d '' S_NT; } < "$T/s.nul" 2>/dev/null
  printf '%s' "$S_EN" > "$d/docs/enunciado.$efmt"
  printf '%s' "$S_AU" > "$d/author"
  printf '%s' "$S_TG" > "$d/tags"
  printf '%s' "$S_CF" > "$d/conf"
  if [[ -n "$S_ED" ]]; then printf '%s' "$S_ED" > "$d/docs/solucao.md"; else rm -f "$d/docs/solucao.md"; fi
  if [[ -n "$S_SC" ]]; then printf '%s' "$S_SC" > "$d/tests/score"; else rm -f "$d/tests/score"; fi
  if [[ "$(jq -r 'map(select(.!=""))|length' <<<"${S_NT:-[]}" 2>/dev/null)" -gt 0 ]]; then
    printf '%s' "$S_NT" > "$d/docs/sample-notes.json"; else rm -f "$d/docs/sample-notes.json"; fi

  # exemplos e testes: 1 passada cada
  jq --raw-output0 '(.examples//[])[] | (.input // ""), (.output // "")' < "$jf" > "$T/ex.nul" 2>/dev/null
  local i=0 a b
  while IFS= read -r -d '' a && IFS= read -r -d '' b; do i=$((i+1))
    printf '%s' "$a" > "$d/tests/input/sample$i"; printf '%s' "$b" > "$d/tests/output/sample$i"
  done < "$T/ex.nul"
  jq --raw-output0 '(.tests//[])[] | (.name // ""), (.input // ""), (.output // "")' < "$jf" > "$T/t.nul" 2>/dev/null
  local nm
  while IFS= read -r -d '' nm && IFS= read -r -d '' a && IFS= read -r -d '' b; do
    nm="${nm##*/}"; [[ -n "$nm" ]] || continue
    printf '%s' "$a" > "$d/tests/input/$nm"; printf '%s' "$b" > "$d/tests/output/$nm"
  done < "$T/t.nul"

  # soluções: 1 passada p/ todas as categorias
  local cat; for cat in good slow wrong pass upcoming; do mkdir -p "$d/sols/$cat"; done
  jq --raw-output0 '(.sols // {}) | to_entries[] | .key as $c | ((.value // [])[] | $c, (.filename // ""), (.code // ""))' \
    < "$jf" > "$T/so.nul" 2>/dev/null
  local sc fn
  while IFS= read -r -d '' sc && IFS= read -r -d '' fn && IFS= read -r -d '' a; do
    [[ "$sc" =~ ^(good|slow|wrong|pass|upcoming)$ ]] || continue
    fn="${fn##*/}"; [[ "$fn" =~ ^[A-Za-z0-9._-]+$ ]] || continue
    printf '%s' "$a" > "$d/sols/$sc/$fn"
  done < "$T/so.nul"

  # scripts/ (correção especial) — round-trip: arquivos (base64, +x) e symlinks
  rm -rf "$d/scripts"
  jq --raw-output0 '(.scripts_files//[])[] | (.path // ""), (.symlink // ""), (if .exec then "1" else "0" end), (.content_b64 // "")' \
    < "$jf" > "$T/sc.nul" 2>/dev/null
  local sp st sx sb sdir
  while IFS= read -r -d '' sp && IFS= read -r -d '' st && IFS= read -r -d '' sx && IFS= read -r -d '' sb; do
    [[ -n "$sp" ]] || continue
    case "$sp" in /*|*..*) continue;; esac
    sdir="${sp%/*}"; [[ "$sdir" == "$sp" ]] && sdir=""
    mkdir -p "$d/scripts${sdir:+/$sdir}"
    if [[ -n "$st" ]]; then ln -sfn "$st" "$d/scripts/$sp"
    else printf '%s' "$sb" | _b64dec > "$d/scripts/$sp" 2>/dev/null || : > "$d/scripts/$sp"
      [[ "$sx" == 1 ]] && chmod +x "$d/scripts/$sp"
    fi
  done < "$T/sc.nul"

  # .moj-id (metadados do clone; NÃO sobe ao servidor). scripts_rt marca o clone como "ciente do
  # round-trip": só ele pode APAGAR scripts/score no servidor via push. --slurpfile (não --argjson):
  # o JSON grande NÃO cabe no argv.
  jq -n --arg id "$id" --arg r "${id%%#*}" --arg p "${id##*#}" --arg fmt "$efmt" --slurpfile s "$jf" \
    '($s[0] // {}) as $src
     | {id:$id, repo:$r, prob:$p, title:($src.title//""), format:$fmt, collections:($src.collections//[]),
        languages:($src.languages//[]), public:($src.public//false), scripts_rt:true}' > "$d/.moj-id"
  rm -rf "$T" "${_t:-}"; }

# conf get/set por chave (bash; chave entre aspas -> [ ] literais)
conf_get(){ local d="$1" k="$2" line; [[ -f "$d/conf" ]] || return 0; while IFS= read -r line; do [[ "$line" == "$k="* ]] && { line="${line#"$k"=}"; line="${line%\"}"; printf '%s' "${line#\"}"; return 0; }; done < "$d/conf"; }
conf_set(){ local d="$1" k="$2" v="$3" line found=0 tmp; tmp="$(mktemp)"
  [[ -f "$d/conf" ]] && while IFS= read -r line; do if [[ "$line" == "$k="* ]]; then [[ -n "$v" ]] && printf '%s=%s\n' "$k" "$v" >> "$tmp"; found=1; else printf '%s\n' "$line" >> "$tmp"; fi; done < "$d/conf"
  [[ $found -eq 0 && -n "$v" ]] && printf '%s=%s\n' "$k" "$v" >> "$tmp"; mv -f "$tmp" "$d/conf"; }

# ---- comandos simples ---------------------------------------------------------------------
cmd_login(){ local u p; read -rp "login MOJ: " u; read -rsp "senha: " p; echo
  local tok; tok="$(api POST "/auth/login?contest=$CONTEST" "$(jq -n --arg u "$u" --arg p "$p" '{username:$u,password:$p}')" | jq -r '.token // empty')"
  [[ -n "$tok" ]] || die "login falhou."; printf '%s' "$tok" | token_save; echo "ok, logado como $u."; }
cmd_logout(){ token_drop; echo "deslogado."; }
cmd_whoami(){ need_login; api GET "/auth/status?contest=$CONTEST" | jq -r '"login: \(.login//"?")  nome: \(.name//"?")"'
  local c; c="$(http_code GET "/treino/contest-create/permission")"; [[ "$c" == 200 ]] && api GET "/treino/contest-create/permission" | jq -r '"pode criar problemas: \(if .can_create then "sim" else "não" end)\(if .reason then " (\(.reason))" else "" end)"'; }
cmd_repos(){ need_login; api_get_cached 60 "/problems/repos" | jq -r '.repos[]? | "  \(.repo)\(if .mine then "" else "  (compartilhado)" end)  [\(.collaborators|join(","))]"'; }
cmd_ls(){ need_login; local tab="${1:-mine}" j; j="$(api_get_cached 60 "/problems/$tab")"
  [[ "$RAW" == 1 ]] && { printf '%s\n' "$j"; return; }
  jq -r '.problems[]? | "  \(.id)\t\(if .public then "público" else "rascunho" end)\t\(.title // .prob)"' <<<"$j" | { column -t -s$'\t' 2>/dev/null || cat; }; }
cmd_mkdir(){ need_login; [[ $# -ge 1 ]] || die "uso: moj mkdir <org>   (= moj org create; a org é o <org> do id)"; api POST "/problems/repo-create" "$(jq -n --arg r "$1" '{repo:$r}')" | jq -r '"org criada: \(.repo) (você é admin)"'; }
cmd_publish(){ need_login; [[ $# -ge 1 ]] || die "uso: moj publish <id> [--yes]   (= moj public <id> on)"; cmd_public "$1" on "${@:2}"; }
cmd_public(){ need_login; [[ $# -ge 2 ]] || die "uso: moj public <id> on|off [--yes]"
  local id="$1" onoff="$2" yes=0 a; shift 2; for a in "$@"; do [[ "$a" == --yes || "$a" == -y ]] && yes=1; done
  local v=false; [[ "$onoff" == on ]] && v=true
  # TORNAR PÚBLICO é ação cautelosa: confirma (provas devem ficar privadas). --yes p/ scripts.
  if [[ "$v" == true && "$yes" -eq 0 ]]; then
    echo "⚠ TORNAR PÚBLICO publica '$id' no TREINO LIVRE (visível a TODOS). Provas devem ficar privadas." >&2
    local c; read -rp "Confirmar publicação? [s/N] " c </dev/tty || true
    [[ "$c" =~ ^[sySY] ]] || die "cancelado — nada publicado."
  fi
  api POST "/problems/set-public" "$(jq -n --arg id "$id" --argjson p "$v" '{id:$id,public:$p}')" \
    | jq -r 'if .public then "\(.id): PÚBLICO — o servidor VALIDA + CALIBRA (reqid \(.reqid // "?")). Acompanhe com: moj check \(.id)" else "\(.id): despublicado (saiu do treino livre)" end'; }
cmd_calibrate(){ need_login; [[ $# -ge 1 ]] || die "uso: moj calibrate <id>"; api POST "/problems/request-calibration" "$(jq -n --arg id "$1" '{id:$id}')" | jq -r '"calibração enfileirada: \(.id) (reqid \(.reqid))"'; }
# moj validate <id> — PORTÃO DE QUALIDADE sem publicar: roda o validador estático (enunciado, testes,
# soluções, seções obrigatórias) + gera o índice, e pede calibração ao juiz. O problema segue PRIVADO
# — publicar é `moj public <id> on`, e aí a ORG precisa permitir. Espera o relatório novo (o campo
# `at` muda) e o imprime com o mesmo formato do `moj check`.
cmd_validate(){ need_login; [[ $# -ge 1 ]] || die "uso: moj validate <id> [--no-wait]"
  local id="$1" wait=1 a before at i; shift
  for a in "$@"; do [[ "$a" == --no-wait || "$a" == -n ]] && wait=0; done
  # pre-check INFORMATIVO nunca pode derrubar o comando (set -e): problema recém-subido pode
  # ainda não estar visível (índice/overlay atrasado) — o GET falha e o validate seguia morrendo
  # ANTES do POST (derrubou upload em lote; ver lição jq-argmax do overlay authored)
  before="$(api GET "/problems/validation?id=$(enc "$id")" 2>/dev/null | jq -r '.at // 0')" || before=0
  api POST "/problems/validate" "$(jq -n --arg id "$id" '{id:$id}')" \
    | jq -r '"validação enfileirada: \(.id)" + (if (.reqid // "") != "" then "  (calibração reqid \(.reqid))" else "" end)'
  [[ "$wait" == 1 ]] || return 0
  for i in $(seq 1 30); do
    sleep 2
    at="$(api GET "/problems/validation?id=$(enc "$id")" 2>/dev/null | jq -r '.at // 0')" || at=0
    [[ "${at:-0}" -gt "${before:-0}" ]] && { echo; cmd_check "$id"; return 0; }
  done
  echo "  (o relatório ainda não saiu — veja depois com 'moj check $id')"; }
cmd_share(){ need_login; [[ $# -ge 2 ]] || die "uso: moj share <org> <login>   (adiciona membro à org — quem edita)"; api POST "/problems/repo-collaborators" "$(jq -n --arg r "$1" --arg u "$2" '{repo:$r,add:[$u]}')" | jq -r '"membros da org \(.repo): \(.collaborators|join(", "))"'; }
cmd_unshare(){ need_login; [[ $# -ge 2 ]] || die "uso: moj unshare <org> <login>"; api POST "/problems/repo-collaborators" "$(jq -n --arg r "$1" --arg u "$2" '{repo:$r,remove:[$u]}')" | jq -r '"membros da org \(.repo): \(.collaborators|join(", "))"'; }
# gestão de ORGS (o <org> do id <org>#<prob>): membros escrevem em qualquer problema; admins gerem a
# trava de público (privada = problemas nunca ficam públicos). Cada usuário tem a org implícita <login>.
cmd_org(){ need_login; local sub="${1:-list}"; shift || true
  case "$sub" in
    list|ls) api GET "/orgs/list" | jq -r '.orgs[]? | "  \(.name)\t\(if .implicit then "(própria)" elif .public_allowed then "público-ok" else "privada" end)\t\(.count) probs (\(.public) púb)\t[\(.members|join(","))]\(if .can_manage then "  *admin" else "" end)"' | { column -t -s$'\t' 2>/dev/null || cat; } ;;
    create|new) [[ $# -ge 1 ]] || die "uso: moj org create <nome> [--public] [--members a,b] [--admins c]"
      local name="$1" pa=false members="" admins=""; shift
      while [[ $# -gt 0 ]]; do case "$1" in --public) pa=true;; --members) members="$2"; shift;; --admins) admins="$2"; shift;; esac; shift; done
      api POST "/orgs/create" "$(jq -n --arg n "$name" --argjson pa "$pa" --arg m "$members" --arg a "$admins" '{name:$n, public_allowed:$pa, members:($m|split(",")|map(select(length>0))), admins:($a|split(",")|map(select(length>0)))}')" \
        | jq -r '"org \(.name): membros=[\(.members|join(","))] admins=[\(.admins|join(","))] permite-público=\(.public_allowed)"' ;;
    members|membros) [[ $# -ge 1 ]] || die "uso: moj org members <nome> [--add a,b] [--remove c] [--admins-add d] [--admins-remove e]"
      local name="$1"; shift
      if [[ $# -eq 0 ]]; then api GET "/orgs/members?name=$(enc "$name")" | jq -r '"membros: \(.members|join(", "))\nadmins:  \(.admins|join(", "))"'; return; fi
      local add="" rem="" aadd="" arem=""
      while [[ $# -gt 0 ]]; do case "$1" in --add) add="$2"; shift;; --remove) rem="$2"; shift;; --admins-add) aadd="$2"; shift;; --admins-remove) arem="$2"; shift;; esac; shift; done
      api POST "/orgs/members" "$(jq -n --arg n "$name" --arg a "$add" --arg r "$rem" --arg aa "$aadd" --arg ar "$arem" '{name:$n, add:($a|split(",")|map(select(length>0))), remove:($r|split(",")|map(select(length>0))), admins_add:($aa|split(",")|map(select(length>0))), admins_remove:($ar|split(",")|map(select(length>0)))}')" \
        | jq -r '"membros: \(.members|join(", "))\nadmins:  \(.admins|join(", "))"' ;;
    public|publico) [[ $# -ge 2 ]] || die "uso: moj org public <nome> on|off"
      local name="$1" onoff="$2" v=false; [[ "$onoff" == on ]] && v=true
      api POST "/orgs/set-public-allowed" "$(jq -n --arg n "$name" --argjson v "$v" '{name:$n, public_allowed:$v}')" \
        | jq -r '"org \(.name): permite público = \(.public_allowed)\(if (.unpublished//0)>0 then " (despublicou \(.unpublished))" else "" end)"' ;;
    rm|remove|delete) [[ $# -ge 1 ]] || die "uso: moj org rm <nome>   (só org VAZIA; a implícita não sai)"
      api POST "/orgs/delete" "$(jq -n --arg n "$1" '{name:$n}')" | jq -r '"org removida: \(.name)"' ;;
    *) die "uso: moj org list|create|members|public|rm" ;;
  esac; }
cmd_mv(){ need_login; [[ $# -ge 2 ]] || die "uso: moj mv <id> <org-destino>   (só rascunho; muda o id p/ <org>#<prob>)"
  api POST "/problems/move" "$(jq -n --arg id "$1" --arg to "$2" '{id:$id, to_org:$to}')" | jq -r '"movido: \(.from) -> \(.id)"'; }

cmd_status(){ need_login
  if [[ $# -ge 1 ]]; then cmd_check "$1"; return; fi
  api GET "/index/status" | out '"  juízes online: \(.judge.online)/\(.judge.total)  (ocupados \(.judge.busy), \(.judge.cpus_online) CPUs, \(.judge.gpus_online) com GPU)\n  fila: \(.queue.total_pending) pendentes (\(.queue.spool_queued) no spool)\n  daemons: judged=\(.daemons.judged) result-sink=\(.daemons.result_sink)" + (if .alert.no_judges then "\n  ⚠ trabalho na fila e NENHUM juiz online" else "" end)'; }
# QA COMPLETO de um problema: validação (testado em todos os casos) + calibração (TL por juiz +
# solução good que falhou em TODAS as máquinas) + TL servido/staleness.
cmd_check(){ need_login; [[ $# -ge 1 ]] || die "uso: moj check <id>"; local id="$1" vt ct tt
  vt="$(api GET "/problems/validation?id=$(enc "$id")" 2>/dev/null)" || vt='{}'
  ct="$(api GET "/problems/calib?id=$(enc "$id")" 2>/dev/null)" || ct='{}'
  tt="$(api GET "/problems/tl?id=$(enc "$id")" 2>/dev/null)" || tt='{}'
  [[ "$RAW" == 1 ]] && { jq -cn --argjson v "$vt" --argjson c "$ct" --argjson t "$tt" '{validation:$v, calib:$c, tl:$t}'; return; }
  local validado calibrado recal miss
  validado="$(jq -r 'if (.checks|not) or .status=="unvalidated" then "não validado" elif .ok then "APROVADO" else "REPROVADO" end' <<<"$vt" 2>/dev/null)"
  calibrado="$(jq -r 'if .calibrated then "sim" else "não" end' <<<"$tt" 2>/dev/null)"
  recal="$(jq -r 'if .needs_recalibration then "SIM ⚠" else "não" end' <<<"$tt" 2>/dev/null)"
  miss="$(jq -rc '(.missing_langs // [])|join(", ")' <<<"$ct" 2>/dev/null)"
  printf '%s\n  validado: %s   calibrado: %s   precisa recalibrar: %s\n' "$id" "${validado:-?}" "${calibrado:-?}" "${recal:-?}"
  [[ -n "$miss" ]] && printf '  ⚠ REVISAR: solução good SEM TL em [%s] — falhou em TODAS as máquinas de juiz\n' "$miss"
  echo "  Validação (testado em todos os casos):"
  jq -r '(.checks//[])[] | "    \(if .ok then "✓" else "✗" end) \(.name)\(if (.detail//"")!="" then " — \(.detail)" else "" end)"' <<<"$vt" 2>/dev/null || echo "    (sem relatório)"
  echo "  Time limits (máx entre juízes):"
  jq -r '(.time_limits//{})|to_entries|map(select(.key!="default"))| if length==0 then "    (sem TL)" else (map("    \(.key): \(.value)s")|join("\n")) end' <<<"$tt" 2>/dev/null
  echo "  Calibração por máquina:"
  jq -r '(.hosts//[])[] | "    \(.host): " + ((.tl//{})|to_entries|map(select(.key!="default"))|map("\(.key)=\(.value)")|join(" ")) + (if ((.missing//[])|length)>0 then "   (falta: \(.missing|join(","))" + ")" else "" end)' <<<"$ct" 2>/dev/null || echo "    (não calibrado)"
}
# PAINEL dos meus problemas: o que precisa de atenção, de relance (GET /problems/status).
cmd_board(){ need_login; local j; j="$(api GET "/problems/status")"
  [[ "$RAW" == 1 ]] && { printf '%s\n' "$j"; return; }
  jq -r '.counts as $c | "  \(.total) problemas · \($c.needs_review // 0) revisar · \($c.good_sol_no_tl // 0) good sem TL · \($c.public_unvalidated // 0) público não validado · \($c.needs_recalibration // 0) recalibrar"' <<<"$j"
  { printf 'PROBLEMA\tPÚBLICO\tVALIDADO\tCALIBRADO\tREVISAR\n'
    jq -r '(.problems//[]) | sort_by(if .needs_review then 0 elif .needs_recalibration then 1 else 2 end) | .[] | "\(.id)\t\(if .public then "sim" else "não" end)\t\(if .validated=="ok" then "OK" elif .validated=="error" then "REPROV" else "—" end)\t\(if .calibrated then "sim" else "não" end)\t\((.review_reasons//[])|join(","))"' <<<"$j"
  } | { column -t -s$'\t' 2>/dev/null || cat; }
}
cmd_info(){ need_login; [[ $# -ge 1 ]] || die "uso: moj info <id>"
  local id="$1" d="${1##*#}"
  # cache: se há um CLONE LOCAL, mostra os metadados/contagens dele — sem consultar o servidor.
  if [[ -f "$d/.moj-id" && "$(jq -r '.id//""' "$d/.moj-id" 2>/dev/null)" == "$id" ]]; then
    jq -r '"id: \(.id)\ntítulo: \(.title//.prob)\npúblico: \(.public)  coleções: \((.collections//[])|join(", "))"' "$d/.moj-id"
    printf 'autor: %s\ntags: %s\n' "$(head -1 "$d/author" 2>/dev/null || echo —)" "$(paste -sd', ' "$d/tags" 2>/dev/null)"
    printf 'exemplos: %s  testes ocultos: %s\nsoluções: %s\n' \
      "$(find "$d/tests/input" -name 'sample*' 2>/dev/null | wc -l)" \
      "$(( $(find "$d/tests/input" -type f 2>/dev/null | wc -l) - $(find "$d/tests/input" -name 'sample*' 2>/dev/null | wc -l) ))" \
      "$(for c in good wrong slow pass upcoming; do n=$(ls "$d/sols/$c" 2>/dev/null | wc -l); ((n)) && printf '%s:%s ' "$c" "$n"; done)"
    echo "(do clone local ./$d — 'moj status $id' p/ a validação atual do servidor)"; return 0
  fi
  # sem clone: vai ao servidor — 2 GETs em PARALELO e com cache local (TTL 60s; repete = instantâneo).
  local gt st; gt="$(mktemp)"; st="$(mktemp)"
  api_get_cached 60 "/problems/get?id=$(enc "$id")"    > "$gt" 2>/dev/null &
  api_get_cached 60 "/problems/source?id=$(enc "$id")" > "$st" 2>/dev/null &
  wait
  jq -r '"id: \(.id)\ntítulo: \(.title//.prob)\nautor: \(.author//"—")\ndono: \(.owner//"—")\npúblico: \(.public)  coleções: \((.collections//[])|join(", "))\ntags: \((.tags//[])|join(", "))\nvalidação: \(if .validation==null then "—" elif .validation.ok then "APROVADO" else "REPROVADO" end)"' "$gt" 2>/dev/null
  jq -r '"exemplos: \(.examples|length)  testes ocultos: \(.tests|length)\nsoluções: " + ([.sols|to_entries[]|"\(.key):\(.value|length)"]|join(" · "))' "$st" 2>/dev/null || true
  rm -f "$gt" "$st"; }

cmd_new(){ need_login; [[ $# -ge 2 ]] || die "uso: moj new <org> <prob>"
  local repo="$1" prob="$2" d="$2"; [[ -e "$d" ]] && die "já existe ./$d"
  local me; me="$(api GET "/auth/status?contest=$CONTEST" | jq -r '.name // .login // ""')"
  local tmpl; tmpl="$(jq -n --arg a "$me" '{title:"Título do Problema", author:$a, tags:["iniciante"], collections:[], public:false,
    enunciado_md:"Descreva o problema.\n\n## Entrada\n\nDescreva a entrada.\n\n## Saída\n\nDescreva a saída.\n\n## Observações\n\nRestrições e limites.\n",
    conf_text:"TLMOD[calibrafactor]=1.35\nULIMITS[-u]=10000\nALLOWPARALLELTEST=y\n",
    examples:[{input:"1 2\n",output:"3\n"}], tests:[], sols:{good:[{filename:"sol.py",code:"a,b=map(int,input().split())\nprint(a+b)\n"}],slow:[],wrong:[],pass:[],upcoming:[]}}')"
  json_to_pkg "$tmpl" "$d" "$repo#$prob"
  echo "criado ./$d  (id $repo#$prob).  edite com 'moj edit $d' ou os arquivos + 'moj push $d'."; }
cmd_clone(){ need_login; [[ $# -ge 1 ]] || die "uso: moj clone <id> [dir]"
  local id="$1" d="${2:-${1##*#}}"; [[ -e "$d" ]] && die "já existe ./$d"
  # o source vai p/ ARQUIVO: num problema grande são 100+ MB de JSON — em variável o bash copia tudo
  # e cada jq re-parseia o conjunto (e o .moj-id estourava o argv: "Argument list too long").
  local sf; sf="$(mktemp)"
  api_get_to_file "/problems/source?id=$(enc "$id")" "$sf"
  json_to_pkg "$sf" "$d" "$id"
  echo "clonado ./$d  (editable: $(jq -r '.editable // false' < "$sf"))"
  rm -f "$sf"; }

gate(){ local d="$1" ok=1
  [[ -s "$d/docs/enunciado.md" || -s "$d/enunciado.md" ]] || { echo "  ⚠ sem enunciado" >&2; ok=0; }
  [[ "$(find "$d/tests/input" -maxdepth 1 -name 'sample*' 2>/dev/null | wc -l)" -ge 1 ]] || { echo "  ⚠ sem exemplos" >&2; ok=0; }
  find "$d/sols/good" -maxdepth 1 -type f 2>/dev/null | grep -q . || { echo "  ⚠ sem solução em sols/good/" >&2; ok=0; }
  [[ $ok -eq 1 ]]; }
# moj test [dir] [--run [sol]] — pré-voo estático; com --run, JULGA localmente delegando ao
# mojtools/build-and-test.sh (exige checkout do mojtools + Linux com bwrap REAL; no macOS não
# há sandbox — use 'moj publish/calibrate' + 'moj check', o juiz valida).
cmd_test(){ local d="." run=0 sol="" a
  for a in "$@"; do case "$a" in
    --run) run=1;;
    --*) die "opção desconhecida: $a (uso: moj test [dir] [--run [sol]])";;
    *) if [[ -d "$a" ]]; then d="$a"; elif [[ -f "$a" ]]; then sol="$a"; else die "não achei '$a' (dir do pacote ou arquivo de solução)"; fi;;
  esac; done
  if gate "$d"; then echo "ok: pré-voo passou (enunciado, exemplos e solução good presentes)."
  else [[ $run -eq 1 ]] || return 1; echo "  (seguindo p/ o --run mesmo assim)"; fi
  [[ $run -eq 1 ]] || return 0
  local mt; mt="$(mojtools_dir)"
  have bwrap || die "julgamento local exige bwrap (Linux). No macOS/sem sandbox: 'moj publish' ou 'moj calibrate' + 'moj check' — o juiz valida por você."
  bwrap --version 2>&1 | grep -qi fbwrap && die "o bwrap daqui é o fbwrap (no-op do firejail) — sem sandbox real não dá p/ julgar localmente; use 'moj calibrate' + 'moj check'."
  # TL de referência: sem tl calibrado no pacote, cria um transitório (CALIBRATIONTL ou 5s)
  local tltmp=0 ctl=""
  if [[ ! -f "$d/tl" ]]; then
    ctl="$(conf_get "$d" CALIBRATIONTL)"; [[ "$ctl" =~ ^[0-9.]+$ ]] || ctl=5
    printf 'TL[default]=%s\n' "$ctl" > "$d/tl"; tltmp=1
  fi
  local sols=() s lang v rc=0
  if [[ -n "$sol" ]]; then sols=("$sol"); else shopt -s nullglob; sols=("$d"/sols/good/*); shopt -u nullglob; fi
  if [[ ${#sols[@]} -eq 0 ]]; then [[ $tltmp -eq 1 ]] && rm -f "$d/tl"; die "nada p/ julgar (sols/good vazio)"; fi
  echo "julgando localmente (mojtools: $mt$( ((tltmp)) && echo "; TL transitório ${ctl}s" ))…"
  for s in "${sols[@]}"; do
    lang="${s##*.}"
    v="$( (cd "$mt" && bash build-and-test.sh "$lang" "$(_abspath "$s")" "$(_abspath "$d")" y) 2>/dev/null | tail -n1 )"
    printf '  %s -> %s\n' "$(basename "$s")" "${v:-?}"
    if [[ "$s" == */sols/good/* && ! "$v" =~ ^Accepted ]]; then rc=1; fi
  done
  [[ $tltmp -eq 1 ]] && rm -f "$d/tl"
  return $rc; }
# atalhos p/ os instaladores do mojtools (autoria local; requerem checkout do mojtools)
cmd_checker(){ [[ $# -ge 2 ]] || die "uso: moj checker <dir> <checker.cpp>   (checker testlib normalizado; ver mojtools/docs/checker-testlib.md)"
  local mt; mt="$(mojtools_dir)"
  bash "$mt/testlib/install-checker.sh" "$1" "$2"
  echo "dica: 'moj push $1' já envia scripts/ (round-trip); 'moj test $1 --run' julga local."; }
cmd_interactive(){ [[ $# -ge 2 ]] || die "uso: moj interactive <dir> <arbitro.cpp|.py|.sh> [--score] [--langs \"...\"]   (ver mojtools/docs/problema-interativo.md)"
  local mt; mt="$(mojtools_dir)"; local d="$1" arb="$2"; shift 2
  bash "$mt/interactive/install-interactive.sh" "$d" "$arb" "$@"
  echo "dica: 'moj push $d' já envia scripts/ (round-trip)."; }
cmd_push(){ need_login
  local force=0 d="." a; for a in "$@"; do case "$a" in --force) force=1;; --*) die "opção desconhecida: $a (uso: moj push [dir] [--force])";; *) d="$a";; esac; done
  [[ -f "$d/.moj-id" ]] || die "rode dentro de um problema (faltou .moj-id; use 'moj new'/'moj clone')."
  local id repo prob; id="$(jq -r .id "$d/.moj-id")"; repo="$(jq -r .repo "$d/.moj-id")"; prob="$(jq -r .prob "$d/.moj-id")"
  # TÍTULO obrigatório: sem ele o problema sai com o nome da pasta (o servidor deriva o slug).
  local title; title="$(jq -r '.title // ""' "$d/.moj-id")"
  if [[ -z "$title" || "$title" == "Título do Problema" ]]; then
    [[ $force -eq 1 ]] || die "defina o TÍTULO antes de enviar — senão o problema fica com o nome da pasta ('$prob'). Use 'moj edit $id' (opção 1) ou edite o .title em .moj-id. (--force envia assim mesmo)"
    echo "  ⚠ sem título — vai usar o nome da pasta ('$prob')."
  fi
  if ! gate "$d"; then [[ $force -eq 1 ]] || die "pré-voo falhou (use --force só p/ rascunho privado)."; echo "  (--force: subindo mesmo assim)"; fi
  # corpo via ARQUIVO (testes grandes estouram o argv do jq/curl): pkg_to_json escreve, jq injeta
  # id/repo lendo o arquivo, e o POST vai por api_post_file (--data-binary @arquivo).
  local bf bf2 resp; bf="$(mktemp)"; bf2="$(mktemp)"
  pkg_to_json "$d" > "$bf"
  # PRÉ-VOO BARATO: /problems/get devolve METADADOS. O /problems/source (o de antes) fazia o servidor
  # SERIALIZAR O PACOTE INTEIRO (~100 MB num pacote grande) só p/ jogar fora — dobrava o custo do push
  # e, quando ELE estourava o tempo-limite, o push caía no ramo `create` e tomava 409.
  # E o POST vai FORA DE PIPE: no pipe, o `die` matava só o subshell e o push falhava com rc=0.
  if [[ "$(http_code GET "/problems/get?id=$(enc "$id")")" == 2* ]]; then
    jq -c --arg id "$id" '. + {id:$id}' "$bf" > "$bf2"
    resp="$(api_post_file "/problems/edit" "$bf2")" || { rm -f "$bf" "$bf2"; exit 1; }
    jq -r '"enviado (edit): \(.id)  sha \(.sha)"' <<<"$resp"
  else
    api POST "/problems/repo-create" "$(jq -n --arg r "$repo" '{repo:$r}')" >/dev/null 2>&1 || true
    jq -c --arg r "$repo" --arg p "$prob" '. + {repo:$r,prob:$p}' "$bf" > "$bf2"
    if resp="$(API_SOFT=1 api_post_file "/problems/create" "$bf2" 2>/dev/null)"; then
      jq -r '"enviado (novo): \(.id)  sha \(.sha)"' <<<"$resp"
    else
      # 409 "já existe" (índice ainda não enxergou o problema): reenvia como EDIT em vez de morrer
      jq -c --arg id "$id" '. + {id:$id}' "$bf" > "$bf2"
      resp="$(api_post_file "/problems/edit" "$bf2")" || { rm -f "$bf" "$bf2"; exit 1; }
      jq -r '"enviado (edit): \(.id)  sha \(.sha)"' <<<"$resp"
    fi
  fi
  rm -f "$bf" "$bf2"; echo "publique com 'moj publish $id' quando estiver pronto."; }

cmd_rm(){ need_login; [[ $# -ge 1 ]] || die "uso: moj rm <id>   (remove o problema da base e do treino)"
  local id="$1" c=""
  echo "⚠ Isto REMOVE o problema '$id' do Gitea e do treino — destrutivo."
  read -rp "Para confirmar, repita o id ($id): " c </dev/tty || true
  [[ "$c" == "$id" ]] || die "confirmação não bateu — nada foi removido."
  api POST "/problems/delete" "$(jq -n --arg id "$id" '{id:$id, confirm:$id}')" | jq -r '"removido: \(.id)"'; }
cmd_download(){ need_login; [[ $# -ge 1 ]] || die "uso: moj download <id> [arquivo]"
  local id="$1" out="${2:-${1##*#}.tar.gz}"
  api_get_to_file "/problems/download?id=$(enc "$id")" "$out"; echo "baixado: $out"; }
# _tar_meta_json <arquivo> -> conteúdo do .moj-meta.json dentro do pacote (best-effort; {} se ausente)
_tar_meta_json(){ local a="$1" d m; d="$(mktemp -d)"
  if [[ "$(head -c2 "$a" 2>/dev/null)" == "PK" ]]; then
    have unzip && unzip -qq -o "$a" '*.moj-meta.json' -d "$d" >/dev/null 2>&1 || true
  else
    # GNU tar precisa de --wildcards p/ glob; BSD tar faz glob por default (e rejeita a flag)
    tar -xf "$a" -C "$d" --wildcards '*.moj-meta.json' >/dev/null 2>&1 \
      || tar -xf "$a" -C "$d" '*.moj-meta.json' >/dev/null 2>&1 || true
  fi
  m="$(find "$d" -name '.moj-meta.json' 2>/dev/null | head -1 || true)"
  { [[ -n "$m" ]] && cat "$m" 2>/dev/null; } || echo '{}'
  rm -rf "$d"; }
cmd_upload(){ need_login
  local force=0 args=() a
  for a in "$@"; do case "$a" in --force) force=1;; --*) die "opção desconhecida: $a";; *) args+=("$a");; esac; done
  [[ ${#args[@]} -ge 1 ]] || die "uso: moj upload <id> [dir|arquivo.(tar.gz|tar.bz2|tar.zst|zip)] [--force]   (dir/omitido = empacota sozinho)"
  local id="${args[0]}" src="${args[1]:-.}" tarball tmptar=""
  if [[ -d "$src" ]]; then
    [[ -f "$src/conf" || -d "$src/tests" ]] || die "'$src' não parece um pacote MOJ (sem conf/tests)"
    tmptar="$(mktemp)"; tarball="$tmptar"
    tar -czf "$tarball" -C "$src" --exclude='./.git' --exclude='./.moj-id' \
        --exclude='./.arbitro-cache' --exclude='./.checker-cache' --exclude='./.pre-normalizacao*' .
    echo "empacotado: $src -> $(du -h "$tarball" 2>/dev/null | cut -f1 || echo '?')"
  elif [[ -f "$src" ]]; then tarball="$src"
  else die "arquivo/diretório não encontrado: $src"; fi
  local meta; meta="$(_tar_meta_json "$tarball")"
  # TÍTULO obrigatório no pacote (senão o problema sai com o nome da pasta):
  local mt; mt="$(jq -r '.display_title // ""' <<<"$meta" 2>/dev/null)"
  if [[ -z "$mt" ]]; then
    [[ $force -eq 1 || "${MOJ_ALLOW_NO_TITLE:-}" == 1 ]] || die "o pacote não tem 'display_title' no .moj-meta.json — o problema sairia com o nome da pasta. Inclua o campo (ou --force p/ enviar assim)."
    echo "  ⚠ sem display_title no pacote — o servidor vai derivar do enunciado/pasta."
  fi
  # footgun documentado: o upload substitui TUDO, inclusive o .moj-meta.json — public:false
  # no pacote DESPUBLICA um problema público (publique de novo com 'moj public <id> on').
  # (o `//` do jq engole false — testar com ==, nunca com .public // "ausente")
  [[ "$(jq -r '.public == false' <<<"$meta" 2>/dev/null)" == true ]] && \
    echo "  ⚠ o .moj-meta.json do pacote tem public:false — se o problema estiver público, este upload o DESPUBLICA."
  local bf b64; bf="$(mktemp)"; b64="$(mktemp)"; _b64enc "$tarball" > "$b64"
  jq -n --arg id "$id" --rawfile t "$b64" '{id:$id,tar_b64:$t}' > "$bf"
  api_post_file "/problems/upload" "$bf" | jq -r '"enviado: \(.id)  sha \(.sha)"'
  rm -f "$bf" "$b64" ${tmptar:+"$tmptar"}; }
cmd_export(){ need_login; [[ $# -ge 1 ]] || die "uso: moj export <id> [arquivo.tar.gz]   (pacote ICPC/Kattis)"
  local id="$1" out="${2:-${1##*#}.icpc.tar.gz}"
  api_get_to_file "/problems/export?id=$(enc "$id")" "$out"; echo "exportado (ICPC/Kattis): $out"; }
cmd_import(){ need_login; [[ $# -ge 2 ]] || die "uso: moj import <pacote.(tar.gz|zip)> <pasta> [prob]   (ICPC/Kattis -> MOJ)"
  [[ -f "$1" ]] || die "arquivo não encontrado: $1"
  local bf b64; bf="$(mktemp)"; b64="$(mktemp)"; _b64enc "$1" > "$b64"
  jq -n --arg r "$2" --arg p "${3:-}" --rawfile t "$b64" '{repo:$r, prob:(if $p=="" then null else $p end), tar_b64:$t}' > "$bf"
  api_post_file "/problems/import" "$bf" | jq -r '"importado: \(.id)  sha \(.sha)"'; rm -f "$bf" "$b64"; }
cmd_preview(){ need_login; local d="${1:-.}"; [[ -f "$d/.moj-id" || -d "$d/docs" ]] || die "rode dentro de um problema."
  local body; body="$(jq -c '{title, enunciado_md, enunciado_format, examples}' <<<"$(pkg_to_json "$d")")"
  local out; out="$(mktemp)"; mv "$out" "$out.html"; out="$out.html"   # sem mktemp --suffix (BSD não tem)
  api POST "/problems/preview" "$body" | jq -r '.html_b64' | _b64dec > "$out"
  echo "preview: $out"; have xdg-open && (xdg-open "$out" >/dev/null 2>&1 &) || true; }

# COLEÇÃO = TAG de agrupamento (m:n), curada (registro com dono). ORTOGONAL à ORG (acesso). O nome
# pode ter ESPAÇOS. Marcar um problema numa coleção exige que ela EXISTA (crie antes).
cmd_collection(){ need_login; local sub="${1:-ls}"; shift || true
  case "$sub" in
    ls) api GET "/problems/collections" | jq -r '.collections[]? | "  \(.name)\t[\(.count) probs, \(.public) púb]\tdono:\(.owner//"—")\(if .can_manage then "  *gerencio*" else "" end)"' | { column -t -s$'\t' 2>/dev/null || cat; };;
    create|new) [[ $# -ge 1 ]] || die "uso: moj collection create \"<nome livre>\"  (pode ter espaços)"
      api POST "/problems/collection-create" "$(jq -n --arg n "$*" '{name:$n}')" | jq -r '"coleção criada: \(.name) (dono \(.owner))"';;
    show|browse) [[ $# -ge 1 ]] || die "uso: moj collection show \"<nome>\""
      api GET "/problems/collection?name=$(enc "$*")" | jq -r '.problems[]? | "  \(.id)\t\(if .public then "público" else "rascunho" end)\t\(.title // .prob)"' | { column -t -s$'\t' 2>/dev/null || cat; };;
    add) [[ $# -ge 2 ]] || die "uso: moj collection add <id> \"<coleção>\""
      local id="$1"; shift; local cur; cur="$(api GET "/problems/source?id=$(enc "$id")" | jq -c '.collections // []')"
      api POST "/problems/set-collections" "$(jq -n --arg id "$id" --argjson c "${cur:-[]}" --arg n "$*" '{id:$id, collections:(($c+[$n])|unique)}')" | jq -r '"\(.id): coleções = \(.collections|join(", "))"';;
    remove|rm) [[ $# -ge 2 ]] || die "uso: moj collection remove <id> \"<coleção>\""
      local id="$1"; shift; local cur; cur="$(api GET "/problems/source?id=$(enc "$id")" | jq -c '.collections // []')"
      api POST "/problems/set-collections" "$(jq -n --arg id "$id" --argjson c "${cur:-[]}" --arg n "$*" '{id:$id, collections:($c|map(select(.!=$n)))}')" | jq -r '"\(.id): coleções = \(.collections|join(", "))"';;
    rename) [[ $# -ge 2 ]] || die "uso: moj collection rename \"<nome>\" \"<novo>\""
      api POST "/problems/collection-rename" "$(jq -n --arg n "$1" --arg t "$2" '{name:$n, to:$t}')" | jq -r '"renomeada: \(.from) -> \(.name) (\(.retagged) problemas re-taggeados)"';;
    delete|del) [[ $# -ge 1 ]] || die "uso: moj collection delete \"<nome>\""
      api POST "/problems/collection-delete" "$(jq -n --arg n "$*" '{name:$n}')" | jq -r '"excluída: \(.name) (\(.untagged) problemas destaggeados)"';;
    *) die "subcomando de coleção: ls | create | show | add | remove | rename | delete";;
  esac; }

# ---- editor interativo (como os campos da página) -----------------------------------------
mid(){ jq -r ".$2 // \"\"" "$1/.moj-id" 2>/dev/null; }                 # campo do .moj-id
mid_set(){ local d="$1"; shift; local t; t="$(mktemp)"; jq "$@" "$d/.moj-id" > "$t" && mv -f "$t" "$d/.moj-id"; }
edit_examples(){ local d="$1"
  while true; do echo; echo "Exemplos (aparecem no enunciado):"
    local i=0 f; shopt -s nullglob; for f in "$d/tests/input"/sample*; do i=$((i+1)); echo "  $i) $(basename "$f")  in: $(head -c40 "$f"|tr '\n' ' ')"; done; shopt -u nullglob
    case "$(ask "  [a]dicionar [e]ditar N [r]emover N [v]oltar: ")" in
      a) local n=$(( $(find "$d/tests/input" -name 'sample*'|wc -l) + 1 )); "$ED" "$d/tests/input/sample$n" </dev/tty; "$ED" "$d/tests/output/sample$n" </dev/tty;;
      e*) local k="${REPLY:-}"; k="$(ask '  qual N? ')"; [[ -f "$d/tests/input/sample$k" ]] && { "$ED" "$d/tests/input/sample$k" </dev/tty; "$ED" "$d/tests/output/sample$k" </dev/tty; };;
      r*) local k; k="$(ask '  qual N? ')"; rm -f "$d/tests/input/sample$k" "$d/tests/output/sample$k";;
      *) return;;
    esac; done; }
edit_tests(){ local d="$1"
  while true; do echo; echo "Testes ocultos (correção):"
    local f; shopt -s nullglob; for f in "$d/tests/input"/*; do [[ "$(basename "$f")" == sample* ]] && continue; echo "  - $(basename "$f")"; done; shopt -u nullglob
    case "$(ask '  [a]dicionar [e]ditar <nome> [r]emover <nome> [v]oltar: ')" in
      a) local nm; nm="$(ask '  nome do teste: ')"; nm="$(tr -cd 'A-Za-z0-9._-' <<<"$nm")"; [[ -n "$nm" ]] || continue; "$ED" "$d/tests/input/$nm" </dev/tty; "$ED" "$d/tests/output/$nm" </dev/tty;;
      e*) local nm; nm="$(ask '  nome: ')"; [[ -f "$d/tests/input/$nm" ]] && { "$ED" "$d/tests/input/$nm" </dev/tty; "$ED" "$d/tests/output/$nm" </dev/tty; };;
      r*) local nm; nm="$(ask '  nome: ')"; rm -f "$d/tests/input/$nm" "$d/tests/output/$nm";;
      *) return;;
    esac; done; }
edit_sols(){ local d="$1"
  while true; do echo; echo "Soluções:"
    local c f; for c in good wrong slow pass upcoming; do printf '  %s: ' "$c"; shopt -s nullglob; for f in "$d/sols/$c"/*; do printf '%s ' "$(basename "$f")"; done; shopt -u nullglob; echo; done
    local cat; cat="$(ask '  categoria (good/wrong/slow/pass/upcoming) ou [v]oltar: ')"
    case "$cat" in good|wrong|slow|pass|upcoming) mkdir -p "$d/sols/$cat"
        case "$(ask "  [$cat] [a]dicionar [e]ditar <arq> [r]emover <arq> [v]oltar: ")" in
          a) local fn; fn="$(ask '  nome do arquivo (ex: sol.cpp): ')"; fn="$(basename "$fn")"; [[ -n "$fn" ]] && "$ED" "$d/sols/$cat/$fn" </dev/tty;;
          e*) local fn; fn="$(ask '  arquivo: ')"; [[ -f "$d/sols/$cat/$fn" ]] && "$ED" "$d/sols/$cat/$fn" </dev/tty;;
          r*) local fn; fn="$(ask '  arquivo: ')"; rm -f "$d/sols/$cat/$fn";;
        esac;;
      *) return;;
    esac; done; }
edit_conf(){ local d="$1"
  while true; do echo; echo "Configurações (conf):"
    printf '  1) calibrafactor: %s\n  2) ULIMITS[-u]: %s\n  3) CALIBRATIONTL: %s\n  4) ALLOWPARALLELTEST: %s\n  5) STOPWHEN_WA: %s\n' \
      "$(conf_get "$d" 'TLMOD[calibrafactor]')" "$(conf_get "$d" 'ULIMITS[-u]')" "$(conf_get "$d" CALIBRATIONTL)" "$(conf_get "$d" ALLOWPARALLELTEST)" "$(conf_get "$d" STOPWHEN_WA)"
    case "$(ask '  nº p/ mudar, [b]ruto no editor, [v]oltar: ')" in
      1) conf_set "$d" 'TLMOD[calibrafactor]' "$(ask '  calibrafactor (ex 1.35 ou 1+1.35): ' "$(conf_get "$d" 'TLMOD[calibrafactor]')")";;
      2) conf_set "$d" 'ULIMITS[-u]' "$(ask '  ULIMITS[-u]: ' "$(conf_get "$d" 'ULIMITS[-u]')")";;
      3) conf_set "$d" CALIBRATIONTL "$(ask '  CALIBRATIONTL (s): ' "$(conf_get "$d" CALIBRATIONTL)")";;
      4) conf_set "$d" ALLOWPARALLELTEST "$(ask '  ALLOWPARALLELTEST (y/n): ' "$(conf_get "$d" ALLOWPARALLELTEST)")";;
      5) conf_set "$d" STOPWHEN_WA "$(ask '  STOPWHEN_WA (y/n): ' "$(conf_get "$d" STOPWHEN_WA)")";;
      b) "$ED" "$d/conf" </dev/tty;;
      *) return;;
    esac; done; }
# coleções = TAGS de agrupamento (curadas). Marque só as EXISTENTES; "criar" registra uma nova coleção.
edit_colls(){ local d="$1" cur; cur="$(jq -r '(.collections//[])|join(",")' "$d/.moj-id")"
  echo; echo "Coleções atuais: ${cur:-—}"; echo "  disponíveis (marque só as existentes):"; api GET "/problems/collections" | jq -r '.collections[]? | "    \(.name)  [\(.count)]\(if .can_manage then " *gerencio*" else "" end)"'
  case "$(ask '  [s]et lista (vírgula) [c]riar nova coleção [v]oltar: ')" in
    s) mid_set "$d" --argjson c "$(jq -n --arg s "$(ask '  coleções (vírgula): ' "$cur")" '$s|split(",")|map(select(length>0))|map(gsub("^ +| +$";""))')" '.collections=$c';;
    c) local n; n="$(ask '  nome da coleção (pode ter espaços): ')"
       [[ -n "$n" ]] && { cmd_collection create "$n"; mid_set "$d" --arg n "$n" '.collections=((.collections//[])+[$n]|unique)'; };;
  esac; }
cmd_edit(){ need_login; local arg="${1:-}"; [[ -n "$arg" ]] || die "uso: moj edit <id|dir>"
  [[ -r /dev/tty ]] || die "moj edit é interativo — precisa de um terminal."
  local D
  if [[ -f "$arg/.moj-id" ]]; then D="$arg"
  elif [[ "$arg" == *#* ]]; then D="${arg##*#}"; [[ -e "$D" ]] || cmd_clone "$arg" "$D" >/dev/null; [[ -f "$D/.moj-id" ]] || die "não consegui clonar $arg"
  else die "passe um id (repo#prob) ou um diretório já clonado."; fi
  local id; id="$(mid "$D" id)"
  while true; do
    echo; echo "── Editando $id  (pasta ./$D) ─────────────────────────────"
    printf '  1) Título:    %s\n  2) Autor:     %s\n  3) Tags:      %s\n' "$(mid "$D" title)" "$(head -1 "$D/author" 2>/dev/null)" "$(paste -sd, "$D/tags" 2>/dev/null)"
    printf '  4) Enunciado  (editor)   5) Exemplos (%s)   6) Testes ocultos (%s)\n' "$(find "$D/tests/input" -name 'sample*' 2>/dev/null|wc -l)" "$(( $(find "$D/tests/input" -type f 2>/dev/null|wc -l) - $(find "$D/tests/input" -name 'sample*' 2>/dev/null|wc -l) ))"
    printf '  7) Soluções (good:%s wrong:%s slow:%s)   8) Conf   9) Coleções: %s\n' "$(ls "$D/sols/good" 2>/dev/null|wc -l)" "$(ls "$D/sols/wrong" 2>/dev/null|wc -l)" "$(ls "$D/sols/slow" 2>/dev/null|wc -l)" "$(jq -r '(.collections//[])|join(",")' "$D/.moj-id")"
    printf '  0) Público: %s    r) Compartilhar pasta    v) Pré-visualizar\n' "$(mid "$D" public)"
    printf '  w) SALVAR (push)   P) Validar & Publicar   i) Info/validação   q) Sair\n'
    case "$(ask '  > ')" in
      1) mid_set "$D" --arg t "$(ask '  Título: ' "$(mid "$D" title)")" '.title=$t';;
      2) ask '  Autor: ' "$(head -1 "$D/author" 2>/dev/null)" > "$D/author";;
      3) ask '  Tags (vírgula): ' "$(paste -sd, "$D/tags" 2>/dev/null)" | tr ',' '\n' | sed '/^[[:space:]]*$/d;s/^[[:space:]]*//;s/[[:space:]]*$//' > "$D/tags";;
      4) "$ED" "$(enun_path "$D")" </dev/tty;;
      5) edit_examples "$D";; 6) edit_tests "$D";; 7) edit_sols "$D";; 8) edit_conf "$D";; 9) edit_colls "$D";;
      0) local p; p="$(mid "$D" public)"; [[ "$p" == true ]] && p=false || p=true; mid_set "$D" --argjson p "$p" '.public=$p'; echo "  (aplica no próximo 'salvar')";;
      r) local act u; act="$(ask '  [a]dd ou [r]emove colaborador? ')"; u="$(ask '  login: ')"; [[ -n "$u" ]] && { [[ "$act" == r ]] && cmd_unshare "$(mid "$D" repo)" "$u" || cmd_share "$(mid "$D" repo)" "$u"; };;
      v) cmd_preview "$D";;
      w) cmd_push "$D"; local want; want="$(mid "$D" public)"; cmd_public "$id" "$([[ "$want" == true ]] && echo on || echo off)" >/dev/null 2>&1 || true; echo "  salvo.";;
      P) cmd_push "$D" >/dev/null && cmd_publish "$id";;
      i) cmd_status "$id";;
      q) echo "até mais."; return;;
    esac
  done; }

# camada agregadora: `moj contest …` delega ao moj-contest (ao lado do script ou no PATH).
# Padrão p/ camadas futuras: `moj <camada> …` -> executável moj-<camada>.
exec_layer(){ local layer="$1"; shift
  local d; d="$(dirname "$(_abspath "${BASH_SOURCE[0]}")")"
  [[ -x "$d/moj-$layer" ]] && exec "$d/moj-$layer" "$@"
  have "moj-$layer" && exec "moj-$layer" "$@"
  die "camada '$layer' não instalada: curl -fLO $MOJ_URL/moj-$layer && chmod +x moj-$layer"
}

# --json ANTES do subcomando = saída crua da API nos leitores (ls/board/status/check)
while [[ "${1:-}" == --json ]]; do RAW=1; shift; done
cmd="${1:-help}"; shift || true
case "$cmd" in
  contest) exec_layer contest "$@";;
  judges) exec_layer judges "$@";;
  login) cmd_login "$@";; logout) cmd_logout "$@";; whoami) cmd_whoami "$@";;
  ls) cmd_ls "$@";; repos) cmd_repos "$@";; mkdir) cmd_mkdir "$@";; info|show) cmd_info "$@";;
  new) cmd_new "$@";; clone|open) cmd_clone "$@";; edit) cmd_edit "$@";; test) cmd_test "$@";; push) cmd_push "$@";;
  checker) cmd_checker "$@";; interactive|interativo) cmd_interactive "$@";;
  preview) cmd_preview "$@";; download) cmd_download "$@";; upload) cmd_upload "$@";; export) cmd_export "$@";; import) cmd_import "$@";;
  validate|validar) cmd_validate "$@";;
  publish) cmd_publish "$@";; public) cmd_public "$@";; calibrate) cmd_calibrate "$@";; status) cmd_status "$@";; check) cmd_check "$@";; board|painel) cmd_board "$@";;
  share) cmd_share "$@";; unshare) cmd_unshare "$@";; collection|coll) cmd_collection "$@";; rm|remove) cmd_rm "$@";;
  org|orgs) cmd_org "$@";; mv|move) cmd_mv "$@";;
  help|-h|--help) sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//';;
  *) die "comando desconhecido: $cmd (veja 'moj help')";;
esac
