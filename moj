# TESTE REMOTO NO JUIZ: roda UMA solução avulsa contra o problema — mesma jaula, mesmo TL
# calibrado da submissão real — SEM entrar em history/placar de ninguém. Só quem EDITA o
# problema (o resultado expõe os testes ocultos). Devolve o vetor {name,code,time,tl} por teste.
cmd_testrun(){ need_login
  local pos=() report="" wait=1
  while [[ $# -gt 0 ]]; do case "$1" in
    --report) report="${2:-}"; shift;; --no-wait|-n) wait=0;;
    -*) die "opção desconhecida: $1";; *) pos+=("$1");; esac; shift; done
  # 1 argumento = a solução (o id vem da pasta do problema); 2 = <id|dir> e a solução
  local sol id
  case "${#pos[@]}" in
    1) sol="${pos[0]}"; id="$(resolve_id)" || exit 1;;
    2) sol="${pos[1]}"; id="$(resolve_id "${pos[0]}")" || exit 1;;
    *) die "uso: moj testrun [<id|dir>] <arquivo-solução> [--report <out.html>] [--no-wait]";;
  esac
  [[ -f "$sol" ]] || die "arquivo não encontrado: $sol"
  [[ "$id" == *#* ]] || die "id inválido: '$id' (esperado <org>#<prob>, ou o dir de um clone)"
  # corpo por ARQUIVO (fonte grande nunca anda por argv)
  local b64f bodyf resp run
  b64f="$(mktemp)"; bodyf="$(mktemp)"
  _b64enc "$sol" > "$b64f"          # -w0/arquivo-posicional são GNU: no BSD as DUAS pontas falham
  jq -cn --arg id "$id" --arg f "$(basename "$sol")" --rawfile b "$b64f" \
    '{id:$id, filename:$f, code_b64:$b}' > "$bodyf"
  rm -f "$b64f"
  resp="$(api_post_file "/problems/test-run" "$bodyf")"; rm -f "$bodyf"
  run="$(jq -r '.run // empty' <<<"$resp")"
  [[ -n "$run" ]] || die "resposta inesperada do servidor: ${resp:0:200}"
  echo "enfileirado no juiz: run $run  ($(basename "$sol") contra $id)"
  [[ "$wait" == 1 ]] || { echo "acompanhe com: moj --json testrun-status $run"; return 0; }
  local i j st
  for (( i=0; i<200; i++ )); do            # ~10 min (fila + pacote frio + julgamento)
    sleep 3
    j="$(api GET "/problems/test-run?run=$run" 2>/dev/null)" || continue
    st="$(jq -r '.status // ""' <<<"$j")"
    [[ "$st" == done ]] || continue
    if [[ "$RAW" == 1 ]]; then printf '%s\n' "$j"; else
      jq -r '"veredicto: \(.verdict // "?")  (\(.correct // 0)/\(.total_tests // 0) testes, \(.duration_s // "?")s, tl \(.tl_used // "?")s)",
             ((.tests // [])[] | "  \(.name): \(.code)  \(.time // "?")s  (tl \(.tl // "?")s)")' <<<"$j"
    fi
    if [[ -n "$report" ]]; then
      api_get_to_file "/problems/test-run-report?run=$run" "$report" && echo "report: $report"
    fi
    return 0
  done
  echo "  (ainda julgando — consulte depois: moj testrun-status $run${report:+ e o report})"; return 1
}
# consulta avulsa de um test-run já enfileirado (id devolvido pelo moj testrun)
cmd_testrun_status(){ need_login; [[ $# -ge 1 ]] || die "uso: moj testrun-status <run> [--report <out.html>]"
  local run="$1" report=""; shift
  while [[ $# -gt 0 ]]; do case "$1" in --report) report="${2:-}"; shift;; *) die "opção desconhecida: $1";; esac; shift; done
  local j; j="$(api GET "/problems/test-run?run=$(enc "$run")")"
  if [[ "$RAW" == 1 ]]; then printf '%s\n' "$j"; else
    jq -r 'if .status == "done" then
             "veredicto: \(.verdict // "?")  (\(.correct // 0)/\(.total_tests // 0) testes)",
             ((.tests // [])[] | "  \(.name): \(.code)  \(.time // "?")s  (tl \(.tl // "?")s)")
           else "status: \(.status // "?")  (\(.filename // "?") contra \(.problem_id // "?"))" end' <<<"$j"
  fi
  [[ -n "$report" ]] && api_get_to_file "/problems/test-run-report?run=$(enc "$run")" "$report" && echo "report: $report"
  return 0
}
# PAINEL dos meus problemas: o que precisa de atenção, de relance (GET /problems/status).
cmd_board(){ need_login; local j; j="$(api GET "/problems/status")"
  [[ "$RAW" == 1 ]] && { printf '%s\n' "$j"; return; }
  jq -r '.counts as $c | "  \(.total) problemas · \($c.ready // 0) prontos · \($c.needs_review // 0) revisar · \($c.sols_divergent // 0) com solução divergente · \($c.inputs_invalid // 0) com entrada inválida · \($c.good_sol_no_tl // 0) good sem TL · \($c.needs_recalibration // 0) recalibrar"' <<<"$j"
  # PACOTE = conferência estática (era "VALIDADO"); SOLUÇÕES = cada uma fez o que a categoria pede
  { printf 'PROBLEMA\tPÚBLICO\tPACOTE\tCALIBRADO\tSOLUÇÕES\tPRONTO\tREVISAR\n'
    jq -r '(.problems//[]) | sort_by(if .needs_review then 0 elif .needs_recalibration then 1 else 2 end) | .[]
      | (.sols.state // "") as $s
      | "\(.id)\t\(if .public then "sim" else "não" end)\t\(if .validated=="ok" then "OK" elif .validated=="error" then "ERRO" else "—" end)\t\(if .calibrated then "sim" else "não" end)\t\(if $s=="ok" or $s=="note" then "ok" elif $s=="bad" then "\(.sols.bad) ✗" elif $s=="partial" or $s=="stale" then "conferir" else "—" end)\t\(if .ready then "sim" elif .ready == false then "\((.pending // [])|length) pend." else "?" end)\t\((.review_reasons//[])|join(","))"' <<<"$j"
  } | { column -t -s$'\t' 2>/dev/null || cat; }
}
cmd_info(){ need_login; id_arg '' "$@"
  local id="$ID" d="${ID##*#}" r
  r="$(pkg_root)" && [[ "$(jq -r '.id//""' "$r/.moj-id" 2>/dev/null)" == "$id" ]] && d="$r"
  # cache: se há um CLONE LOCAL, mostra os metadados/contagens dele — sem consultar o servidor.
  if [[ -f "$d/.moj-id" && "$(jq -r '.id//""' "$d/.moj-id" 2>/dev/null)" == "$id" ]]; then
    jq -r '"id: \(.id)\ntítulo: \(.title//.prob)\npúblico: \(.public)  coleções: \((.collections//[])|join(", "))"' "$d/.moj-id"
    printf 'autor: %s\ntags: %s\n' "$(head -1 "$d/author" 2>/dev/null || echo —)" "$(paste -sd', ' "$d/tags" 2>/dev/null)"
    printf 'exemplos: %s  testes ocultos: %s\nsoluções: %s\n' \
      "$(find "$d/tests/input" -name 'sample*' 2>/dev/null | wc -l)" \
      "$(( $(find "$d/tests/input" -type f 2>/dev/null | wc -l) - $(find "$d/tests/input" -name 'sample*' 2>/dev/null | wc -l) ))" \
      "$(for c in good wrong slow pass upcoming; do n=$(ls "$d/sols/$c" 2>/dev/null | wc -l); ((n)) && printf '%s:%s ' "$c" "$n"; done)"
    echo "(do clone local $d — 'moj check $id' p/ a validação atual do servidor)"; return 0
  fi
  # sem clone: vai ao servidor — 2 GETs em PARALELO e com cache local (TTL 60s; repete = instantâneo).
  local gt st; gt="$(mktemp)"; st="$(mktemp)"
  api_get_cached 60 "/problems/get?id=$(enc "$id")"    > "$gt" 2>/dev/null &
  api_get_cached 60 "/problems/source?id=$(enc "$id")&tests=meta" > "$st" 2>/dev/null &
  wait
  jq -r '"id: \(.id)\ntítulo: \(.title//.prob)\nautor: \(.author//"—")\ndono: \(.owner//"—")\npúblico: \(.public)  coleções: \((.collections//[])|join(", "))\ntags: \((.tags//[])|join(", "))\nvalidação: \(if .validation==null then "—" elif .validation.ok then "APROVADO" else "REPROVADO" end)"' "$gt" 2>/dev/null
  jq -r '"exemplos: \(.examples|length)  testes ocultos: \(.tests|length)\nsoluções: " + ([.sols|to_entries[]|"\(.key):\(.value|length)"]|join(" · "))' "$st" 2>/dev/null || true
  rm -f "$gt" "$st"; }

cmd_new(){ need_login; [[ $# -ge 2 ]] || die "uso: moj new <org> <prob>   (prob = slug MINÚSCULO: [a-z0-9._-])"
  local repo="$1" prob="$2" d="$2"
  # as MESMAS regras do servidor (problems/create): pegar o slug inválido AQUI, não no push
  [[ "$repo" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$ ]] || die "org inválida: '$repo' (regra: [A-Za-z0-9._-], 2-64 chars)"
  if [[ ! "$prob" =~ ^[a-z0-9][a-z0-9._-]{1,80}$ ]]; then
    local sug; sug="$(printf '%s' "$prob" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9._-')"
    die "nome de problema inválido: '$prob' — o slug é MINÚSCULO ([a-z0-9._-], 2-81 chars).
  Sugestão: moj new $repo $sug"
  fi
  [[ -e "$d" ]] && die "já existe ./$d"
  local me; me="$(api GET "/auth/status?contest=$CONTEST" | jq -r '.name // .login // ""')"
  local tmpl; tmpl="$(jq -n --arg a "$me" '{title:"Título do Problema", author:$a, tags:["iniciante"], collections:[], public:false,
    enunciado_md:"Descreva o problema.\n\n## Entrada\n\nDescreva a entrada.\n\n## Saída\n\nDescreva a saída.\n\n## Observações\n\nRestrições e limites.\n",
    conf_text:"TLMOD[calibrafactor]=1.35\nULIMITS[-u]=10000\nALLOWPARALLELTEST=y\n",
    examples:[{input:"1 2\n",output:"3\n"}], tests:[], sols:{good:[{filename:"sol.py",code:"a,b=map(int,input().split())\nprint(a+b)\n"}],slow:[],wrong:[],pass:[],upcoming:[]}}')"
  json_to_pkg "$tmpl" "$d" "$repo#$prob"
  echo "criado ./$d  (id $repo#$prob).  edite com 'moj edit $d' ou os arquivos + 'moj push $d'."; }
cmd_clone(){ need_login; [[ $# -ge 1 ]] || die "uso: moj clone <id> [dir]"
  local id="$1" d="${2:-${1##*#}}"; [[ -e "$d" ]] && die "já existe ./$d"
  # o source vai p/ ARQUIVO: num problema grande são 100+ MB de JSON — em variável o bash copia tudo
  # e cada jq re-parseia o conjunto (e o .moj-id estourava o argv: "Argument list too long").
  local sf; sf="$(mktemp)"
  api_get_to_file "/problems/source?id=$(enc "$id")&tests=full" "$sf"
  json_to_pkg "$sf" "$d" "$id"
  pkg_base_save "$d"   # linha de base: o `moj pull` sabe o que VOCÊ mudou; o push manda o base_rev
  echo "clonado ./$d  (editable: $(jq -r '.editable // false' < "$sf"))"
  rm -f "$sf"; }

# conferência LOCAL do tests/score — espelha a semântica do juiz (mojtools/score-summary.sh):
# "#" = comentário; linha de grupo = '<glob>[, <glob>…] - <N> pontos'; teste casa o grupo por
# prefixo-sem-dígitos-finais, nome exato OU glob real. Mostra a distribuição e acusa ANTES de
# enviar o que quebraria no juiz (teste órfão ZERA a submissão; grupo peso>0 sem teste = Wrong).
score_gate(){ local d="$1" ok=1
  local pats=() wts=() bad="" nog="" _g _s _p _pl pn b gn hit gi n f
  local -A cnt=()
  shopt -s extglob
  while IFS='-' read -r _g _s || [[ -n "$_g" ]]; do
    [[ "$_g" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${_g//[[:space:]]/}" ]] && continue
    if [[ -z "${_s//[^0-9]/}" ]]; then bad+="'$_g' "; continue; fi
    _pl=""
    set -f; for _p in $_g; do _p="${_p%,}"; _pl+="${_pl:+ }$_p"; done; set +f
    pats+=("$_pl"); wts+=("${_s//[^0-9]/}")
  done < "$d/tests/score"
  for f in "$d/tests/input"/*; do
    [[ -e "$f" ]] || continue; b="${f##*/}"; gn="${b%%+([0-9])}"
    hit=""
    for gi in "${!pats[@]}"; do
      set -f
      for _p in ${pats[$gi]}; do
        pn="${_p%\**}"
        if [[ "$b" == "$pn" || "$gn" == "$pn" || "$b" == $_p ]]; then hit="$gi"; break 2; fi
      done
      set +f
    done
    set +f
    if [[ -n "$hit" ]]; then cnt[$hit]=$(( ${cnt[$hit]:-0} + 1 )); else nog+="$b "; fi
  done
  echo "  tests/score: ${#wts[@]} grupo(s)"
  for gi in "${!pats[@]}"; do
    n="${cnt[$gi]:-0}"
    printf '    %s - %s pontos: %s teste(s)\n' "${pats[$gi]}" "${wts[$gi]}" "$n"
    if [[ "$n" -eq 0 && "${wts[$gi]}" -gt 0 ]]; then echo "  ⚠ grupo de peso>0 sem NENHUM teste: '${pats[$gi]}'" >&2; ok=0; fi
  done
  [[ -n "$bad" ]] && { echo "  ⚠ linha inválida no tests/score (não é '<globs> - N pontos'; o juiz ignora): $bad" >&2; ok=0; }
  [[ -n "$nog" ]] && { echo "  ⚠ teste SEM grupo (ZERA a submissão no juiz): $nog" >&2; ok=0; }
  [[ $ok -eq 1 ]]; }
# sample_off <dir> — o conf declara SAMPLE=no: o problema NÃO tem exemplos (função, interativo,
# linguagem própria…). A MESMA regra do mojtools/statement-langs.sh (stmt_no_samples) e do editor web.
sample_off(){ local v; v="$(conf_get "$1" SAMPLE | tr 'A-Z' 'a-z' | tr -d '[:space:]')"
  [[ "$v" == no || "$v" == n || "$v" == nao || "$v" == não || "$v" == false || "$v" == 0 ]]; }
gate(){ local d="$1" ok=1
  [[ -s "$d/docs/enunciado.md" || -s "$d/enunciado.md" ]] || { echo "  ⚠ sem enunciado" >&2; ok=0; }
  # EXEMPLOS: sample* OU SAMPLE=no no conf (a mesma exigência da validação no servidor). Teste
  # oculto nunca vira exemplo — sem nenhum dos dois o enunciado sairia sem exemplo por engano.
  if sample_off "$d"; then
    echo "  (SAMPLE=no: sem caixa de exemplo no enunciado — o exemplo vai no texto)"
  elif [[ "$(find "$d/tests/input" -maxdepth 1 -name 'sample*' 2>/dev/null | wc -l)" -lt 1 ]]; then
    echo "  ⚠ sem exemplos: crie tests/input/sample1 e tests/output/sample1, ou, se exemplo não faz" >&2
    echo "    sentido neste problema (função, interativo…), ponha SAMPLE=no no conf (moj edit → 8 → 6)" >&2
    ok=0
  fi
  find "$d/sols/good" -maxdepth 1 -type f 2>/dev/null | grep -q . || { echo "  ⚠ sem solução em sols/good/" >&2; ok=0; }
  if [[ -f "$d/tests/score" ]]; then score_gate "$d" || ok=0; fi
  [[ $ok -eq 1 ]]; }
# moj test [dir] [--run [sol]] — pré-voo estático; com --run, JULGA localmente delegando ao
# mojtools/build-and-test.sh (exige checkout do mojtools + Linux com bwrap REAL; no macOS não
# há sandbox — use 'moj publish/calibrate' + 'moj check', o juiz valida).
cmd_test(){ local d="." run=0 sol="" a
  for a in "$@"; do case "$a" in
    --run) run=1;;
    --*) die "opção desconhecida: $a (uso: moj test [dir] [--run [sol]])";;
    *) if [[ -d "$a" ]]; then d="$a"; elif [[ -f "$a" ]]; then sol="$a"; else die "não achei '$a' (dir do pacote ou arquivo de solução)"; fi;;
  esac; done
  [[ "$d" == . && ! -f ./.moj-id ]] && { d="$(pkg_root)" || d=.; }   # de uma subpasta: a pasta do problema
  if gate "$d"; then echo "ok: pré-voo passou (enunciado, $(sample_off "$d" && echo 'SAMPLE=no' || echo 'exemplos') e solução good presentes)."
  else [[ $run -eq 1 ]] || return 1; echo "  (seguindo p/ o --run mesmo assim)"; fi
  [[ $run -eq 1 ]] || return 0
  local mt; mt="$(mojtools_dir)"
  have bwrap || die "julgamento local exige bwrap (Linux). No macOS/sem sandbox: 'moj publish' ou 'moj calibrate' + 'moj check' — o juiz valida por você."
  bwrap --version 2>&1 | grep -qi fbwrap && die "o bwrap daqui é o fbwrap (no-op do firejail) — sem sandbox real não dá p/ julgar localmente; use 'moj calibrate' + 'moj check'."
  # TL de referência: sem tl calibrado no pacote, cria um transitório (CALIBRATIONTL ou 5s)
  local tltmp=0 ctl=""
  if [[ ! -f "$d/tl" ]]; then
    ctl="$(conf_get "$d" CALIBRATIONTL)"; [[ "$ctl" =~ ^[0-9.]+$ ]] || ctl=5
    printf 'TL[default]=%s\n' "$ctl" > "$d/tl"; tltmp=1
  fi
  local sols=() s lang v rc=0
  if [[ -n "$sol" ]]; then sols=("$sol"); else shopt -s nullglob; sols=("$d"/sols/good/*); shopt -u nullglob; fi
  if [[ ${#sols[@]} -eq 0 ]]; then [[ $tltmp -eq 1 ]] && rm -f "$d/tl"; die "nada p/ julgar (sols/good vazio)"; fi
  echo "julgando localmente (mojtools: $mt$( ((tltmp)) && echo "; TL transitório ${ctl}s" ))…"
  # contrato do build-and-test.sh (o mesmo que o calibreitor usa): stdout = workdir na 1ª linha
  # + FINALRESP na última; o stderr real vai p/ <workdir>/run-trace.log (exec 2>), com uma linha
  # "EXECTIME <teste> <tempo> <veredicto>" por teste — é daí que saem os tempos abaixo.
  local outf errf wdir times tlused sabs dabs
  outf="$(mktemp)"; errf="$(mktemp)"
  dabs="$(_abspath "$d")"
  for s in "${sols[@]}"; do
    lang="${s##*.}"
    # resolver ANTES do subshell: "$(_abspath …)" dentro de `( cd "$mt" && … )` expande DEPOIS
    # do cd — caminho relativo resolvia contra o mojtools e virava "/sol.c" (CE em tudo)
    sabs="$(_abspath "$s")"
    ( cd "$mt" && bash build-and-test.sh "$lang" "$sabs" "$dabs" y ) >"$outf" 2>"$errf" || true
    wdir="$(head -n1 "$outf")"; v="$(tail -n1 "$outf")"
    [[ "$v" == "$wdir" ]] && v=""                       # stdout de 1 linha = morreu sem veredicto
    printf '  %s -> %s\n' "$(basename "$s")" "${v:-?}"
    if [[ -d "$wdir" && -f "$wdir/run-trace.log" ]]; then
      # LC_ALL=C obrigatório: na máquina do USUÁRIO o awk (mawk no Ubuntu) honra o locale —
      # sob pt_BR, "0.21"+0 vira 0 (strtod espera vírgula) e %.2f imprime vírgula ("pior 0,00s")
      times="$(LC_ALL=C awk '$1=="EXECTIME"{n++; printf " %s%s",$3,($4=="AC"?"":"("$4")"); if($3+0>w)w=$3+0}
                    END{if(n)printf "\n    %d teste(s), pior %.2fs",n,w}' "$wdir/run-trace.log")"
      tlused="$(grep -m1 '^TL_LANG=' "$wdir/report.env" 2>/dev/null | cut -d= -f2- | tr -d "'\"")"
      [[ -n "$times" ]] && printf '    tempos%s:%s\n' "${tlused:+ (TL ${tlused}s)}" "$times"
      [[ -s "$wdir/report.html" ]] && printf '    relatório: %s\n' "$wdir/report.html"
    fi
    if [[ -z "$v" ]]; then   # julgamento mudo = ambiente quebrado, não engolir o porquê
      { echo "  ⚠ o julgamento morreu antes do veredicto — fim do run-trace:"
        { tail -n 6 "$wdir/run-trace.log" 2>/dev/null || tail -n 6 "$errf"; } | sed 's/^/    | /'
        echo "  (diagnóstico do ambiente: $MOJ_TOOL doctor)"; } >&2
      rc=1
    fi
    if [[ "$s" == */sols/good/* && ! "$v" =~ ^Accepted ]]; then rc=1; fi
  done
  rm -f "$outf" "$errf"
  [[ $tltmp -eq 1 ]] && rm -f "$d/tl"
  return $rc; }
# ---- diagnóstico (version/update/_server_build vêm da lib/core.sh — comuns às camadas) ----
cmd_doctor(){ local bad=0 srv mt="" c head
  echo "$MOJ_TOOL doctor — diagnóstico do ambiente"
  echo "· build local: $MOJ_CLI_BUILD"
  srv="$(_server_build)"
  if [[ -n "$srv" ]]; then
    if [[ "$MOJ_CLI_BUILD" != dev && "$MOJ_CLI_BUILD" != "$srv" ]]; then
      echo "✗ DESATUALIZADO: o servidor serve o build $srv — rode: $MOJ_TOOL update"; bad=1
    else echo "✓ servidor $MOJ_URL: build $srv"; fi
  else echo "· servidor $MOJ_URL: /moj.build indisponível (não deu p/ conferir atualização)"; fi
  have jq   || { echo "✗ jq AUSENTE — a CLI inteira depende dele (instale jq)"; bad=1; }
  have curl || { echo "✗ curl AUSENTE"; bad=1; }
  echo "· bash $BASH_VERSION · jq $(jq --version 2>/dev/null || echo '—') · curl $(curl --version 2>/dev/null | head -1 | awk '{print $2}')"
  # mojtools (só p/ checker/interactive/fn/test --run): qual candidato responde?
  if [[ -n "${MOJTOOLS_DIR:-}" && ! -f "${MOJTOOLS_DIR}/build-and-test.sh" ]]; then
    echo "✗ MOJTOOLS_DIR aponta p/ caminho inválido: $MOJTOOLS_DIR (sem build-and-test.sh)"; bad=1
  fi
  for c in "${MOJTOOLS_DIR:-}" "$(dirname "$(_abspath "${BASH_SOURCE[0]}")")/../mojtools" "$HOME/moj/mojtools"; do
    [[ -n "$c" && -f "$c/build-and-test.sh" ]] && { mt="$(_abspath "$c")"; break; }
  done
  if [[ -n "$mt" ]]; then
    echo "✓ mojtools: $mt$([[ -n "${MOJTOOLS_DIR:-}" && "$mt" == "$(_abspath "$MOJTOOLS_DIR")" ]] && echo ' (via MOJTOOLS_DIR)')"
    head="$(git -C "$mt" log -1 --format='%h de %cs' 2>/dev/null || true)"
    [[ -n "$head" ]] && echo "  · versão local: $head — atualize com: git -C '$mt' pull"
  else
    echo "· mojtools não encontrado (procurei: \$MOJTOOLS_DIR, ../mojtools do script, ~/moj/mojtools)"
    echo "  só é necessário p/ 'moj checker', 'moj interactive', 'moj fn' e 'moj test --run'. Para instalar:"
    echo "  git clone https://github.com/cd-moj/mojtools ~/moj/mojtools   (ou exporte MOJTOOLS_DIR)"
  fi
  # bwrap (só p/ test --run)
  if ! have bwrap; then
    echo "· bwrap ausente — 'moj test --run' (julgamento local) NÃO funciona aqui; use 'moj calibrate' + 'moj check' (o juiz valida)"
  elif bwrap --version 2>&1 | grep -qi fbwrap; then
    echo "· bwrap = fbwrap (no-op) — sem sandbox real; 'moj test --run' recusa; use 'moj calibrate' + 'moj check'"
  else
    echo "✓ bwrap real ($(bwrap --version 2>/dev/null)) — 'moj test --run' disponível"
  fi
  if [[ -f "$(token_file)" ]]; then echo "✓ sessão: logado ($CONTEST em $MOJ_URL)"; else echo "· sessão: sem login (rode: $MOJ_TOOL login)"; fi
  if (( bad == 0 )); then echo "tudo certo."; else echo "há itens ✗ acima."; fi
  return $bad; }
# atalhos p/ os instaladores do mojtools (autoria local; requerem checkout do mojtools)
cmd_checker(){ [[ $# -ge 2 ]] || die "uso: moj checker <dir> <checker.cpp> [--force]   (checker testlib; COMPÕE com moj fn — ver docs/correcao-especial.md)"
  local mt; mt="$(mojtools_dir)"
  bash "$mt/testlib/install-checker.sh" "$@"
  echo "dica: 'moj push $1' já envia scripts/ (round-trip); 'moj test $1 --run' julga local."; }
cmd_fn(){ [[ $# -ge 1 ]] || die "uso: moj fn <dir> [--langs c,cpp,py,java,rs] [--force]   (drivers de submissão de função; COMPÕE com moj checker — ver docs/submissao-de-funcao.md)"
  local mt; mt="$(mojtools_dir)"
  bash "$mt/fn/install-fn.sh" "$@"
  echo "dica: 'moj push $1' já envia scripts/ (round-trip); edite os EDIT-ME antes."; }
cmd_interactive(){ [[ $# -ge 2 ]] || die "uso: moj interactive <dir> <arbitro.cpp|.py|.sh> [--score] [--langs \"...\"]   (ver mojtools/docs/problema-interativo.md)"
  local mt; mt="$(mojtools_dir)"; local d="$1" arb="$2"; shift 2
  bash "$mt/interactive/install-interactive.sh" "$d" "$arb" "$@"
  echo "dica: 'moj push $d' já envia scripts/ (round-trip)."; }
# moj push [dir] [--force] [--overwrite] — envia a pasta. A pasta é achada como o git acha o .git (a
# atual ou uma acima com .moj-id). TRAVA: manda o base_rev do .moj-id; se o problema mudou no servidor
# depois do seu último clone/pull/push, o servidor recusa (409) e nada é gravado. --overwrite envia por
# cima assim mesmo. (--force continua sendo só "pule o pré-voo e o título" — não passa pela trava.)
cmd_push(){ need_login
  local force=0 ow=false d="" a; for a in "$@"; do case "$a" in --force) force=1;; --overwrite) ow=true;; --*) die "opção desconhecida: $a (uso: moj push [dir] [--force] [--overwrite])";; *) d="$a";; esac; done
  d="$(pkg_root "${d:-.}")" || die "rode dentro da pasta de um problema (a que tem o .moj-id) ou passe a pasta. Para começar: 'moj new' ou 'moj clone'."
  local base; base="$(jq -r '.base_rev // ""' "$d/.moj-id")"
  local id repo prob; id="$(jq -r .id "$d/.moj-id")"; repo="$(jq -r .repo "$d/.moj-id")"; prob="$(jq -r .prob "$d/.moj-id")"
  # id/repo/prob são a IDENTIDADE do problema no servidor — editar à mão quebra o push de um jeito
  # confuso ("Problema não existe") e, se id E prob mudassem juntos, o push CRIARIA UM DUPLICADO em
  # silêncio. O que se edita p/ mudar o nome exibido é o campo .title.
  [[ "$id" == "$repo#$prob" ]] || die "o .moj-id está inconsistente: id='$id' mas repo='$repo' e prob='$prob'.
  O id é a IDENTIDADE do problema (não edite id/repo/prob à mão).
  Para mudar o TÍTULO exibido, edite o campo \"title\" do .moj-id; para mudar de org, use 'moj mv'."
  # slug com as MESMAS regras do servidor: um prob com MAIÚSCULA/char inválido morre no
  # /problems/create com 400 — e o fallback antigo ainda mascarava isso de "Problema não
  # existe (404)". Como o servidor nunca aceitou um slug assim, o problema não existe lá:
  # ajustar o .moj-id é seguro.
  if [[ ! "$prob" =~ ^[a-z0-9][a-z0-9._-]{1,80}$ ]]; then
    local sug; sug="$(printf '%s' "$prob" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9._-')"
    die "nome de problema inválido: '$prob' — o slug é MINÚSCULO ([a-z0-9._-], 2-81 chars).
  Este problema ainda não existe no servidor (slug assim nunca é aceito), então é SEGURO
  corrigir: edite $d/.moj-id trocando \"id\" p/ \"$repo#$sug\" e \"prob\" p/ \"$sug\",
  e rode 'moj push $d' de novo."
  fi
  # TÍTULO obrigatório: sem ele o problema sai com o nome da pasta (o servidor deriva o slug).
  local title; title="$(jq -r '.title // ""' "$d/.moj-id")"
  if [[ -z "$title" || "$title" == "Título do Problema" ]]; then
    [[ $force -eq 1 ]] || die "defina o TÍTULO antes de enviar — senão o problema fica com o nome da pasta ('$prob'). Use 'moj edit $id' (opção 1) ou edite o .title em .moj-id. (--force envia assim mesmo)"
    echo "  ⚠ sem título — vai usar o nome da pasta ('$prob')."
  fi
  if ! gate "$d"; then [[ $force -eq 1 ]] || die "pré-voo falhou (use --force só p/ rascunho privado)."; echo "  (--force: subindo mesmo assim)"; fi
  # corpo via ARQUIVO (testes grandes estouram o argv do jq/curl): pkg_to_json escreve, jq injeta
  # id/repo lendo o arquivo, e o POST vai por api_post_file (--data-binary @arquivo).
  local bf bf2 resp; bf="$(mktemp)"; bf2="$(mktemp)"
  pkg_to_json "$d" > "$bf"
  # PRÉ-VOO BARATO: /problems/get devolve METADADOS. O /problems/source (o de antes) fazia o servidor
  # SERIALIZAR O PACOTE INTEIRO (~100 MB num pacote grande) só p/ jogar fora — dobrava o custo do push
  # e, quando ELE estourava o tempo-limite, o push caía no ramo `create` e tomava 409.
  # E o POST vai FORA DE PIPE: no pipe, o `die` matava só o subshell e o push falhava com rc=0.
  # a TRAVA vai no corpo: base_rev (o que você tinha) ou force (--overwrite). Sem base_rev (pasta de
  # antes desta versão) o servidor se comporta como sempre: grava por cima.
  local lockf='. + (if $ow then {force:true} elif $b != "" then {base_rev:$b} else {} end)'
  if [[ "$(http_code GET "/problems/get?id=$(enc "$id")")" == 2* ]]; then
    jq -c --arg id "$id" --arg b "$base" --argjson ow "$ow" ". + {id:\$id} | $lockf" "$bf" > "$bf2"
    resp="$(_post_rev "/problems/edit" "$bf2" "moj push --overwrite")" || { rm -f "$bf" "$bf2"; exit 1; }
    jq -r '"enviado (edit): \(.id)  sha \(.sha)"' <<<"$resp"
    _base_after_send "$d" "$resp"
  else
    api POST "/problems/repo-create" "$(jq -n --arg r "$repo" '{repo:$r}')" >/dev/null 2>&1 || true
    jq -c --arg r "$repo" --arg p "$prob" '. + {repo:$r,prob:$p}' "$bf" > "$bf2"
    # resposta via ARQUIVO, não $(…): o command substitution roda num SUBSHELL e
    # API_LAST_CODE/API_LAST_BODY não chegariam ao elif/else abaixo
    local rf; rf="$(mktemp)"
    if API_SOFT=1 api_post_file "/problems/create" "$bf2" > "$rf" 2>/dev/null; then
      jq -r '"enviado (novo): \(.id)  sha \(.sha)"' < "$rf"; _base_after_send "$d" "$(cat "$rf")"; rm -f "$rf"
    elif [[ "${API_LAST_CODE:-}" == 409 ]]; then
      rm -f "$rf"
      # 409 "já existe" (índice ainda não enxergou o problema): reenvia como EDIT em vez de morrer
      jq -c --arg id "$id" --arg b "$base" --argjson ow "$ow" ". + {id:\$id} | $lockf" "$bf" > "$bf2"
      resp="$(_post_rev "/problems/edit" "$bf2" "moj push --overwrite")" || { rm -f "$bf" "$bf2"; exit 1; }
      jq -r '"enviado (edit): \(.id)  sha \(.sha)"' <<<"$resp"
      _base_after_send "$d" "$resp"
    else
      # erro REAL do create (400/403/…): mostrar a mensagem do SERVIDOR. O fallback cego p/
      # o edit trocava "Nome de problema inválido" por um "Problema não existe (404)" sem pé
      # nem cabeça (caso Edson, 2026-08-06). Só o 409 justifica reenviar como edit.
      local emsg; emsg="$(jq -r '.error.message // .message // empty' <<<"${API_LAST_BODY:-}" 2>/dev/null)"
      rm -f "$bf" "$bf2" "$rf"
      die "criar '$id' falhou${API_LAST_CODE:+ (HTTP $API_LAST_CODE)}: ${emsg:-erro do servidor sem mensagem}"
    fi
  fi
  rm -f "$bf" "$bf2"; echo "publique com 'moj publish $id' quando estiver pronto."; }

cmd_rm(){ need_login; [[ $# -ge 1 ]] || die "uso: moj rm <id>   (remove o problema da base e do treino)"
  local id="$1" c=""
  echo "⚠ Isto REMOVE o problema '$id' — o repositório e o índice do treino. Destrutivo."
  read -rp "Para confirmar, repita o id ($id): " c </dev/tty || true
  [[ "$c" == "$id" ]] || die "confirmação não bateu — nada foi removido."
  api POST "/problems/delete" "$(jq -n --arg id "$id" '{id:$id, confirm:$id}')" | jq -r '"removido: \(.id)"'; }
cmd_download(){ need_login; id_arg '\.(tar\.gz|tgz|tar)$' "$@"; shift "$IDSHIFT"
  local id="$ID"
  local out="" sha="" a
  while [[ $# -gt 0 ]]; do a="$1"; shift
    case "$a" in --sha) sha="${1:?}"; shift;; -*) die "opção desconhecida: $a";; *) out="$a";; esac
  done
  if [[ -n "$sha" ]]; then
    [[ "$sha" =~ ^[0-9a-f]{7,40}$ ]] || die "sha inválido (hex 7-40)"
    [[ -n "$out" ]] || out="${id##*#}-${sha:0:7}.tar.gz"
    api_get_to_file "/problems/download?id=$(enc "$id")&sha=$sha" "$out"
  else
    [[ -n "$out" ]] || out="${id##*#}.tar.gz"
    api_get_to_file "/problems/download?id=$(enc "$id")" "$out"
  fi
  echo "baixado: $out"; }

# histórico git do problema: lista (sha, data, autor, assunto, ±stats) ou o diff -p de um commit
cmd_log(){ need_login; id_arg '^[0-9a-f]{7,40}$' "$@"; shift "$IDSHIFT"
  local id="$ID"
  local n=30 sha="" a
  while [[ $# -gt 0 ]]; do a="$1"; shift
    case "$a" in -n) n="${1:?}"; shift;; -*) die "opção desconhecida: $a";; *) sha="$a";; esac
  done
  if [[ -n "$sha" ]]; then
    [[ "$sha" =~ ^[0-9a-f]{7,40}$ ]] || die "sha inválido (hex 7-40)"
    local j; j="$(api GET "/problems/history?id=$(enc "$id")&sha=$sha")"
    [[ "$RAW" == 1 ]] && { printf '%s\n' "$j"; return; }
    jq -r '"commit \(.sha)\nautor:  \(.author)\ndata:   \(.at|strftime("%Y-%m-%d %H:%M UTC"))\n"' <<<"$j"
    jq -r '.diff_b64' <<<"$j" | _b64dec
    [[ "$(jq -r '.truncated' <<<"$j")" == true ]] && echo "… (diff truncado em 400 KB)"
    return 0
  fi
  api GET "/problems/history?id=$(enc "$id")&limit=$n" | { [[ "$RAW" == 1 ]] && cat || jq -r '
    .commits[] | [ (.sha[0:7]), (.at|strftime("%Y-%m-%d %H:%M")), .author,
                   (.subject[0:60]), "\(.files)a +\(.insertions) −\(.deletions)" ] | @tsv' \
    | column -t -s$'\t'; }; }

# restaura versão antiga como um COMMIT NOVO (história preservada; meta/público intactos)
cmd_restore(){ need_login; id_arg '^[0-9a-f]{7,40}$' "$@"; shift "$IDSHIFT"
  [[ $# -ge 1 ]] || die "uso: moj restore [<id>] <sha>   (veja os sha com 'moj log')"
  local id="$ID" sha="$1" c=""
  [[ "$sha" =~ ^[0-9a-f]{7,40}$ ]] || die "sha inválido (hex 7-40)"
  echo "⚠ Isto restaura '$id' ao estado do commit $sha como um commit NOVO."
  echo "  (a história não é reescrita; público/coleções atuais são preservados)"
  read -rp "Para confirmar, repita o sha ($sha): " c </dev/tty || true
  [[ "$c" == "$sha" ]] || die "confirmação não bateu — nada foi restaurado."
  api POST "/problems/restore" "$(jq -n --arg id "$id" --arg s "$sha" '{id:$id, sha:$s, confirm:$s}')" \
    | out '"restaurado: \(.id) <- \(.from[0:7])  (novo commit \(.sha))"'; }
# _tar_meta_json <arquivo> -> conteúdo do .moj-meta.json dentro do pacote (best-effort; {} se ausente)
_tar_meta_json(){ local a="$1" d m; d="$(mktemp -d)"
  if [[ "$(head -c2 "$a" 2>/dev/null)" == "PK" ]]; then
    have unzip && unzip -qq -o "$a" '*.moj-meta.json' -d "$d" >/dev/null 2>&1 || true
  else
    # GNU tar precisa de --wildcards p/ glob; BSD tar faz glob por default (e rejeita a flag)
    tar -xf "$a" -C "$d" --wildcards '*.moj-meta.json' >/dev/null 2>&1 \
      || tar -xf "$a" -C "$d" '*.moj-meta.json' >/dev/null 2>&1 || true
  fi
  m="$(find "$d" -name '.moj-meta.json' 2>/dev/null | head -1 || true)"
  { [[ -n "$m" ]] && cat "$m" 2>/dev/null; } || echo '{}'
  rm -rf "$d"; }
cmd_upload(){ need_login
  local force=0 ow=false args=() a
  for a in "$@"; do case "$a" in --force) force=1;; --overwrite) ow=true;; --*) die "opção desconhecida: $a";; *) args+=("$a");; esac; done
  # sem <id>: o da pasta do problema. Um argumento só que EXISTE no disco é a origem (pasta ou arquivo)
  local id src r=""; r="$(pkg_root)" || r=""
  case "${#args[@]}" in
    0) id="$(resolve_id)" || exit 1; src="$r";;
    1) if [[ -f "${args[0]}/.moj-id" ]]; then src="${args[0]}"; id="$(resolve_id "$src")" || exit 1
       elif [[ -e "${args[0]}" ]]; then src="${args[0]}"; id="$(resolve_id)" || exit 1
       else id="$(resolve_id "${args[0]}")" || exit 1; src="${r:-.}"; fi;;
    2) id="$(resolve_id "${args[0]}")" || exit 1; src="${args[1]}";;
    *) die "uso: moj upload [<id>] [dir|arquivo.(tar.gz|tar.bz2|tar.zst|zip)] [--force] [--overwrite]   (dir/omitido = empacota sozinho)";;
  esac
  local tarball tmptar="" base="" srcpkg=""
  # a TRAVA só vale quando a origem é a pasta clonada DESTE problema (é ela que tem a linha de base)
  if [[ -d "$src" && -f "$src/.moj-id" && "$(jq -r '.id // ""' "$src/.moj-id" 2>/dev/null)" == "$id" ]]; then
    srcpkg="$src"; base="$(jq -r '.base_rev // ""' "$src/.moj-id")"
  fi
  if [[ -d "$src" ]]; then
    [[ -f "$src/conf" || -d "$src/tests" ]] || die "'$src' não parece um pacote MOJ (sem conf/tests)"
    tmptar="$(mktemp)"; tarball="$tmptar"
    # o .moj-id (ponteiro local) NÃO sobe — mas título/coleções/LANGUAGES dele SOBEM, num
    # .moj-meta.json sintetizado anexado por ÚLTIMO ao tar (membro posterior vence na extração
    # do servidor). Sem isto, upload de um pacote clonado zerava a whitelist de linguagens.
    local tx metad=""
    tx=(--exclude='./.git' --exclude='./.moj-id' --exclude='./.moj-base' --exclude='./.moj-base.tmp' \
        --exclude='./.arbitro-cache' --exclude='./.checker-cache' --exclude='./.pre-normalizacao*')
    if [[ -f "$src/.moj-id" ]]; then
      local basemeta='{}'
      [[ -f "$src/.moj-meta.json" ]] && jq -e . "$src/.moj-meta.json" >/dev/null 2>&1 && basemeta="$(cat "$src/.moj-meta.json")"
      metad="$(mktemp -d)"
      jq -s '(.[0]) + ((.[1] // {}) as $mid
             | {collections:($mid.collections // []), languages:($mid.languages // [])}
             + (if ($mid.title // "") != "" then {display_title:$mid.title} else {} end)
             + (if (($mid.titles // {})|length) > 0 then {titles:$mid.titles} else {} end))' \
        <(printf '%s' "$basemeta") "$src/.moj-id" > "$metad/.moj-meta.json" \
        || die "não consegui sintetizar o .moj-meta.json a partir do .moj-id (JSON inválido?)"
    fi
    if [[ -n "$metad" ]]; then
      tar -czf "$tarball" "${tx[@]}" -C "$src" . -C "$metad" ./.moj-meta.json
    else
      tar -czf "$tarball" "${tx[@]}" -C "$src" .
    fi
    rm -rf ${metad:+"$metad"}
    echo "empacotado: $src -> $(du -h "$tarball" 2>/dev/null | cut -f1 || echo '?')"
  elif [[ -f "$src" ]]; then tarball="$src"
  else die "arquivo/diretório não encontrado: $src"; fi
  local meta; meta="$(_tar_meta_json "$tarball")"
  # TÍTULO obrigatório no pacote (senão o problema sai com o nome da pasta):
  local mt; mt="$(jq -r '.display_title // ""' <<<"$meta" 2>/dev/null)"
  if [[ -z "$mt" ]]; then
    [[ $force -eq 1 || "${MOJ_ALLOW_NO_TITLE:-}" == 1 ]] || die "o pacote não tem 'display_title' no .moj-meta.json — o problema sairia com o nome da pasta. Inclua o campo (ou --force p/ enviar assim)."
    echo "  ⚠ sem display_title no pacote — o servidor vai derivar do enunciado/pasta."
  fi
  # `public` do tar é IGNORADO pelo servidor (campo de ACESSO — só o /problems/set-public o
  # muda; upload nem publica nem despublica). O aviso antigo de "DESPUBLICA" era de antes do
  # servidor proteger o meta (cdmoj 7bbe17a) e ficou obsoleto — removido.
  local bf b64; bf="$(mktemp)"; b64="$(mktemp)"; _b64enc "$tarball" > "$b64"
  jq -n --arg id "$id" --rawfile t "$b64" --arg b "$base" --argjson ow "$ow" \
    '{id:$id,tar_b64:$t} + (if $ow then {force:true} elif $b != "" then {base_rev:$b} else {} end)' > "$bf"
  local resp; resp="$(_post_rev "/problems/upload" "$bf" "moj upload --overwrite")" || { rm -f "$bf" "$b64" ${tmptar:+"$tmptar"}; exit 1; }
  jq -r '"enviado: \(.id)  sha \(.sha)"' <<<"$resp"
  [[ -n "$srcpkg" ]] && _base_after_send "$srcpkg" "$resp"
  rm -f "$bf" "$b64" ${tmptar:+"$tmptar"}; }
cmd_export(){ need_login; id_arg '\.(tar\.gz|tgz)$' "$@"; shift "$IDSHIFT"
  local id="$ID" out="${1:-${ID##*#}.icpc.tar.gz}"
  api_get_to_file "/problems/export?id=$(enc "$id")" "$out"; echo "exportado (ICPC/Kattis): $out"; }
cmd_import(){ need_login; [[ $# -ge 2 ]] || die "uso: moj import <pacote.(tar.gz|zip)> <pasta> [prob]   (ICPC/Kattis -> MOJ)"
  [[ -f "$1" ]] || die "arquivo não encontrado: $1"
  local bf b64; bf="$(mktemp)"; b64="$(mktemp)"; _b64enc "$1" > "$b64"
  jq -n --arg r "$2" --arg p "${3:-}" --rawfile t "$b64" '{repo:$r, prob:(if $p=="" then null else $p end), tar_b64:$t}' > "$bf"
  api_post_file "/problems/import" "$bf" | jq -r '"importado: \(.id)  sha \(.sha)"'; rm -f "$bf" "$b64"; }
cmd_preview(){ need_login; local d="." lang=pt
  while [[ $# -gt 0 ]]; do case "$1" in --lang) lang="${2:-}"; shift 2;; *) d="$1"; shift;; esac; done
  [[ "$d" == . && ! -f ./.moj-id ]] && { d="$(pkg_root)" || d=.; }   # de uma subpasta: a pasta do problema
  [[ -f "$d/.moj-id" || -d "$d/docs" ]] || die "rode dentro de um problema."
  [[ "$lang" =~ ^(pt|en|es)$ ]] || die "--lang aceita pt, en ou es"
  [[ "$lang" == pt || -f "$d/docs/enunciado.$lang.md" ]] || die "sem docs/enunciado.$lang.md — crie a tradução antes (moj edit → t)."
  # imagens locais de docs/ vão JUNTO (campo images) — o preview do servidor as embute; sem
  # isso, `![](fig.png)` sumia SÓ no preview (o render servido sempre embutiu)
  local t; t="$(mktemp -d)"
  _docs_nd "$d" "$t/imgs" 2>/dev/null
  # --lang: o texto e o título da tradução, e a explicação traduzida de cada exemplo (sem ela, a PT)
  # SAMPLE=no: o servido não tem exemplos, e o preview mostra o que o aluno vai ver
  local noex=false; sample_off "$d" && noex=true
  local body; body="$(jq -c --slurpfile im "$t/imgs" --arg l "$lang" --argjson noex "$noex" \
      --arg pid "$([[ -f "$d/.moj-id" ]] && jq -r '.id//""' "$d/.moj-id" || echo '')" \
      '(if $l == "pt" then {title, enunciado_md, enunciado_format, examples}
        else (.translations[$l] // {}) as $tr
          | {title:(if ($tr.title // "") != "" then $tr.title else .title end), enunciado_md:($tr.enunciado_md // ""), enunciado_format:"md",
             examples:(.examples | map(. + (if (($tr.notes // {})[.name] // "") != "" then {explanation:$tr.notes[.name]} else {} end)))} end)
       + {lang:$l}
       + (if $noex then {examples:[]} else {} end)
       + (if ($im|length) > 0 then {images:$im} else {} end)
       + (if $pid != "" then {id:$pid} else {} end)' <<<"$(pkg_to_json "$d")")"
  local out; out="$(mktemp)"; mv "$out" "$out.html"; out="$out.html"   # sem mktemp --suffix (BSD não tem)
  api POST "/problems/preview" "$body" | jq -r '.html_b64' | _b64dec > "$out"
  rm -rf "$t"
  echo "preview: $out"; have xdg-open && (xdg-open "$out" >/dev/null 2>&1 &) || true; }

# _retag_wait <jobid> — acompanha o job de retag (rename/delete rodam em BACKGROUND no servidor)
# até terminar. Ctrl-C é seguro (o job segue no servidor); 10 min sem terminar vira dica de consulta.
_retag_wait(){ local jid="$1" j dn tt fl fin extra deadline=$((SECONDS+600))
  [[ -n "$jid" ]] || return 0
  while (( SECONDS < deadline )); do
    sleep 2
    j="$(api GET "/problems/collection-retag-status?job=$(enc "$jid")" 2>/dev/null | jq -c '.jobs[0] // empty' 2>/dev/null)" || j=""
    [[ -n "$j" ]] || continue
    dn="$(jq -r '.done // 0' <<<"$j")"; tt="$(jq -r '.total // "?"' <<<"$j")"
    fl="$(jq -r '.failed // 0' <<<"$j")"; fin="$(jq -r '.finished_at // empty' <<<"$j")"
    extra=""; [[ "$fl" != 0 ]] && extra="  ⚠ falhas: $fl"
    printf '\r  re-tag: %s/%s%s   ' "$dn" "$tt" "$extra"
    if [[ -n "$fin" ]]; then
      printf '\r  re-tag concluído: %s problema(s)%s          \n' "$dn" "$extra"
      [[ "$fl" != 0 ]] && echo "  ⚠ houve falhas — repita o comando (o retag é retomável) e confira com moj collection show"
      return 0
    fi
  done
  printf '\n  (ainda rodando — acompanhe com: moj collection status %s)\n' "$jid"; return 0; }

# _coll_sync_local <id> <rev-antes> <coleções-novas> — `moj collection add/remove` de dentro da pasta do
# problema: coleção muda o rev do servidor (o push manda as coleções), então a pasta acompanha — senão o
# próximo push seria recusado pela sua própria mudança. Só quando a linha de base da pasta ERA o servidor
# de antes da operação; pasta atrás do servidor ganha a dica do pull.
_coll_sync_local(){ local id="$1" pre="$2" cols="$3" r base had now
  r="$(pkg_root)" || return 0
  [[ "$(jq -r '.id // ""' "$r/.moj-id" 2>/dev/null)" == "$id" ]] || return 0
  base="$(jq -r '.base_rev // ""' "$r/.moj-id")"
  if [[ -z "$pre" || "$base" != "$pre" ]]; then
    echo "  (a pasta $r está atrás do servidor: rode 'moj pull' para trazer esta e as outras mudanças)"; return 0
  fi
  had="$(pkg_changes "$r")"
  now="$(api GET "/problems/get?id=$(enc "$id")" | jq -r '.rev // ""')" || return 0
  mid_set "$r" --argjson c "$cols" --arg v "$now" '.collections=$c | .base_rev=$v'
  [[ -n "$had" ]] || pkg_base_save "$r"      # sem mudança sua na pasta: ela é a versão do servidor de novo
  return 0; }
# COLEÇÃO = TAG de agrupamento (m:n), curada (registro com dono). ORTOGONAL à ORG (acesso). O nome
# pode ter ESPAÇOS. Marcar um problema numa coleção exige que ela EXISTA (crie antes).
# ISSUES POR PROBLEMA (/problems/issues): a revisão interna da banca. Issue aberta tira o problema de
# "pronto" (moj check / moj board). Só quem edita o problema vê e mexe. O texto vem de -m "…" ou de
# -F <arquivo> (-F - = stdin, como no git). O stdin NUNCA é lido sem -F -: num script ele pode ser um
# pipe que nunca fecha, e o close/reopen (texto opcional) ficaria esperando para sempre.
#   moj issues [<id>]                         lista (abertas primeiro; --all mostra as fechadas)
#   moj issues show [<id>] <n>                uma issue com os comentários
#   moj issues new [<id>] "<título>" [-m <texto> | -F <arquivo>]
#   moj issues comment|close|reopen [<id>] <n> [-m <texto> | -F <arquivo>]
_iss_text(){ # -> o texto de -m ($ISS_M) ou de -F ($ISS_F), num ARQUIVO (stdout: o caminho)
  local f; f="$(mktemp)"
  if [[ -n "${ISS_M+x}" ]]; then printf '%s' "$ISS_M" > "$f"
  elif [[ "${ISS_F:-}" == - ]]; then cat > "$f"
  elif [[ -n "${ISS_F:-}" ]]; then cat -- "$ISS_F" > "$f" 2>/dev/null || { rm -f "$f"; die "não consegui ler $ISS_F"; }
  fi
  printf '%s' "$f"; }
cmd_issues(){ need_login; local sub="${1:-ls}" all=0 a args=() tf body n title j
  case "$sub" in ls|list|show|new|open|comment|close|reopen) shift || true;; *) sub=ls;; esac
  unset ISS_M ISS_F
  while [[ $# -gt 0 ]]; do a="$1"; shift
    case "$a" in
      -m|--message) [[ $# -ge 1 ]] || die "faltou o texto depois de -m"; ISS_M="$1"; shift;;
      -F|--file) [[ $# -ge 1 ]] || die "faltou o arquivo depois de -F (- = stdin)"; ISS_F="$1"; shift;;
      --all|-a) all=1;;
      *) args+=("$a");;
    esac
  done
  set -- "${args[@]+"${args[@]}"}"
  case "$sub" in
    ls|list)
      id_arg '' "$@"
      j="$(api GET "/problems/issues?id=$(enc "$ID")")"
      [[ "$RAW" == 1 ]] && { printf '%s\n' "$j"; return; }
      jq -r --argjson all "$all" '(.issues // [] | map(select(.state == "closed")) | length) as $nc
        | "\(.id) — \(.open) aberta(s), \($nc) fechada(s)"
          + (if $nc > 0 and ($all == 0) then "   (--all mostra as fechadas)" else "" end)' <<<"$j"
      jq -r --argjson all "$all" '(.issues // [])[] | select($all == 1 or .state == "open")
        | "  #\(.n)\t\(if .state == "open" then "ABERTA" else "fechada" end)\t\(.title)\t\(.by) · \(.at | strflocaltime("%d/%m %H:%M"))"
          + (if ((.comments // []) | length) > 0 then " · \(.comments | length) coment." else "" end)' <<<"$j" \
        | { column -t -s$'\t' 2>/dev/null || cat; } ;;
    show)
      id_arg '^[0-9]+$' "$@"; shift "$IDSHIFT"
      [[ "${1:-}" =~ ^[0-9]+$ ]] || die "uso: moj issues show [<id>] <n>"
      j="$(api GET "/problems/issues?id=$(enc "$ID")")"
      jq -e --argjson n "$1" '[.issues[] | select(.n == $n)] | length > 0' <<<"$j" >/dev/null || die "issue #$1 não existe em $ID"
      [[ "$RAW" == 1 ]] && { jq --argjson n "$1" '.issues[] | select(.n == $n)' <<<"$j"; return; }
      jq -r --argjson n "$1" '.issues[] | select(.n == $n)
        | "#\(.n) [\(if .state == "open" then "ABERTA" else "fechada" end)] \(.title)",
          "  aberta por \(.by) em \(.at | strflocaltime("%d/%m/%Y %H:%M"))"
            + (if .state == "closed" then "; fechada por \(.closed_by // "?") em \(.closed_at | strflocaltime("%d/%m/%Y %H:%M"))" else "" end),
          (if (.body // "") != "" then "", (.body | split("\n") | map("  " + .) | join("\n")) else empty end),
          ((.comments // [])[] | "", "  — \(.by), \(.at | strflocaltime("%d/%m %H:%M")):", (.body | split("\n") | map("    " + .) | join("\n")))' <<<"$j" ;;
    new|open)
      # o título é texto livre: com 2+ argumentos o 1º é o id; com 1, o id vem da pasta
      if [[ $# -ge 2 ]]; then ID="$(resolve_id "$1")" || exit 1; shift
      else ID="$(resolve_id)" || exit 1; fi
      [[ "$ID" == *#* ]] || die "id inválido: '$ID' (esperado <org>#<prob>)"
      title="$*"; [[ -n "${title// /}" ]] || die "uso: moj issues new [<id>] \"<título>\" [-m <texto> | -F <arquivo>]"
      tf="$(_iss_text)"
      body="$(jq -Rsc --arg id "$ID" --arg t "$title" '{id:$id, action:"open", title:$t, body:.}' < "$tf")"; rm -f "$tf"
      api POST "/problems/issues" "$body" | out '"issue #\(.issue.n) aberta em \(.id): \(.issue.title)  (\(.open) aberta(s))"' ;;
    comment|close|reopen)
      id_arg '^[0-9]+$' "$@"; shift "$IDSHIFT"
      [[ "${1:-}" =~ ^[0-9]+$ ]] || die "uso: moj issues $sub [<id>] <n> [-m <texto> | -F <arquivo>]"
      n="$1"; tf="$(_iss_text)"
      [[ "$sub" != comment || -s "$tf" ]] || { rm -f "$tf"; die "falta o texto: moj issues comment [<id>] $n -m \"…\" (ou -F <arquivo>)"; }
      body="$(jq -Rsc --arg id "$ID" --arg a "$sub" --argjson n "$n" '{id:$id, action:$a, n:$n, body:.}' < "$tf")"; rm -f "$tf"
      api POST "/problems/issues" "$body" \
        | out '"issue #\(.issue.n) de \(.id): " + (if .issue.state == "open" then "aberta" else "fechada" end)
               + " · \((.issue.comments // []) | length) comentário(s) · \(.open) aberta(s) no problema"' ;;
  esac; }
cmd_collection(){ need_login; local sub="${1:-ls}"; shift || true
