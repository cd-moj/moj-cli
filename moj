      [[ ${#da[@]} -ge 1 ]] || die "uso: moj collection delete \"<nome>\" [--no-wait]"
      local resp; resp="$(api POST "/problems/collection-delete" "$(jq -n --arg n "${da[*]}" '{name:$n}')")" || exit 1
      jq -r '"excluída: \(.name) (untag em segundo plano; some do registro ao FINAL do re-tag)"' <<<"$resp"
      (( nowait )) || _retag_wait "$(jq -r '.retag_job // empty' <<<"$resp")";;
    status|jobs) local q="${1:-}" qs=""
      if [[ -n "$q" ]]; then [[ "$q" == rt* ]] && qs="?job=$(enc "$q")" || qs="?name=$(enc "$q")"; fi
      api GET "/problems/collection-retag-status$qs" | jq -r '.jobs[]? |
        "  \(.id)\t\(.from) -> \(if (.to // "")=="" then "(excluída)" else .to end)\t\(.done // 0)/\(.total // "?")\(if (.failed//0)>0 then "  ⚠\(.failed) falhas" else "" end)\t\(if .finished_at then "concluído" else "RODANDO" end)"' \
        | { column -t -s$'\t' 2>/dev/null || cat; };;
    *) die "subcomando de coleção: ls | create | show | add | remove | rename | delete | status";;
  esac; }

# languages = WHITELIST de linguagens de SUBMISSÃO do problema ([]/ausente = todas as padrão).
# Vive no .moj-id local e viaja no `moj push` (campo) E no `moj upload` (meta sintetizado).
# Essencial em problema de função/ban: sem whitelist, trocar de linguagem burla o driver.
cmd_languages(){ local d="" list=""
  if [[ $# -ge 1 && -f "$1/.moj-id" ]]; then d="$1"; list="${2:-}"
  elif [[ $# -ge 1 && -d "$1" ]]; then die "'$1' não é um pacote clonado (sem .moj-id) — use moj clone/new antes."
  else list="${1:-}"; d="$(pkg_root)" || die "rode dentro da pasta de um problema (a que tem o .moj-id) ou passe a pasta: moj languages <dir> [lista]"; fi
  if [[ -z "$list" ]]; then
    local cur; cur="$(jq -r '(.languages // []) | join(",")' "$d/.moj-id" 2>/dev/null)"
    if [[ -n "$cur" ]]; then echo "languages: $cur"
    else echo "languages: (todas as padrão — sem whitelist)"; fi
    echo "  setar:  moj languages c,cpp,py[,java,rs,…]     liberar todas:  moj languages all   (fora da pasta: moj languages <dir> …)"
    return 0
  fi
  if [[ "$list" == all || "$list" == todas ]]; then
    mid_set "$d" '.languages=[]'
    echo "languages: (todas as padrão)  — aplica no próximo push/SALVAR"
  else
    mid_set "$d" --argjson l "$(jq -n --arg s "$list" '$s|ascii_downcase|split(",")|map(gsub("^ +| +$";""))|map(select(length>0))|unique')" '.languages=$l'
    echo "languages: $(jq -r '(.languages)|join(",")' "$d/.moj-id")  — aplica no próximo push/SALVAR"
  fi; }

# ---- editor interativo (como os campos da página) -----------------------------------------
mid(){ jq -r ".$2 // \"\"" "$1/.moj-id" 2>/dev/null; }                 # campo do .moj-id
mid_set(){ local d="$1"; shift; local t; t="$(mktemp)"; jq "$@" "$d/.moj-id" > "$t" && mv -f "$t" "$d/.moj-id"; }
# ---- a PASTA do problema e o id implícito (issue #2: "a org já está no .moj-id") -----------------
# pkg_root [dir] -> caminho absoluto da pasta do problema: a própria ou a 1ª ACIMA com .moj-id (como o
# git acha o .git) — `moj push` de dentro de tests/ também acha o pacote.
pkg_root(){ local d; d="$(cd "${1:-.}" 2>/dev/null && pwd -P)" || return 1
  while :; do
    [[ -f "$d/.moj-id" ]] && { printf '%s' "$d"; return 0; }
    [[ "$d" == / || -z "$d" ]] && return 1
    d="$(dirname "$d")"
  done; }
# resolve_id [arg] -> <org>#<prob>. Vazio = o da pasta do problema; com '#' = ele mesmo; pasta clonada = o
# dela; nome SEM a org = <org da pasta atual>#nome. ⚠ Use `x="$(resolve_id …)"` em comando SEPARADO do
# `local`: com `local x="$(…)"` o die do subshell não derruba o comando.
resolve_id(){ local a="${1:-}" r
  if [[ -z "$a" ]]; then
    r="$(pkg_root)" || die "falta o <id>: rode dentro da pasta de um problema (a que tem o .moj-id) ou passe <org>#<prob>."
    jq -r '.id // empty' "$r/.moj-id"; return 0
  fi
  if [[ "$a" == *#* ]]; then printf '%s' "$a"; return 0; fi
  if [[ -f "$a/.moj-id" ]]; then jq -r '.id // empty' "$a/.moj-id"; return 0; fi
  r="$(pkg_root)" || die "'$a' não diz a org: use <org>#$a (ou rode dentro da pasta de um problema, que dá a org)."
  printf '%s#%s' "$(jq -r '.repo // empty' "$r/.moj-id")" "$a"
}
# id_arg <regex-do-que-NÃO-é-id> "$@" -> define ID e IDSHIFT (1 = o 1º argumento ERA o id; o chamador faz
# o shift). O id é IMPLÍCITO (vem da pasta) quando não há argumento, quando o 1º é uma opção (-…) ou quando
# ele casa a regex E estamos numa pasta de problema (ex.: `moj public on`, `moj restore <sha>`).
id_arg(){ local free="$1"; shift; IDSHIFT=0
  if [[ $# -eq 0 || "$1" == -* ]] || { [[ -n "$free" && "$1" =~ $free ]] && pkg_root >/dev/null; }; then
    ID="$(resolve_id)" || exit 1
  else ID="$(resolve_id "$1")" || exit 1; IDSHIFT=1; fi
  [[ "$ID" == *#* ]] || die "id inválido: '$ID' (esperado <org>#<prob>)"
}

# ---- linha de base local: o que o servidor tinha no último clone/pull/push --------------------------
# pkg_files <dir> -> os arquivos do PACOTE (relativos, ordenados): exatamente o que o pkg_to_json lê e
# manda. Arquivo seu que não é do pacote (tests/gera.py, docs/rascunho.txt) fica fora — o pull não mexe
# nele, e ele não conta como "alteração local".
pkg_files(){
  ( cd "$1" 2>/dev/null || exit 0
    shopt -s nullglob
    local f c
    for f in docs/enunciado.md docs/enunciado.org docs/enunciado.tex enunciado.md docs/solucao.md \
             docs/sample-notes.json author tags conf tests/score; do [[ -f "$f" || -L "$f" ]] && printf '%s\n' "$f"; done
    for f in docs/enunciado.*.md docs/solucao.*.md docs/notes/*.md; do [[ -f "$f" ]] && printf '%s\n' "$f"; done
    for f in docs/*; do case "${f##*.}" in png|jpg|jpeg|gif|svg|webp|PNG|JPG|JPEG|GIF|SVG|WEBP) [[ -f "$f" ]] && printf '%s\n' "$f";; esac; done
    for f in tests/input/*; do [[ -f "$f" ]] || continue; printf '%s\n' "$f"; [[ -f "tests/output/${f##*/}" ]] && printf '%s\n' "tests/output/${f##*/}"; done
    for c in good slow wrong pass upcoming; do for f in "sols/$c"/*; do [[ -f "$f" ]] && printf '%s\n' "$f"; done; done
    if [[ -d scripts ]]; then find scripts \( -type f -o -type l \) -print 2>/dev/null; fi
  ) | LC_ALL=C sort -u
}
# pkg_manifest <dir> -> "hash<TAB>caminho" de cada arquivo do pacote + uma linha com os campos de AUTORIA
# do .moj-id (título, traduções do título, linguagens, coleções — o push manda os quatro)
pkg_manifest(){ local d="$1" l f z
  l="$(pkg_files "$d")"; z="$(mktemp)"
  { if [[ -n "$l" ]]; then
      # symlink (scripts/<lang> -> c) entra pelo ALVO: o md5 de um link p/ diretório falharia calado
      ( cd "$d" && while IFS= read -r f; do
          if [[ -L "$f" ]]; then printf '%s\t%s\n' "$(_hash "link:$(readlink "$f")")" "$f"; else printf '%s\0' "$f" >> "$z"; fi
        done <<<"$l" )
      [[ -s "$z" ]] && ( cd "$d" && _hashfiles < "$z" )
    fi
    printf '%s\t%s\n' "$(_hash "$(jq -cS '{title:(.title//""), titles:(.titles//{}), languages:(.languages//[]), collections:(.collections//[])}' "$d/.moj-id" 2>/dev/null)")" '.moj-id'
  } | LC_ALL=C sort -t$'\t' -k2
  rm -f "$z"
}
# pkg_base_save <dir> — grava a linha de base (.moj-base; oculto, só do cliente, não sobe)
pkg_base_save(){ pkg_manifest "$1" > "$1/.moj-base.tmp" && mv -f "$1/.moj-base.tmp" "$1/.moj-base"; }
# pkg_changes <dir> -> "M|+|- caminho" do que mudou NA PASTA desde a linha de base (vazio = nada).
# Pasta clonada antes desta versão (sem .moj-base) -> "? …": não dá p/ saber, e quem chama trata como mudança.
pkg_changes(){ local d="$1"
  [[ -f "$d/.moj-base" ]] || { echo "? (pasta sem linha de base: clonada antes do 'moj pull' existir)"; return 0; }
  pkg_manifest "$d" | awk -F'\t' -v B="$d/.moj-base" '
    BEGIN { while ((getline l < B) > 0) { n = split(l, a, "\t"); if (n >= 2) b[a[2]] = a[1] } }
    { c[$2] = $1 }
    END { for (p in c) { if (!(p in b)) print "+ " p; else if (b[p] != c[p]) print "M " p }
          for (p in b) if (!(p in c)) print "- " p }' | LC_ALL=C sort -k2
}
# pkg_diff_manifests <antes> <depois> -> as mesmas linhas "M|+|- caminho" entre dois manifestos (arquivos)
pkg_diff_manifests(){
  awk -F'\t' -v B="$1" '
    BEGIN { while ((getline l < B) > 0) { n = split(l, a, "\t"); if (n >= 2) b[a[2]] = a[1] } }
    { c[$2] = $1 }
    END { for (p in c) { if (!(p in b)) print "+ " p; else if (b[p] != c[p]) print "M " p }
          for (p in b) if (!(p in c)) print "- " p }' "$2" | LC_ALL=C sort -k2
}
# _chg_print <linhas "M|+|-|? caminho"> — a lista de mudanças em português (a linha .moj-id = os campos
# de autoria do .moj-id: título, títulos traduzidos, linguagens, coleções)
_chg_print(){ local l k p
  while IFS= read -r l; do [[ -n "$l" ]] || continue
    k="${l%% *}"; p="${l#* }"
    [[ "$p" == .moj-id ]] && p="título/linguagens/coleções (.moj-id)"
    case "$k" in M) echo "    alterado: $p";; +) echo "    novo:     $p";; -) echo "    removido: $p";; *) echo "    $p";; esac
  done <<<"$1"; return 0; }
# _stale_die <corpo-do-409> <comando-que-envia-por-cima> — o 409 stale_rev da API (o problema mudou no
# servidor depois da sua linha de base) explicado: quem, quando e as três saídas
_stale_die(){ local b="$1" ow="$2" who when
  who="$(jq -r '.error.changed_by // ""' <<<"$b" 2>/dev/null || true)"
  when="$(jq -r 'if (.error.changed_at // 0) > 0 then (.error.changed_at | strflocaltime("%d/%m/%Y %H:%M")) else "" end' <<<"$b" 2>/dev/null || true)"
  die "o problema mudou no servidor depois do seu último clone/pull/push${who:+ (por $who}${when:+ em $when}${who:+)}.
  Nada foi enviado. Escolha uma saída:
    moj pull            traz a versão do servidor (recusa se a pasta tem mudanças suas)
    moj pull --force    traz a versão do servidor e guarda a sua pasta numa cópia ao lado
    $ow   envia a sua versão por cima da do servidor"; }
# _post_rev <rota> <corpo> <comando-por-cima> — POST de edit/upload com a trava de revisão. 409 stale_rev
# vira a explicação acima; outro erro, a mensagem do servidor. Sucesso: o corpo no stdout.
# ⚠ Chame SEM $(…) em volta do api_post_file (API_LAST_* morreriam no subshell) — aqui a resposta vai
# p/ arquivo; o chamador pode usar $(_post_rev …) porque o die sai com rc 1 e ele testa o rc.
_post_rev(){ local p="$1" f="$2" ow="$3" rf rc=0
  rf="$(mktemp)"
  API_SOFT=1 api_post_file "$p" "$f" > "$rf" 2>/dev/null || rc=$?
  if (( rc != 0 )); then
    rm -f "$rf"
    if [[ "${API_LAST_CODE:-}" == 409 && "$(jq -r '.error.code // ""' <<<"${API_LAST_BODY:-}" 2>/dev/null || true)" == stale_rev ]]; then
      _stale_die "${API_LAST_BODY:-}" "$ow"
    fi
    API_SOFT=0 _api_fail "${API_LAST_CODE:-}" "${API_LAST_BODY:-}"; return 1
  fi
  cat "$rf"; rm -f "$rf"; }
# _base_after_send <dir> <resposta> — depois de um push/upload aceito, a pasta É a versão do servidor:
# grava o rev novo no .moj-id e refaz o .moj-base (servidor sem `rev` = base_rev vazio, sem trava)
_base_after_send(){ local d="$1" r
  r="$(jq -r '.rev // ""' <<<"$2" 2>/dev/null || true)"
  mid_set "$d" --arg r "$r" '.base_rev=$r'
  pkg_base_save "$d"; }
# _pkg_swap <novo> <pasta> — troca os arquivos DO PACOTE da pasta pelos do pacote novo: some o que não
# existe mais, entra ou é atualizado o resto. Arquivo que não é do pacote (gerador, rascunho) fica.
_pkg_swap(){ local src="$1" dst="$2" f
  while IFS= read -r f; do [[ -n "$f" ]] || continue
    [[ -e "$src/$f" || -L "$src/$f" ]] || rm -f "$dst/$f" 2>/dev/null || true
  done < <(pkg_files "$dst")
  while IFS= read -r f; do [[ -n "$f" ]] || continue
    mkdir -p "$dst/$(dirname "$f")"; rm -f "$dst/$f" 2>/dev/null || true
    if [[ -L "$src/$f" ]]; then ln -s "$(readlink "$src/$f")" "$dst/$f"; else cp -p "$src/$f" "$dst/$f"; fi
  done < <(pkg_files "$src")
  # pasta que esvaziou (docs/notes, scripts/<lang>) sai também
  find "$dst/scripts" "$dst/docs/notes" -depth -type d -empty -exec rmdir {} \; 2>/dev/null || true
  cp "$src/.moj-id" "$dst/.moj-id"; }
# moj pull [dir] [--force] — traz p/ a pasta o que mudou no servidor (editor web, outro autor) desde o
# último clone/pull/push. A linha de base (.moj-id base_rev + .moj-base) separa o que é SEU do que é
# do servidor: mudança local não enviada => RECUSA (a pasta não é sobrescrita sem você pedir);
# --force => guarda a pasta inteira em <pasta>.local-AAAAMMDD-HHMMSS e traz a do servidor.
# Só os arquivos DO PACOTE são trocados (o conjunto do pkg_files).
cmd_pull(){ need_login
  local force=0 d="" a
  for a in "$@"; do case "$a" in
    --force|-f) force=1;;
    -*) die "opção desconhecida: $a (uso: moj pull [dir] [--force])";;
    *) [[ -z "$d" ]] || die "uso: moj pull [dir] [--force]"; d="$a";;
  esac; done
  local root; root="$(pkg_root "${d:-.}")" \
    || die "rode dentro da pasta de um problema (a que tem o .moj-id) ou passe a pasta. Para baixar pela primeira vez: moj clone <org>#<prob>"
  local id base; id="$(jq -r '.id // ""' "$root/.moj-id")"; base="$(jq -r '.base_rev // ""' "$root/.moj-id")"
  [[ "$id" == *#* ]] || die "o .moj-id de $root não tem um id válido"
  local chg nobase=0; chg="$(pkg_changes "$root")"; [[ -f "$root/.moj-base" ]] || nobase=1
  local rel="$root"; [[ "$root" == "$PWD" ]] && rel="."
  if (( ! nobase )); then
    # o servidor mudou? /problems/get é barato: o pacote só é baixado se precisar
    local cur; cur="$(api GET "/problems/get?id=$(enc "$id")" | jq -r '.rev // ""')"
    if [[ -n "$cur" && "$cur" == "$base" && "$force" != 1 ]]; then
      if [[ -z "$chg" ]]; then echo "já está atualizado: $id"; return 0; fi
      echo "o servidor não mudou desde o seu último clone/pull/push. A pasta tem mudanças suas:"
      _chg_print "$chg"
      echo "  Envie com: moj push.  Para descartá-las e voltar à versão do servidor: moj pull --force"
      return 0
    fi
    if [[ -n "$chg" && "$force" != 1 ]]; then
      echo "a pasta tem mudanças que ainda não foram enviadas:" >&2; _chg_print "$chg" >&2
      die "nada foi trocado. O servidor também mudou desde o seu último clone/pull/push. Escolha uma saída:
    moj pull --force      traz a versão do servidor e guarda a sua pasta em $rel.local-AAAAMMDD-HHMMSS
    moj push --overwrite  envia a sua versão por cima da do servidor"
    fi
  fi
  local T; T="$(mktemp -d)"
  api_get_to_file "/problems/source?id=$(enc "$id")&tests=full" "$T/src.json"
  json_to_pkg "$T/src.json" "$T/p" "$id"
  local newrev; newrev="$(jq -r '.rev // ""' "$T/src.json")"
  pkg_manifest "$T/p" > "$T/new.man"; pkg_manifest "$root" > "$T/cur.man"
  local diff; diff="$(pkg_diff_manifests "$T/cur.man" "$T/new.man")"
  if [[ -z "$diff" ]]; then     # a pasta já é a versão do servidor: só grava a linha de base
    mid_set "$root" --arg r "$newrev" --argjson p "$(jq '.public // false' "$T/src.json")" '.base_rev=$r | .public=$p'
    cp "$T/new.man" "$root/.moj-base"; rm -rf "$T"
    echo "já está atualizado: $id$( ((nobase)) && echo '  (linha de base gravada: da próxima vez o pull sabe o que é seu)')"
    return 0
  fi
  if (( nobase && ! force )); then
    rm -rf "$T"
    echo "a pasta e o servidor são diferentes:" >&2
    awk '{ k = $1; sub(/^[^ ]+ /, ""); if ($0 == ".moj-id") $0 = "título/linguagens/coleções (.moj-id)"
           print "    " (k == "M" ? "diferente:      " : k == "+" ? "só no servidor: " : "só na pasta:    ") $0 }' <<<"$diff" >&2
    die "esta pasta foi clonada antes de o 'moj pull' existir: não dá para saber se a diferença é sua ou do servidor.
  Nada foi trocado. Escolha uma saída:
    moj pull --force      traz a versão do servidor e guarda a sua pasta em $rel.local-AAAAMMDD-HHMMSS
    moj push --overwrite  envia a sua versão por cima da do servidor"
  fi
  local bk=""
  if [[ -n "$chg" ]]; then      # --force com mudança local: a pasta inteira vai p/ uma cópia ao lado
    bk="$root.local-$(date +%Y%m%d-%H%M%S)"; [[ -e "$bk" ]] && bk="$bk-$$"
    cp -Rp "$root" "$bk" || { rm -rf "$T"; die "não consegui copiar a pasta para $bk — nada foi trocado"; }
  fi
  _pkg_swap "$T/p" "$root"
  cp "$T/new.man" "$root/.moj-base"; rm -rf "$T"
  echo "atualizado: $id"
  _chg_print "$diff"
  if [[ -n "$bk" ]]; then
    echo "  A sua versão anterior está em: $bk"
    echo "  Compare com: diff -r \"$bk\" \"$root\""
  fi
  return 0; }
edit_examples(){ local d="$1"
  while true; do echo; echo "Exemplos (aparecem no enunciado):"
    local i=0 f; shopt -s nullglob; for f in "$d/tests/input"/sample*; do i=$((i+1)); echo "  $i) $(basename "$f")  in: $(head -c40 "$f"|tr '\n' ' ')"; done; shopt -u nullglob
    case "$(ask "  [a]dicionar [e]ditar N [n]ota N (explicação md) [r]emover N [v]oltar: ")" in
      a) local n=$(( $(find "$d/tests/input" -name 'sample*'|wc -l) + 1 )); "$ED" "$d/tests/input/sample$n" </dev/tty; "$ED" "$d/tests/output/sample$n" </dev/tty;;
      e*) local k="${REPLY:-}"; k="$(ask '  qual N? ')"; [[ -f "$d/tests/input/sample$k" ]] && { "$ED" "$d/tests/input/sample$k" </dev/tty; "$ED" "$d/tests/output/sample$k" </dev/tty; };;
      n*) local k; k="$(ask '  qual N? ')"
