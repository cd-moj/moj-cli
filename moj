      5) conf_set "$d" STOPWHEN_WA "$(ask '  STOPWHEN_WA (y/n): ' "$(conf_get "$d" STOPWHEN_WA)")";;
      6) if sample_off "$d"; then conf_set "$d" SAMPLE ""; echo "  exemplos: sim — crie tests/input/sample1 (+ output)"
         else conf_set "$d" SAMPLE no; echo "  SAMPLE=no: sem caixa de exemplo; ponha o exemplo no texto (## Exemplo)"; fi;;
      b) "$ED" "$d/conf" </dev/tty;;
      *) return;;
    esac; done; }
# coleções = TAGS de agrupamento (curadas). Marque só as EXISTENTES; "criar" registra uma nova coleção.
edit_colls(){ local d="$1" cur; cur="$(jq -r '(.collections//[])|join(",")' "$d/.moj-id")"
  echo; echo "Coleções atuais: ${cur:-—}"; echo "  disponíveis (marque só as existentes):"; api GET "/problems/collections" | jq -r '.collections[]? | "    \(.name)  [\(.count)]\(if .can_manage then " *gerencio*" else "" end)"'
  case "$(ask '  [s]et lista (vírgula) [c]riar nova coleção [v]oltar: ')" in
    s) mid_set "$d" --argjson c "$(jq -n --arg s "$(ask '  coleções (vírgula): ' "$cur")" '$s|split(",")|map(select(length>0))|map(gsub("^ +| +$";""))')" '.collections=$c';;
    c) local n; n="$(ask '  nome da coleção (pode ter espaços): ')"
       [[ -n "$n" ]] && { cmd_collection create "$n"; mid_set "$d" --arg n "$n" '.collections=((.collections//[])+[$n]|unique)'; };;
  esac; }
# moj title [dir] [--lang en|es] [<título>] — o título do problema (PT, .moj-id .title) ou da
# tradução (.moj-id .titles[<lang>] -> `titles` do .moj-meta.json). Sem título: mostra.
cmd_title(){ local d="" lang=pt t=""
  while [[ $# -gt 0 ]]; do case "$1" in --lang) lang="${2:-}"; shift 2;; *) if [[ -f "$1/.moj-id" ]]; then d="$1"; else t="$1"; fi; shift;; esac; done
  [[ -n "$d" ]] || d="$(pkg_root)" || die "rode dentro da pasta de um problema (a que tem o .moj-id) ou passe a pasta: moj title <dir> [<título>]"
  [[ "$lang" =~ ^(pt|en|es)$ ]] || die "--lang aceita pt, en ou es"
  if [[ -z "$t" ]]; then
    printf 'título (pt): %s\n' "$(mid "$d" title)"
    jq -r '(.titles // {}) | to_entries[] | "título (\(.key)): \(.value)"' "$d/.moj-id" 2>/dev/null
    return 0
  fi
  if [[ "$lang" == pt ]]; then mid_set "$d" --arg t "$t" '.title=$t'
  else mid_set "$d" --arg l "$lang" --arg t "$t" '.titles=((.titles//{}) + {($l):$t})'; fi
  echo "título ($lang): $t  — aplica no próximo push/SALVAR"; }
# tradução do enunciado/editorial no editor interativo (arquivos docs/*.<lang>.md + título)
edit_trans(){ local d="$1" l
  echo; echo "Traduções do enunciado (o português é docs/enunciado.md):"
  for l in en es; do printf '  %s: %s%s\n' "$l" "$([[ -f "$d/docs/enunciado.$l.md" ]] && echo 'enunciado' || echo '—')" \
    "$([[ -f "$d/docs/solucao.$l.md" ]] && echo ' + editorial' || true)"; done
  l="$(ask '  idioma (en/es) ou [v]oltar: ')"; [[ "$l" =~ ^(en|es)$ ]] || return 0
  case "$(ask "  [$l] [e]nunciado  [t]ítulo  [n]ota de exemplo N  [r]emover a tradução  [v]oltar: ")" in
    e) "$ED" "$d/docs/enunciado.$l.md" </dev/tty; [[ -s "$d/docs/enunciado.$l.md" ]] || rm -f "$d/docs/enunciado.$l.md";;
    t) cmd_title "$d" --lang "$l" "$(ask "  título ($l): " "$(jq -r --arg l "$l" '.titles[$l] // ""' "$d/.moj-id")")";;
    n*) local k; k="$(ask '  qual N? ')"
        if [[ -f "$d/tests/input/sample$k" ]]; then mkdir -p "$d/docs/notes"; "$ED" "$d/docs/notes/sample$k.$l.md" </dev/tty
          [[ -s "$d/docs/notes/sample$k.$l.md" ]] || rm -f "$d/docs/notes/sample$k.$l.md"
        else echo "  sample$k não existe"; fi;;
    r) rm -f "$d/docs/enunciado.$l.md" "$d/docs/solucao.$l.md" "$d/docs/notes"/*."$l".md 2>/dev/null
       mid_set "$d" --arg l "$l" 'del(.titles[$l])'; echo "  tradução $l removida localmente — aplica no próximo push";;
  esac; }
edit_editorial(){ local d="$1" l
  l="$(ask '  idioma do editorial (pt/en/es): ' pt)"; [[ "$l" =~ ^(pt|en|es)$ ]] || return 0
  local f="$d/docs/solucao.md"; [[ "$l" == pt ]] || f="$d/docs/solucao.$l.md"
  "$ED" "$f" </dev/tty; [[ -s "$f" ]] || rm -f "$f"; }
cmd_edit(){ need_login; local arg="${1:-}"
  [[ -r /dev/tty ]] || die "moj edit é interativo — precisa de um terminal."
  local D
  if [[ -z "$arg" ]]; then D="$(pkg_root)" || die "uso: moj edit [<id|dir>]   (sem argumento: rode dentro da pasta de um problema)"
  elif [[ -f "$arg/.moj-id" ]]; then D="$arg"
  else arg="$(resolve_id "$arg")" || exit 1
    D="${arg##*#}"; [[ -e "$D" ]] || cmd_clone "$arg" "$D" >/dev/null; [[ -f "$D/.moj-id" ]] || die "não consegui clonar $arg"; fi
  local id; id="$(mid "$D" id)"
  while true; do
    echo; echo "── Editando $id  (pasta $D) ─────────────────────────────"
    printf '  1) Título:    %s\n  2) Autor:     %s\n  3) Tags:      %s\n' "$(mid "$D" title)" "$(head -1 "$D/author" 2>/dev/null)" "$(paste -sd, "$D/tags" 2>/dev/null)"
    printf '  4) Enunciado  (editor)   5) Exemplos (%s)   6) Testes ocultos (%s)\n' "$(find "$D/tests/input" -name 'sample*' 2>/dev/null|wc -l)" "$(( $(find "$D/tests/input" -type f 2>/dev/null|wc -l) - $(find "$D/tests/input" -name 'sample*' 2>/dev/null|wc -l) ))"
    printf '  7) Soluções (good:%s wrong:%s slow:%s)   8) Conf   9) Coleções: %s\n' "$(ls "$D/sols/good" 2>/dev/null|wc -l)" "$(ls "$D/sols/wrong" 2>/dev/null|wc -l)" "$(ls "$D/sols/slow" 2>/dev/null|wc -l)" "$(jq -r '(.collections//[])|join(",")' "$D/.moj-id")"
    printf '  0) Público: %s   L) Linguagens: %s   r) Compartilhar pasta   v) Pré-visualizar\n' \
      "$(mid "$D" public)" "$(jq -r 'if ((.languages//[])|length)>0 then (.languages|join(",")) else "todas" end' "$D/.moj-id")"
    printf '  t) Traduções do enunciado (%s)   e) Editorial (pt/en/es)\n' \
      "$(for l in en es; do [[ -f "$D/docs/enunciado.$l.md" ]] && printf '%s ' "$l"; done | sed 's/ $//; s/^$/nenhuma/')"
    printf '  w) SALVAR (push)   P) Validar & Publicar   i) Info/validação   q) Sair\n'
    case "$(ask '  > ')" in
      1) mid_set "$D" --arg t "$(ask '  Título: ' "$(mid "$D" title)")" '.title=$t';;
      2) ask '  Autor: ' "$(head -1 "$D/author" 2>/dev/null)" > "$D/author";;
      3) ask '  Tags (vírgula): ' "$(paste -sd, "$D/tags" 2>/dev/null)" | tr ',' '\n' | sed '/^[[:space:]]*$/d;s/^[[:space:]]*//;s/[[:space:]]*$//' > "$D/tags";;
      4) "$ED" "$(enun_path "$D")" </dev/tty;;
      5) edit_examples "$D";; 6) edit_tests "$D";; 7) edit_sols "$D";; 8) edit_conf "$D";; 9) edit_colls "$D";;
      L|l) local nl; nl="$(ask '  linguagens (vírgula; "all"=todas as padrão): ' "$(jq -r '(.languages//[])|join(",")' "$D/.moj-id")")"
           [[ -n "$nl" ]] || nl=all
           cmd_languages "$D" "$nl";;
      0) local p; p="$(mid "$D" public)"; [[ "$p" == true ]] && p=false || p=true; mid_set "$D" --argjson p "$p" '.public=$p'; echo "  (aplica no próximo 'salvar')";;
      r) local act u; act="$(ask '  [a]dd ou [r]emove colaborador? ')"; u="$(ask '  login: ')"; [[ -n "$u" ]] && { [[ "$act" == r ]] && cmd_unshare "$(mid "$D" repo)" "$u" || cmd_share "$(mid "$D" repo)" "$u"; };;
      v) local pl; pl="$(ask '  idioma do preview (pt/en/es): ' pt)"; cmd_preview "$D" --lang "${pl:-pt}";;
      t) edit_trans "$D";; e) edit_editorial "$D";;
      w) cmd_push "$D"; local want; want="$(mid "$D" public)"; cmd_public "$id" "$([[ "$want" == true ]] && echo on || echo off)" >/dev/null 2>&1 || true; echo "  salvo.";;
      P) cmd_push "$D" >/dev/null && cmd_publish "$id";;
      i) cmd_status "$id";;
      q) echo "até mais."; return;;
    esac
  done; }

# camada agregadora: `moj contest …` delega ao moj-contest (ao lado do script ou no PATH).
# Padrão p/ camadas futuras: `moj <camada> …` -> executável moj-<camada>.
exec_layer(){ local layer="$1"; shift
  local d; d="$(dirname "$(_abspath "${BASH_SOURCE[0]}")")"
  [[ -x "$d/moj-$layer" ]] && exec "$d/moj-$layer" "$@"
  have "moj-$layer" && exec "moj-$layer" "$@"
  die "camada '$layer' não instalada: curl -fLO $MOJ_URL/moj-$layer && chmod +x moj-$layer"
}

# MOJ_CLI_LIB_ONLY=1 + `source moj`: só define as funções (é como test/translations.sh exercita
# pkg_to_json/json_to_pkg sem rede). Executado normalmente, a variável não existe e nada muda.
if [[ "${MOJ_CLI_LIB_ONLY:-0}" == 1 ]]; then return 0 2>/dev/null || exit 0; fi
# --json ANTES do subcomando = saída crua da API nos leitores (ls/board/status/check)
while [[ "${1:-}" == --json ]]; do RAW=1; shift; done
cmd="${1:-help}"; shift || true
case "$cmd" in
  contest) exec_layer contest "$@";;
  judges) exec_layer judges "$@";;
  comp|aluno) exec_layer comp "$@";;
  login) cmd_login "$@";; logout) cmd_logout "$@";; whoami) cmd_whoami "$@";;
  ls) cmd_ls "$@";; repos) cmd_repos "$@";; mkdir) cmd_mkdir "$@";; info|show) cmd_info "$@";;
  new) cmd_new "$@";; clone|open) cmd_clone "$@";; edit) cmd_edit "$@";; test) cmd_test "$@";; push) cmd_push "$@";; pull) cmd_pull "$@";;
  checker) cmd_checker "$@";; interactive|interativo) cmd_interactive "$@";; fn|funcao) cmd_fn "$@";;
  preview) cmd_preview "$@";; download) cmd_download "$@";; upload) cmd_upload "$@";; export) cmd_export "$@";; import) cmd_import "$@";;
  log|history) cmd_log "$@";; restore) cmd_restore "$@";;
  validate|validar) cmd_validate "$@";;
  doctor) cmd_doctor "$@";; version|--version|-V) cmd_version "$@";; update|selfupdate) cmd_update "$@";;
  publish) cmd_publish "$@";; public) cmd_public "$@";; calibrate) cmd_calibrate "$@";; status) cmd_status "$@";; check) cmd_check "$@";; board|painel) cmd_board "$@";;
  calib) cmd_calib "$@";; calib-report) cmd_calib_report "$@";;
  testrun|test-run) cmd_testrun "$@";; testrun-status) cmd_testrun_status "$@";;
  share) cmd_share "$@";; unshare) cmd_unshare "$@";; collection|coll) cmd_collection "$@";; rm|remove) cmd_rm "$@";;
  issues|issue) cmd_issues "$@";;
  languages|langs|lang) cmd_languages "$@";; title|titulo) cmd_title "$@";;
  org|orgs) cmd_org "$@";; mv|move) cmd_mv "$@";;
  help|-h|--help) awk 'NR>1{ if (!/^#/ || /@INLINE/) exit; sub(/^# ?/,""); print }' "$0";;
  *) die "comando desconhecido: $cmd (veja 'moj help')";;
esac
