cmd_status(){ need_login
  if [[ $# -ge 1 ]]; then cmd_check "$1"; return; fi
  api GET "/index/status" | out '"  juízes online: \(.judge.online)/\(.judge.total)  (ocupados \(.judge.busy), \(.judge.cpus_online) CPUs, \(.judge.gpus_online) com GPU)\n  fila: \(.queue.total_pending) pendentes (\(.queue.spool_queued) no spool)\n  daemons: judged=\(.daemons.judged) result-sink=\(.daemons.result_sink)" + (if .alert.no_judges then "\n  ⚠ trabalho na fila e NENHUM juiz online" else "" end)'; }
# QA COMPLETO de um problema: validação (testado em todos os casos) + calibração (TL por juiz +
# solução good que falhou em TODAS as máquinas) + TL servido/staleness.
cmd_check(){ need_login; id_arg '' "$@"; local id="$ID" vt ct tt st
  vt="$(api GET "/problems/validation?id=$(enc "$id")" 2>/dev/null)" || vt='{}'
  ct="$(api GET "/problems/calib?id=$(enc "$id")" 2>/dev/null)" || ct='{}'
  tt="$(api GET "/problems/tl?id=$(enc "$id")" 2>/dev/null)" || tt='{}'
  st="$(api GET "/problems/status?id=$(enc "$id")" 2>/dev/null)" || st='{}'
  [[ "$RAW" == 1 ]] && { jq -cn --argjson v "$vt" --argjson c "$ct" --argjson t "$tt" --argjson s "$st" \
    '{validation:$v, calib:$c, tl:$t, status:(($s.problems // [])[0] // null)}'; return; }
  local validado calibrado recal miss bcal
  # PACOTE (era "validado"): a conferência ESTÁTICA do validate-problem.sh — não roda solução
  # nenhuma. Quem roda é a calibração: soluções e entradas vêm dela (linhas abaixo).
  validado="$(jq -r 'if (.checks|not) or .status=="unvalidated" then "não conferido" elif .ok then "OK" else "COM ERRO" end' <<<"$vt" 2>/dev/null)"
  # calibração EM VOO (pendente/rodando): o TL ainda vazio é ESPERADO, não falha.
  # (fallback false: servidor antigo sem o campo => comportamento de antes.)
  bcal="$(jq -r '.being_calibrated // false' <<<"$tt" 2>/dev/null)"
  if [[ "$bcal" == true ]]; then
    calibrado="⏳ aguardando (calibração na fila)"
    recal="$(jq -r 'if .needs_recalibration then "recalibrando…" else "não" end' <<<"$tt" 2>/dev/null)"
  else
    calibrado="$(jq -r 'if .calibrated then "sim" else "não" end' <<<"$tt" 2>/dev/null)"
    recal="$(jq -r 'if .needs_recalibration then "SIM ⚠" else "não" end' <<<"$tt" 2>/dev/null)"
  fi
  miss="$(jq -rc '(.missing_langs // [])|join(", ")' <<<"$ct" 2>/dev/null)"
  printf '%s\n  pacote: %s   calibrado: %s   precisa recalibrar: %s\n' "$id" "${validado:-?}" "${calibrado:-?}" "${recal:-?}"
  # SOLUÇÕES × categoria e ENTRADAS (validador), e o veredito final: pronto ou as pendências
  jq -r "$_RDY_JQ"'(.problems // [])[0] // empty
    | "  soluções: \(.sols | stext)   entradas: \(.inputs | vtext)",
      (if .ready then "  pronto: SIM" else "  pronto: NÃO — " + ((.pending // []) | map(plabel) | join("; ")) end)' <<<"$st" 2>/dev/null || true
  # o PORQUÊ da recalibração: quando calibrou, checksums e os commits que afetam o TL desde então
  if [[ "$(jq -r '.needs_recalibration // false' <<<"$tt" 2>/dev/null)" == true ]]; then
    jq -r '"  ⚠ MOTIVO: \(.reason // "pacote mudou desde a calibração")"
           + (if .calibrated_at then "\n    calibrado em: \(.calibrated_at|strftime("%Y-%m-%d %H:%M UTC"))" else "" end)' <<<"$tt" 2>/dev/null
    jq -r '(.changes // [])[] | "    \(.sha[0:7])  \(.at|strftime("%m-%d %H:%M"))  \(.author)  \(.subject[0:60])"' <<<"$tt" 2>/dev/null
    jq -r 'if ((.changed_files // [])|length) > 0 then "    arquivos: \(.changed_files|join(", "))" else empty end' <<<"$tt" 2>/dev/null
  fi
  # enquanto a calibração está EM VOO, "sem TL" é aguardado — não é falha. Só grita "falhou em
  # TODAS as máquinas" quando NÃO há calibração pendente (aí é sinal real: calibrou e não obteve TL).
  if [[ "$bcal" == true ]]; then
    printf '  ⏳ calibração enfileirada — aguardando um juiz (rode "moj check %s" em ~30s)\n' "$id"
  elif [[ -n "$miss" ]]; then
    printf '  ⚠ REVISAR: solução good SEM TL em [%s] — falhou em TODAS as máquinas de juiz\n' "$miss"
  fi
  echo "  Pacote (conferência estática — não roda soluções; elas rodam na calibração):"
  jq -r '(.checks//[])[] | "    \(if .ok then "✓" else "✗" end) \(.name)\(if (.detail//"")!="" then " — \(.detail)" else "" end)"' <<<"$vt" 2>/dev/null || echo "    (sem relatório)"
  echo "  Time limits (máx entre juízes):"
  jq -r '(.time_limits//{})|to_entries|map(select(.key!="default"))| if length==0 then "    (sem TL)" else (map("    \(.key): \(.value)s")|join("\n")) end' <<<"$tt" 2>/dev/null
  # TLOVERRIDE do conf: o autor mandou no TL — o exibido acima JÁ é o efetivo
  jq -r 'if (.tl_override // {}) != {} then "  ⚙ TL OVERRIDE no conf (vence o calibrado): " + (.tl_override|to_entries|map("\(.key)=\(.value)s")|join(" ")) else empty end' <<<"$tt" 2>/dev/null
  echo "  Calibração por máquina:"
  jq -r '(.hosts//[])[] | "    \(.host): " + ((.tl//{})|to_entries|map(select(.key!="default"))|map("\(.key)=\(.value)")|join(" ")) + (if ((.missing//[])|length)>0 then "   (falta: \(.missing|join(","))" + ")" else "" end)' <<<"$ct" 2>/dev/null || echo "    (não calibrado)"
}
# CALIBRAÇÃO ESTRUTURADA: o que cada juiz rodou, solução a solução, teste a teste — o campo
# `sols` do /problems/calib ([{file,lang,category,verdict,tests:[{name,code,time,tl}]}]).
# P/ integrar com ferramentas externas: `moj --json calib <id>` (JSON cru).
cmd_calib(){ need_login; id_arg '' "$@"
  local id="$ID" j; j="$(api GET "/problems/calib?id=$(enc "$id")")"
  [[ "$RAW" == 1 ]] && { printf '%s\n' "$j"; return; }
  jq -r --argjson now "$EPOCHSECONDS" '"\(.id)  (checksum \((.checksum // "?")[0:8])" +
           (if (.version // "") != "" then ", versão \(.version[0:8])" else "" end) + ")" +
         # EM VOO agora: a calibração leva minutos, e sem esta linha o autor não sabe se esperar
         (if ((.calibrating // []) | length) > 0 then "\n  ⏳ calibrando: " +
            ((.calibrating | map((if .host == "" then "na fila" else .host end)
              + (if (.since // 0) > 0 then " (há \((($now - .since) / 60) | floor) min)" else "" end))) | join(" · "))
          else "" end) +
         (if (.tl_override // {}) != {} then "\n  ⚙ TL OVERRIDE no conf: " + (.tl_override|to_entries|map("\(.key)=\(.value)s")|join(" ")) else "" end) +
         (if ((.missing_langs // [])|length) > 0 then "\n  ⚠ good sem TL em: \(.missing_langs|join(", "))" else "" end)' <<<"$j"
  # soluções × o que a categoria pede, somado entre os juízes da versão atual (o número do Painel)
  jq -r '(.summary // null) as $s | if $s == null or (($s.total // 0) == 0 and (($s.missing // []) | length) == 0) then empty
    else "  soluções: \(($s.total // 0) - ($s.bad // 0)) de \($s.total // 0) conforme"
      + (if ($s.note // 0) > 0 then " · \($s.note) por outro motivo" else "" end)
      + (if ($s.bad // 0) > 0 then " · \($s.bad) DIVERGENTE(S): \($s.bad_files | join(", "))" else "" end)
      + (if (($s.missing // []) | length) > 0 then " · sem resultado: \($s.missing | join(", ")) (moj calibrate)" else "" end) end' <<<"$j" 2>/dev/null || true
  # juiz `stale` = calibrou OUTRA versão do pacote: o servidor NÃO manda as sols dele (mostrar a
  # lista velha fazia o autor ver solução já apagada como se fosse a de agora). Diga isso, em vez
  # de repetir "ainda não reportou" — que é outra coisa (juiz/mojtools antigos).
  jq -r "$_RDY_JQ"'. as $r | (.hosts // [])[] |
    "— \(.host)  \(.at // 0 | todate)  TL: " + ((.tl // {})|to_entries|map("\(.key)=\(.value)")|join(" ")) +
      (if .stale then "   ⚠ DESATUALIZADO (versão \((.version // "?")[0:8])) — recalibre" else "" end),
    (if .stale then "  (as soluções deste juiz são de uma versão anterior do pacote — rode: moj calibrate \($r.id // ""))"
     elif ((.sols // [])|length) > 0 then
      (.sols[] | "  [\(.expect | xpill)] \(.category)/\(.file) [\(.lang)]: \(.verdict)",
        (if (.category | xwant) != "" then "      \(.category | xwant); obtido: \(.expect | xgot)" else empty end),
        ((.tests // [])[] | "    \(.name): \(.code)  \(.time // "?")s  (tl \(.tl // "?")s)"))
     else "  (este juiz ainda não reportou o vetor estruturado — veja o log: moj --json calib)" end),
    (if (.stale | not) and .validator != null then
       "  entradas: \(.validator | vtext)",
       ((.validator.tests // [])[] | select(.code != "OK") | "    ✗ \(.name): \(.msg // .code)")
     else empty end)' <<<"$j" 2>/dev/null
}
# report.html de UMA solução da calibração, por juiz (GET /problems/calib-report).
cmd_calib_report(){ need_login
  id_arg '' "$@"; shift "$IDSHIFT"
  local id="$ID" host="" name="" out=""
