cmd_esqueletos(){ need_contest; need_login; local sub="${1:-ls}"; shift || true
  local P="/contest/admin/esqueletos$(qc)"
  case "$sub" in
    ls|list)
      api GET "$P" | out '"módulo: \(if .module_on then "ligado" else "desligado" end) · editor embutido: \(if .editor_on then "ligado" else "DESLIGADO (o time não vê esqueleto)" end)",
        (if (.langs | length) == 0 then "todas as linguagens: padrão do MOJ"
         else (.langs | to_entries[] | "\(.key)\t\(if .value.mode == "off" then "sem esqueleto (abre vazio)" else "personalizado (\(.value.code | utf8bytelength) bytes)" end)"),
              "as demais: padrão do MOJ" end)' | { column -t -s$'\t' 2>/dev/null || cat; };;
    show)
      [[ $# -ge 1 ]] || die "uso: esqueletos show <lang>"
      api GET "$P" | jq -r --arg l "$1" '(.langs[$l] // null) as $e
        | if $e == null then "(\($l): padrão do MOJ)" elif $e.mode == "off" then "(\($l): sem esqueleto — abre vazio)" else $e.code end';;
    set)
      [[ $# -ge 1 ]] || die "uso: esqueletos set <lang> --from <arquivo|->"
