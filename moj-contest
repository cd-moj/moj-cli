      api POST "$P" "$(jq -cn --arg a "$sub" --arg l "$1" '{action:$a, lang:$l}')" \
        | jq -r --arg l "$1" --arg a "$sub" '"\($l): \(if $a == "off" then "sem esqueleto (abre vazio)" else "padrão do MOJ" end)"';;
