#!/usr/bin/env bash
# moj-contest — CLI de gestão de contest do MOJ (camada 'contest'; `moj contest …` delega aqui).
# Tudo pela API. Os mesmos bloqueios da web valem. O servidor aplica o corte.
#
# Sessões: há duas. Os comandos create, template, export, duplicate, list e remove usam a sessão
# do treino (`moj login`). Os comandos de administração (settings, problems, users e os demais
# com -c) exigem uma sessão naquele contest: `moj-contest login <cid>` com uma conta *.admin do
# contest. O token fica em ~/.config/moj/token-<cid>. Ele não substitui a sessão do treino.
#
#   moj-contest login <cid> [-u login]   Entra no contest.
#   moj-contest logout [<cid>] | whoami  Sai. Mostra quem você é.
#   moj-contest create [spec.json|-] [--template <nome>] [--id X] [--name N] [--start E] [--end E]
#                      [--mode icpc|obi|treino|heuristic] [--empty] [--modules a,b,c]
#       Cria o contest. Exige ao menos um problema. --empty cria a sala vazia; os problemas entram
#       depois com `-c <cid> problems add`. O contest entra no ar na hora. --modules liga módulos.
#       --mode escolhe o placar: icpc (padrão), obi (pontuação por teste), treino (lista de
#       exercícios) ou heuristic. O modo não muda depois da criação: para trocar, exporte o spec,
#       edite o campo mode e crie de novo.
#       No spec, a seção modules{} leva os dados de cada módulo: sedes, balões, coortes, gate de
#       UA, rodadas, documentos, inscrições, telão e classificação. Veja `moj-contest modules`.
#   moj-contest list                     Lista os contests criados por você.
#   moj-contest show <cid>               Mostra o resumo de um contest, com os módulos ligados.
#   moj-contest export <cid> [arquivo] [--full]   Grava o spec em um arquivo. Sem credenciais.
#   moj-contest duplicate <cid> [--id X] [--name N] [--start E] [--end E]   Copia um contest.
#   moj-contest template list | show <nome> | save <nome> (--from-contest <cid> [--with-problems]
#                      | --from-file f.json) | rm <nome> | rename <nome> <novo>   Gerencia templates.
# Administração (exigem -c <cid> ou MOJ_CONTEST, e a sessão .admin do contest):
#   moj-contest -c <cid> modules [list] | on <id[,id…]> | off <id[,id…]>
#       Gerencia os módulos: sedes, maquinas, rodadas, documentos, baloes, coortes, inscricoes,
#       telao, classificacao, virtual (participação virtual: só liga com TODOS os problemas públicos
#       no treino e contest não-secreto — senão 422 virtual_not_eligible), esqueletos (esqueleto de
#       código no editor do time: só liga com o editor embutido — senão 422 editor_required).
#       list mostra ligado/desligado e se há dados. Desligar não apaga dado.
#       Prova de disciplina: nenhum. Prova com Maratona Linux: maquinas. Maratona: todos, menos
#       virtual e esqueletos.
#       Gravar o dado de um módulo (rounds add, cohorts add, ua-gate set, docs gen…) liga o
#       módulo sozinho. Só desligar é manual.
#   moj-contest -c <cid> esqueletos [ls] | show <lang> | set <lang> --from <arq|-> | off <lang> | reset <lang>
#       O esqueleto de código que o editor do time mostra (módulo esqueletos). Cada linguagem usa o
#       padrão do MOJ, um esqueleto personalizado (set) ou nenhum (off). reset volta ao padrão.
#       Gravar liga o módulo. O módulo precisa do editor embutido ligado.
#   moj-contest -c <cid> settings [get]  Mostra as configurações.
#   moj-contest -c <cid> settings set k=v [k=v…]   Grava configurações.
#       Penalidade ICPC: penalty_minutes=10 penalty_verdicts=wa,tle,mle,rte,ce.
#       penalty_verdicts= (vazio) = nenhum veredicto penaliza.
#       Pool de juízes: judges=cpu1,cpu2. judges= (vazio) = qualquer juiz.
#       Correção manual: manual_verdict=true review_judges=2 (1 a 5 juízes validam).
#       Prioridade no julgamento: priority=lista-publica|lista-privada|prova (Super: veja `priority`).
#       Fuso da prova (horas que o servidor escreve): tz=America/Santiago. tz= (vazio) = padrão.
#   moj-contest -c <cid> extend <+min|epoch> [--group <regex> [--reason <txt>]]   Prorroga o fim.
#   moj-contest -c <cid> problems ls | add <id> [--name N] [--letter L] | rm <letra>
#                       | rename <letra> <nome> | reorder <L1> <L2> … | langs <letra> <l1,l2|->
#                       | judges <letra> <host1,host2|->   ('-' volta a herdar do contest)
#                       | search <q> [--collection C] | draw [--collections "A,B"] [--tags a,b]
#                         [--count n] [--difficulty d] [--match any|all] [--seed s] [--add]
#                         [--include-private]   (soma os privados do DONO do contest; padrão: só públicos)
#   moj-contest -c <cid> users ls | add <login> [--pass P] [--name N] [--email E] | reset <login>
#                       | rm <login> | disable <login> [--undo] | logout <login>
#                       | set-password-all <senha> [--include-disabled]
#                       | convert [--apply] [--logout-all] [--csv ARQ]
#       Contest COMPARTILHADO (usuários do Treino Livre): `ls` marca quem entra pela conta do treino
#       (🔗treino); `disable --undo` reabilita um compartilhado desabilitado. `convert` = desfazer o
#       compartilhamento: sem --apply mostra a PRÉVIA (nada é gravado); com --apply converte em contas
#       PRÓPRIAS — senhas NOVAS, histórico e placar ficam, cada time vira UMA conta. Pede "sim" antes da
#       prova e o id do contest depois do início. Sem volta. --csv grava as credenciais (só você lê).
#   moj-contest -c <cid> regions show | get [arq] | set <arq.json> [--dry-run] [--mode simple|rules|tree]
#                       | who <login> | assign <login> <sede> | assign --csv <arq> [--dry-run]
#                       | unassign <login> | map [--csv]
#       Sedes pela regra única do servidor. A sede GRAVADA vence; senão a regex mais funda casa o login.
#       Pai = soma dos filhos. Recorte (`view`) nunca é sede. `set` confere a regex (subconjunto seguro)
#       e recusa se alguém mudou as sedes desde o seu `get`. `--dry-run` mostra o que muda sem gravar.
#       `assign` num membro de time grava no TIME. Inscrito fica no roster (sobrevive à inscrição).
#       CSV de `assign --csv`: uma linha `login,sede` (sede vazia = tira).
#   moj-contest -c <cid> sessions | dashboard | score | report [arquivo] | audit [n] | access [AAAA-MM-DD]
#   moj-contest -c <cid> news ls | add <título> [texto] | rm <id>
#   moj-contest -c <cid> rounds ls | add <slug> --name N --start <epoch|+90m|"AAAA-MM-DD HH:MM"> --end <…>
#                       [--freeze <…>] [--kind warmup|official|extra]
#                       | set <slug> [--slug <novo>] [--name N] [--start …] [--end …] [--freeze …] [--kind …]
#                       | problems <slug> [ls|set <id,id…>|add <id>|rm <letra>]
#                       | colors <slug> [ls|set <json>|set A=RRGGBB,B=RRGGBB[,sonic]|clear]
#                       | promote [--force] | undo | publish <slug> | unpublish <slug> | rm <slug>
#                       | archive <slug> [arq.tar.gz]
#       Aquecimento e prova oficial no mesmo contest: mesma URL, mesmo login, config intacta.
#       Promover arquiva a rodada no ar (submissões, veredictos, placar e logs ficam guardados) e
#       coloca a próxima no ar. Recusa com job em voo, veredicto pendente ou review aberto.
#       `rounds ls` mostra os bloqueadores. `rounds problems` aceita todo problema que o dono do
#       contest pode ver: público, seu, de colaborador ou da org. `rounds colors` define as cores
#       de balão da rodada. Uma rodada sem cores herda as cores em vigor quando é promovida.
#   moj-contest -c <cid> cohorts ls | add <id> [--name N] [--regex R] [--private] [--unranked]
#                       [--sees a,b] [--default] | set <id> … | rm <id>
#                       | assign <login> <coorte> | materialize | release [on|off]
#       Coortes de placar: times oficiais e convidados. Uma coorte privada não aparece no placar
#       público. --unranked entra intercalado sem consumir posição. release libera os resultados.
#   moj-contest -c <cid> ua-gate show | check <login>
#                       | set [--mode enforce|off] [--from-login REGEX --expect '\1']
#                         [--region 'Sede=substring']… [--regex 'REGEX=substring']…
#                         [--exempt REGEX]… [--fallback S]
#       Gate de navegador por sede. A imagem de cada sede manda um User-Agent com um trecho do login
#       do time (teambrspso001 -> "brspso"). --from-login cobre todas as sedes de uma vez. --region é
#       o override de uma sede. --exempt é a isenção. check diz o trecho esperado de um time.
#   moj-contest -c <cid> seed [--teams N] [--subs N] [--seed S] [--freeze-minute M] [--live N]
#       Povoa um contest DEMO=1 com placar e veredictos sintéticos. Serve para quem desenvolve telão.
#   moj-contest -c <cid> machines [--round <slug>] [--csv]
#       Mostra time × IP × User-Agent da rodada. No aquecimento os times ligam as máquinas.
#   moj-contest -c <cid> docs ls | gen [info|caderno|times|editorial…] [--lang pt|en|es|both|all]
#                       | get <info|caderno|times|all> [--lang …] [--fmt pdf|html|odt] [-o arq]
#                         (--fmt odt = o .odt EDITÁVEL do gerado — só .admin/.cjudge; ajuste e suba o PDF com upload)
#                       | publish <tipo> [--lang pt] [--news] | unpublish <tipo> [--lang pt]
#                       | cover <capa.pdf> [--lang pt] | cover --rm [--lang pt]
#                       | logo <imagem> | logo --rm   (logo no topo das páginas do caderno/editorial e na capa)
#                       | upload <tipo> <doc.pdf> [--lang pt]   (PDF pronto vence o gerado; --rm volta)
#                       | set caderno_version=v1.2 [errata=…] [cover_note=…] [samples_table=true|false]
#                       | text <info|capa> [--lang pt] [--show | --from arq|- | --reset]
#       Documentos da prova: info sheet, caderno e folha de time limits, em PDF e HTML, pt/en/es.
#       ls e get funcionam com qualquer conta do contest e mostram só o publicado.
#       gen, publish e cover exigem .admin ou .cjudge.
#   moj-contest remove <cid>             Tira o contest do ar. Exige .admin do treino.
#   moj-contest priority <cid> <lista-publica|lista-privada|prova|super>   Muda a prioridade no julgamento.
#       Exige o SUPER-ADMIN do treino (é o único caminho para Super). O admin do contest muda as outras com
#       `settings set priority=prova`. A mudança fica na auditoria do contest e na do treino.
# Config: MOJ_URL, MOJ_CONTEST (= -c), MOJ_HOST (header Host em dev). Saída crua: --json.
# Documentação: README.md (PT) e README.en.md (EN).
set -euo pipefail

MOJ_TOOL=moj-contest
# @INLINE-BEGIN lib/core.sh  (mkdist.sh troca este bloco pelo conteúdo da lib -> 1 arquivo)
_moj_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
_MOJ_LIB="$(cd "$(dirname "$_moj_self")" && pwd)/lib/core.sh"
[[ -f "$_MOJ_LIB" ]] || { printf 'moj-contest: lib/core.sh não encontrada (rode do repo, ou use o artefato de dist/mkdist.sh)\n' >&2; exit 1; }
source "$_MOJ_LIB"
# @INLINE-END

CONTEST_SET=0; [[ -n "${MOJ_CONTEST:-}" ]] && CONTEST_SET=1
# flags globais (antes do subcomando): -c <cid> | --json (RAW/out vêm da lib)
while [[ $# -gt 0 ]]; do
  case "$1" in
    -c|--contest) [[ $# -ge 2 ]] || die "uso: -c <contest>"; CONTEST="$2"; CONTEST_SET=1; shift 2;;
    --json) RAW=1; shift;;
    *) break;;
  esac
done

need_contest(){ [[ "$CONTEST_SET" == 1 ]] || die "informe o contest: -c <id> (ou MOJ_CONTEST=<id>)"; }
qc(){ printf '?contest=%s' "$(enc "$CONTEST")"; }
# api_t — chama a API com a sessão do TREINO (criação/templates/export/…), qualquer que seja -c
api_t(){ local _old="$CONTEST"; CONTEST=treino; api "$@"; local rc=$?; CONTEST="$_old"; return $rc; }
need_login_t(){ [[ -f "$(token_file treino)" ]] || die "faça 'moj login' (sessão do treino) primeiro."; }

# ---- sessão -------------------------------------------------------------------------------
cmd_login(){ local cid="${1:-}" u=""
  [[ -n "$cid" ]] || { need_contest; cid="$CONTEST"; }
  shift || true
  while [[ $# -gt 0 ]]; do case "$1" in -u|--user) u="$2"; shift 2;; *) die "opção desconhecida: $1";; esac; done
  [[ -n "$u" ]] || read -rp "login ($cid): " u
  local p; read -rsp "senha: " p; echo
  local tok; tok="$(CONTEST="$cid" api POST "/auth/login?contest=$(enc "$cid")" "$(jq -n --arg u "$u" --arg p "$p" '{username:$u,password:$p}')" | jq -r '.token // empty')"
  [[ -n "$tok" ]] || die "login falhou."
  printf '%s' "$tok" | token_save "$cid"
  echo "ok, logado em '$cid' como $u (token-$cid)."; }
cmd_logout(){ local cid="${1:-$CONTEST}"; token_drop "$cid"; echo "deslogado de '$cid'."; }
cmd_whoami(){ need_contest; need_login
  api GET "/auth/status$(qc)" | out '"contest: '"$CONTEST"'  login: \(.login//"?")  nome: \(.name//"?")  admin: \(if .is_admin then "sim" else "não" end)"'; }

# ---- criação / reuso (sessão do treino) ---------------------------------------------------
cmd_create(){ need_login_t
  local specf="" tpl="" id="" name="" start="" end="" empty=0 mods="" mode="" a
  while [[ $# -gt 0 ]]; do a="$1"; shift
    case "$a" in
      --template) tpl="$1"; shift;;
      --modules) mods="$1"; shift;;
      --mode) mode="${1:-}"; shift;;
      --id) id="$1"; shift;;
      --name) name="$1"; shift;;
      --start) start="$1"; shift;;
      --end) end="$1"; shift;;
      --empty|--allow-empty) empty=1;;
      --*) die "opção desconhecida: $a";;
      *) specf="$a";;
    esac
  done
  local spec='{}'
  if [[ -n "$specf" ]]; then
    if [[ "$specf" == - ]]; then spec="$(cat)"; else [[ -f "$specf" ]] || die "arquivo não existe: $specf"; spec="$(cat "$specf")"; fi
    jq -e . >/dev/null 2>&1 <<<"$spec" || die "spec JSON inválido"
    spec="$(jq -c 'del(.["_ajuda"]) | walk(if type=="object" then with_entries(select(.key|startswith("_")|not)) else . end)' <<<"$spec")"
  fi
  if [[ -n "$tpl" ]]; then
    local t st; t="$(api_t GET "/treino/contest-create/templates?name=$(enc "$tpl")" | jq -c '.template.spec // {}')"
    st="${start:-$(( ($(date +%s) / 3600 + 1) * 3600 ))}"
    # absolutiza o template (duration/login_lead/freeze_before_end) e mescla o spec por cima
    spec="$(jq -cn --argjson t "$t" --argjson s "$spec" --argjson st "$st" '
      ($t + {start:$st, end:($st + ($t.duration // 10800))}) as $base
      | ($base + (if $base.login_lead then {login_start:($st - $base.login_lead)} else {} end)
               + (if $base.freeze_before_end then {freeze:($base.end - $base.freeze_before_end)} else {} end)
         | del(.duration, .login_lead, .freeze_before_end)) + $s')"
  fi
  # --mode vence o spec/template (como --id/--name). A mesma allowlist do servidor; `outro` é só de
  # admin e o servidor recusa com 403 — aqui a mensagem já diz os valores certos.
  if [[ -n "$mode" ]]; then
    mode="${mode,,}"
    [[ "$mode" =~ ^(icpc|obi|treino|heuristic|outro)$ ]] || die "--mode aceita icpc, obi, treino ou heuristic (outro = só admin) — recebi '$mode'"
    spec="$(jq -c --arg v "$mode" '.mode=$v' <<<"$spec")"
  fi
  [[ -n "$id" ]] && spec="$(jq -c --arg v "$id" '.id=$v' <<<"$spec")"
  [[ -n "$name" ]] && spec="$(jq -c --arg v "$name" '.name=$v' <<<"$spec")"
  [[ -n "$start" ]] && spec="$(jq -c --argjson v "$start" '.start=$v' <<<"$spec")"
  [[ -n "$end" ]] && spec="$(jq -c --argjson v "$end" '.end=$v' <<<"$spec")"
  # --empty é aplicado DEPOIS do spec/template: a leitura do arquivo (acima) reescreve $spec inteiro
  [[ "$empty" == 1 ]] && spec="$(jq -c '.allow_empty=true' <<<"$spec")"
  # --modules a,b: liga os ids por cima do spec/template (uma seção já presente só ganha on:true)
  if [[ -n "$mods" ]]; then
    [[ "$mods" =~ ^[a-z]+(,[a-z]+)*$ ]] || die "--modules espera ids separados por vírgula (ex.: maquinas,baloes)"
    spec="$(jq -c --arg m "$mods" '.modules = ((.modules // {}) + (($m|split(",")) | map(select(length>0)) | map({key:., value:true}) | from_entries))
      | .modules |= with_entries(if (.value|type) == "object" and ($m|split(",")|index(.key)) then .value.on = true else . end)' <<<"$spec")"
  fi
  [[ "$(jq -r '.end // empty' <<<"$spec")" ]] || die "faltou o fim: --end <epoch> (ou spec/template com end/duration)"
  local tmp; tmp="$(mktemp)"; printf '%s' "$spec" > "$tmp"
  CONTEST=treino api_post_file "/treino/contest-create/create" "$tmp" | out '"criado: \(.contest_id)  admin: \(.admin_login)\(if .admin_password then "  senha: \(.admin_password)" else " (conta reutilizada)" end)\n  url: \(.url)"'
  rm -f "$tmp"
  # usuários COMPARTILHADOS do treino: as consequências que ninguém adivinha (o assistente da web pede "Entendi")
  if [[ -n "$(jq -r '.users_from // empty' <<<"$spec")" ]]; then
    printf '%s\n' "⚠ usuários COMPARTILHADOS do treino: login e senha são os do Treino Livre (você não vê nem redefine;" \
      "  etiquetas sem senha); qualquer conta de lá entra se a inscrição estiver desligada; juiz/staff = contas" \
      "  próprias (users add). Para prova: moj-contest -c <id> users convert (prévia) e --apply — sem volta." >&2
  fi; }
cmd_list(){ need_login_t
  api_t GET "/treino/contest-create/mine" | out '.contests[]? | "\(.id)\t\(.mode)\t\(.problems_count) probs\t\(.name)"' | { column -t -s$'\t' 2>/dev/null || cat; }; }
cmd_show(){ need_login_t; [[ $# -ge 1 ]] || die "uso: moj-contest show <cid>"
  api_t GET "/treino/contest-create/export?id=$(enc "$1")" | out '
    "id: \(.id)\nnome: \(.name)\nmodo: \(.mode)\(if .priority then "  prioridade: \(.priority)" else "" end)\ninício: \(.start|todate)  fim: \(.end|todate)\nproblemas: \((.problems//[])|map("\(.letter)·\(.name)")|join("  "))\(if .languages then "\nlinguagens: \(.languages|join(" "))" else "" end)\nmódulos: \((.modules // {}) | to_entries | map(select(.value == true or ((.value|type) == "object" and .value.on != false)) | .key) | if length > 0 then join(", ") else "nenhum (prova comum)" end)"'; }
cmd_export(){ need_login_t; [[ $# -ge 1 ]] || die "uso: moj-contest export <cid> [arquivo] [--full]"
  local cid="$1" outf="" full="" a; shift || true
  for a in "$@"; do case "$a" in --full) full='&full_statements=1';; *) outf="$a";; esac; done
  [[ -n "$outf" ]] || outf="$cid-spec.json"
  CONTEST=treino api_get_to_file "/treino/contest-create/export?id=$(enc "$cid")$full" "$outf"
  echo "exportado: $outf ($(wc -c < "$outf") bytes)"; }
cmd_duplicate(){ need_login_t; [[ $# -ge 1 ]] || die "uso: moj-contest duplicate <cid> [--id X] [--name N] [--start E] [--end E]"
  local from="$1" body='{}' a; shift
  body="$(jq -cn --arg f "$from" '{from:$f}')"
  while [[ $# -gt 0 ]]; do a="$1"; shift
    case "$a" in
      --id) body="$(jq -c --arg v "$1" '.id=$v' <<<"$body")"; shift;;
      --name) body="$(jq -c --arg v "$1" '.name=$v' <<<"$body")"; shift;;
      --start) body="$(jq -c --argjson v "$1" '.start=$v' <<<"$body")"; shift;;
      --end) body="$(jq -c --argjson v "$1" '.end=$v' <<<"$body")"; shift;;
      *) die "opção desconhecida: $a";;
    esac
  done
  api_t POST "/treino/contest-create/duplicate" "$body" | out '"criado: \(.contest_id)  admin: \(.admin_login)\(if .admin_password then "  senha: \(.admin_password)" else "" end)\n  url: \(.url)"'; }
cmd_template(){ need_login_t; local sub="${1:-list}"; shift || true
  case "$sub" in
    list|ls) api_t GET "/treino/contest-create/templates" | out '.templates[]? | "\(.name)\t\(.mode//"?")\t\(if .duration then "\(.duration/3600|floor)h" else "-" end)\t\(if .has_problems then "com problemas" else "" end)"' | { column -t -s$'\t' 2>/dev/null || cat; };;
    show) [[ $# -ge 1 ]] || die "uso: template show <nome>"; api_t GET "/treino/contest-create/templates?name=$(enc "$1")" | { [[ "$RAW" == 1 ]] && cat || jq '.template'; };;
    save) [[ $# -ge 1 ]] || die "uso: template save <nome> (--from-contest <cid> [--with-problems] | --from-file f.json)"
      local name="$1" from="" file="" withp=false a; shift
      while [[ $# -gt 0 ]]; do a="$1"; shift
        case "$a" in
          --from-contest) from="$1"; shift;;
          --from-file) file="$1"; shift;;
          --with-problems) withp=true;;
          *) die "opção desconhecida: $a";;
        esac
      done
      if [[ -n "$from" ]]; then
        api_t POST "/treino/contest-create/templates" "$(jq -cn --arg n "$name" --arg f "$from" --argjson w "$withp" '{op:"save",name:$n,from_contest:$f,include_problems:$w}')" | out '"salvo: \(.name)"'
      elif [[ -n "$file" ]]; then
        [[ -f "$file" ]] || die "arquivo não existe: $file"
        local tmp; tmp="$(mktemp)"
        jq -c --arg n "$name" '{op:"save",name:$n,template:.}' "$file" > "$tmp" || { rm -f "$tmp"; die "JSON inválido: $file"; }
        CONTEST=treino api_post_file "/treino/contest-create/templates" "$tmp" | out '"salvo: \(.name)"'; rm -f "$tmp"
      else die "informe --from-contest <cid> ou --from-file <f.json>"; fi;;
    rm|delete) [[ $# -ge 1 ]] || die "uso: template rm <nome>"; api_t POST "/treino/contest-create/templates" "$(jq -cn --arg n "$1" '{op:"delete",name:$n}')" | out '"removido: \(.name)"';;
    rename) [[ $# -ge 2 ]] || die "uso: template rename <nome> <novo>"; api_t POST "/treino/contest-create/templates" "$(jq -cn --arg n "$1" --arg m "$2" '{op:"rename",name:$n,new_name:$m}')" | out '"renomeado p/: \(.name)"';;
    *) die "template: sub desconhecido '$sub' (list|show|save|rm|rename)";;
  esac; }
