              team_members_lose_login:"cada time vira UMA conta (login time-…) com senha única; os membros deixam de entrar com as contas deles",
              member_history_disabled:"membros de time que já submeteram viram contas desabilitadas (a linha do placar fica)",
              new_scoreboard_rows:"quem entrou sem submeter passa a aparecer zerado no placar",
              never_entered_excluded:"quem nunca entrou neste contest não ganha conta (users add depois)",
              registration_closes:"a inscrição é encerrada e o roster, arquivado",
              superadmins_lose_access:"os superadmins do treino deixam de entrar neste contest",
              admin_local_created:"o admin ganha conta própria com senha NOVA (a do treino deixa de valer aqui)"}[.] // .;
  .counts as $c
  | "contest \(.contest) — fase: \(.phase) · sessões abertas: \(.sessions_live) · inscrição: \(if .registration then "sim" else "não" end)",
    "  \($c.individuals) participante(s) ganham conta própria (\($c.from.dir) com pasta · \($c.from.session) sessão · \($c.from.access_log) log de acessos · \($c.from.registration) inscritos)",
    "  \($c.teams) time(s) — uma conta cada; \($c.members_losing_login) membro(s) passam a entrar pelo time; \($c.members_with_history) membro(s) com submissão ficam desabilitados",
    (if .admin then "  admin: \(.admin) ganha conta local com senha NOVA" else empty end),
    (if $c.resumed > 0 then "  \($c.resumed) já convertida(s) numa tentativa anterior (senha nas etiquetas)" else empty end),
    (.warnings[] | "  ⚠ " + aviso),
    "plan_id: \(.plan_id)"'; }
# pergunta no terminal; sem terminal (script), lê a resposta do stdin — que é explícita do mesmo jeito
_uc_ask(){ local c=""
  if { : </dev/tty; } 2>/dev/null; then read -rp "$1" c </dev/tty || true
  else printf '%s' "$1" >&2; read -r c || true; fi
  printf '%s' "$c"; }
users_convert(){ local apply=0 logout=false csv="" a
  while [[ $# -gt 0 ]]; do a="$1"; shift
    case "$a" in --apply) apply=1;; --logout-all) logout=true;; --csv) csv="${1:-}"; shift || true; [[ -n "$csv" ]] || die "--csv espera um arquivo";; *) die "opção: $a";; esac
  done
  local r pv; r="$(api POST "/contest/admin/users-convert$(qc)" '{"dry_run":true}')" || exit 1
  pv="$(jq -c .preview <<<"$r")"
  [[ "$RAW" == 1 && "$apply" == 0 ]] && { printf '%s\n' "$r"; return 0; }
  _uc_print_preview <<<"$pv"
  [[ "$apply" == 1 ]] || { echo; echo "(prévia — nada foi gravado. Para converter: users convert --apply)"; return 0; }
  local phase pid cf c; phase="$(jq -r .phase <<<"$pv")"; pid="$(jq -r .plan_id <<<"$pv")"
  echo
  if [[ "$phase" == before ]]; then
    c="$(_uc_ask "converter '$CONTEST' em contas próprias? NÃO tem volta. (digite sim) ")"
    [[ "$c" == sim ]] || die "abortado."; cf=true
  else
    c="$(_uc_ask "a prova JÁ COMEÇOU. Digite o id do contest ($CONTEST) para confirmar: ")"
    [[ "$c" == "$CONTEST" ]] || die "abortado."; cf="$(jq -cn --arg c "$c" '$c')"
  fi
  local tmp rf resp rc=0; tmp="$(mktemp)"; rf="$(mktemp)"
  jq -cn --arg p "$pid" --argjson cf "$cf" --argjson lo "$logout" '{dry_run:false, plan_id:$p, confirm:$cf, logout_all:$lo}' > "$tmp"
  # fora de $(…): o API_LAST_BODY do 409 tem de chegar a este shell (ver o push do `moj`)
  API_SOFT=1 api_post_file "/contest/admin/users-convert$(qc)" "$tmp" > "$rf" 2>/dev/null || rc=$?
  resp="$(cat "$rf")"; rm -f "$tmp" "$rf"
  if (( rc != 0 )); then
    if [[ "$(jq -r '.error.code // empty' <<<"${API_LAST_BODY:-}" 2>/dev/null)" == plan_changed ]]; then
      echo "a lista de contas MUDOU desde a prévia (alguém entrou ou se inscreveu) — a prévia nova:" >&2
      jq -c '.error.preview' <<<"$API_LAST_BODY" | _uc_print_preview >&2
      die "nada foi gravado; confira e rode de novo."
    fi
    API_SOFT=0 _api_fail "${API_LAST_CODE:-}" "${API_LAST_BODY:-}"; return 1
  fi
  [[ "$RAW" == 1 ]] && { printf '%s\n' "$resp"; return 0; }
  jq -r '"convertido: \([.credentials[] | select(.password)] | length) conta(s) com senha nova · sessões encerradas: \(.sessions_removed)"
         + (if .registrations_archived then "\nroster arquivado em \(.registrations_archived)" else "" end)' <<<"$resp"
  jq -r '.credentials[] | select(.kind == "admin" and .password) | "⚠ sua senha de admin agora é \(.password) (\(.login)) — a do treino não vale mais aqui"' <<<"$resp"
  if [[ -n "$csv" ]]; then
    ( umask 077; jq -r '["login","senha","nome","tipo"], (.credentials[] | select(.password) | [.login, .password, .fullname, .kind]) | @csv' <<<"$resp" > "$csv" ) \
      || die "não consegui gravar $csv"
    echo "credenciais em $csv (só você lê). Etiquetas: $MOJ_URL/contest/badges/?c=$(enc "$CONTEST")"
  else
    echo "credenciais (só aparecem agora; depois, nas etiquetas: $MOJ_URL/contest/badges/?c=$(enc "$CONTEST")):"
    jq -r '.credentials[] | select(.password) | "\(.login)\t\(.password)\t\(.fullname // "")"' <<<"$resp" | { column -t -s$'\t' 2>/dev/null || cat; }
  fi
  jq -r '[.credentials[] | select(.kind == "member_disabled") | .login] | select(length > 0) | "membros desabilitados (entram pelo time): " + join(" ")' <<<"$resp"
}
# regions — sedes (GET/POST /contest/admin/regions)
_rg_show(){ jq -r '
  .summary as $s
  | "logins: \($s.logins) · gravada \($s.counts.explicit) · órfã \($s.counts.orphan) · regex \($s.counts.regex) · parou no pai \($s.counts.stopped) · sem sede \($s.counts.none)",
    ($s.nodes[] | ("  " * (.depth + 1)) + .name + (if .view then "  [recorte]" else "" end) + (if .orphan then "  [órfã: nome gravado fora da árvore]" else "" end)
                  + (if .err then "  ⚠ regex recusada (\(.err))" else "" end) + "  — \(.members)"),
    (if ($s.stopped | length) > 0 then "parou no pai: " + ($s.stopped | join(" ")) else empty end),
    (if ($s.none | length) > 0 then "sem sede: " + ($s.none | join(" ")) else empty end)'; }
_rg_post(){  # <json> — POST; 422/409 mostram o porquê (nó e código) e morrem
  local tmp rf rc=0; tmp="$(mktemp)"; rf="$(mktemp)"; printf '%s' "$1" > "$tmp"
  API_SOFT=1 api_post_file "/contest/admin/regions$(qc)" "$tmp" > "$rf" 2>/dev/null || rc=$?
  local out; out="$(cat "$rf")"; rm -f "$tmp" "$rf"
  if (( rc != 0 )); then
    jq -r '.error.nodes[]? | "  ⚠ \(.path): \(.err)   regex: \(.regex)"' <<<"${API_LAST_BODY:-}" >&2 2>/dev/null
    API_SOFT=0 _api_fail "${API_LAST_CODE:-}" "${API_LAST_BODY:-}"; return 1
  fi
  printf '%s' "$out"; }
cmd_regions(){ need_contest; need_login; local sub="${1:-show}"; shift || true
  case "$sub" in
    show) local r; r="$(api GET "/contest/admin/regions$(qc)")" || exit 1
      [[ "$RAW" == 1 ]] && { printf '%s\n' "$r"; return 0; }; _rg_show <<<"$r";;
    get) local r; r="$(api GET "/contest/admin/regions$(qc)")" || exit 1
      if [[ -n "${1:-}" ]]; then jq '.tree' <<<"$r" > "$1" && echo "árvore em $1 (sig $(jq -r .sig <<<"$r"))"; else jq '.tree' <<<"$r"; fi;;
    set) [[ $# -ge 1 && -f "$1" ]] || die "uso: regions set <arq.json> [--dry-run] [--mode simple|rules|tree]"
      local f="$1" dry=false mode="" a sig r; shift
      while [[ $# -gt 0 ]]; do a="$1"; shift; case "$a" in --dry-run) dry=true;; --mode) mode="${1:-}"; shift || true;; *) die "opção: $a";; esac; done
      jq -e 'type == "array"' "$f" >/dev/null 2>&1 || die "$f não é uma lista JSON de sedes"
      sig="$(api GET "/contest/admin/regions$(qc)" | jq -r .sig)" || exit 1
      r="$(_rg_post "$(jq -c --argjson d "$dry" --arg s "$sig" --arg m "$mode" '{tree:., dry_run:$d, expect_sig:$s} + (if $m != "" then {mode:$m} else {} end)' "$f")")" || exit 1
      [[ "$RAW" == 1 ]] && { printf '%s\n' "$r"; return 0; }
      [[ "$dry" == true ]] && echo "(prévia — nada foi gravado)" || echo "gravado (sig $(jq -r .sig <<<"$r"))"
      _rg_show <<<"$r";;
    who) [[ $# -ge 1 ]] || die "uso: regions who <login>"
      api GET "/contest/admin/regions$(qc)&login=$(enc "$1")" | out '"\(.login): \(if .site then .site.name else "(sem sede)" end)  [\({"x":"gravada","o":"gravada, fora da árvore","r":"regex","p":"regex, parou no pai","-":"—"}[.flag] // .flag)]\n  nós: \([.nodes[] | .name + (if .view then " (recorte)" else "" end)] | join(" · "))"';;
    assign|unassign)
      local lines="" dry=false a
      if [[ "$sub" == assign && "${1:-}" == --csv ]]; then
        [[ -f "${2:-}" ]] || die "uso: regions assign --csv <arq> [--dry-run]   (linhas login,sede)"
        lines="$(tr -d '\r' < "$2" | awk -F, 'NF >= 1 && $1 !~ /^ *(login)? *$/ { l = $1; $1 = ""; r = substr($0, 2); gsub(/^ +| +$/, "", l); gsub(/^ +| +$/, "", r); print l "\t" r }')"
        shift 2; for a in "$@"; do [[ "$a" == --dry-run ]] && dry=true; done
      elif [[ "$sub" == assign ]]; then [[ $# -ge 2 ]] || die "uso: regions assign <login> <sede>"; lines="$(printf '%s\t%s' "$1" "$2")"
      else [[ $# -ge 1 ]] || die "uso: regions unassign <login>"; lines="$(printf '%s\t' "$1")"; fi
      local r; r="$(_rg_post "$(jq -Rsc --argjson d "$dry" '{dry_run:$d, assign:[split("\n")[] | select(length > 0) | split("\t") | {login:.[0], region:(.[1] // "")}]}' <<<"$lines")")" || exit 1
      [[ "$RAW" == 1 ]] && { printf '%s\n' "$r"; return 0; }
      [[ "$dry" == true ]] && { echo "(prévia — nada foi gravado)"; _rg_show <<<"$r"; }
      jq -r '((.assigned // [])[] | "  ✓ \(.login)\(if .target != .login then " → time \(.target)" else "" end)"), ((.failed // [])[] | "  ✗ \(.login): \(.code)")' <<<"$r";;
    map) local r; r="$(api GET "/contest/admin/regions$(qc)&map=1")" || exit 1
      if [[ "${1:-}" == --csv ]]; then jq -r '"login,sede,como", (.map[] | [.login, (.site // ""), .flag] | @csv)' <<<"$r"
      else jq -r '.map[] | "\(.login)\t\(.site // "—")\t\(.flag)"' <<<"$r" | { column -t -s$'\t' 2>/dev/null || cat; }; fi;;
    *) die "regions: sub desconhecido '$sub' (show|get|set|who|assign|unassign|map)";;
  esac; }
