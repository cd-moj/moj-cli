# ---- documentos da prova (info sheet, caderno, folha de time limits, editorial) ------------
# `ls`/`get` valem p/ QUALQUER conta do contest (a sede baixa o que foi publicado; o gate é do
# servidor). O resto exige sessão .admin ou .cjudge — a API corta o que o login não pode.
_doc_type(){ case "$1" in
    info|info-sheet|ambiente) printf 'info-sheet';;
    caderno|contest|prova|problemset) printf 'contest';;
    times|tl|tempos) printf 'times';;
    editorial|solucoes|soluções) printf 'editorial';;
    *) die "tipo desconhecido: $1 (info | caderno | times | editorial)";;
  esac; }
_doc_lang(){ case "$1" in pt|PT) printf pt;; en|EN) printf en;; *) die "lang deve ser pt ou en";; esac; }
cmd_docs(){ need_contest; need_login; local sub="${1:-ls}"; shift || true
  case "$sub" in
    ls|list)
      local r; r="$(api GET "/contest/doc$(qc)")"
      [[ "$(jq -r '(.docs|length)' <<<"$r" 2>/dev/null)" == 0 ]] && \
        echo "(nenhum documento $(jq -e '.can_manage' <<<"$r" >/dev/null 2>&1 && echo gerado || echo publicado) ainda)" >&2
      printf '%s' "$r" | out '.docs[]? |
        "\(.type)\t\(.lang)\tPDF \((.pdf_bytes/1024|floor))KB\tHTML \((.html_bytes/1024|floor))KB\t\(.generated_at|todate)\t\(if .published then "publicado" else "" end)"' \
        | { column -t -s$'\t' 2>/dev/null || cat; };;
    gen|generate)
      local types='[]' langs='["pt","en"]' a
      while [[ $# -gt 0 ]]; do a="$1"; shift
        case "$a" in
          --lang) [[ "$1" == both || "$1" == ambos ]] && langs='["pt","en"]' || langs="$(jq -cn --arg l "$(_doc_lang "$1")" '[$l]')"; shift;;
          -*) die "opção desconhecida: $a";;
          *) types="$(jq -c --arg t "$(_doc_type "$a")" '. + [$t]' <<<"$types")";;
        esac
      done
      [[ "$types" == '[]' ]] && types='["info-sheet","contest","times"]'
      echo "gerando (converter PDF leva alguns segundos)…" >&2
      api POST "/contest/admin/docs$(qc)" "$(jq -cn --argjson t "$types" --argjson l "$langs" '{action:"generate",types:$t,langs:$l}')" \
        | out '"gerados: \(.counts.ok)\(if .counts.fail > 0 then "  FALHARAM: \(.counts.fail) (\((.failed//[])|map(.type+"."+.lang)|join(", ")))" else "" end)"';;
    get|download)
      [[ $# -ge 1 ]] || die "uso: docs get <info|caderno|times|editorial|all> [--lang pt|en|both] [--fmt pdf|html] [-o arquivo]"
      local what="$1" fmt=pdf outf="" langs=(pt) a; shift
      while [[ $# -gt 0 ]]; do a="$1"; shift
        case "$a" in
          --lang) if [[ "$1" == both || "$1" == ambos ]]; then langs=(pt en); else langs=("$(_doc_lang "$1")"); fi; shift;;
          --fmt) [[ "$1" == pdf || "$1" == html ]] || die "fmt deve ser pdf ou html"; fmt="$1"; shift;;
          -o|--out) outf="$1"; shift;;
          *) die "opção desconhecida: $a";;
        esac
      done
      local types=() t l f
      if [[ "$what" == all || "$what" == todos ]]; then types=(info-sheet contest times editorial)
      else types=("$(_doc_type "$what")"); fi
      [[ -n "$outf" && ( ${#types[@]} -gt 1 || ${#langs[@]} -gt 1 ) ]] && die "-o só com UM tipo e UM idioma"
      # em lote, documento ausente (não gerado/não publicado — a sede só vê o publicado) é
      # AVISO e segue; pedindo UM arquivo específico, o erro da API vale (subshell contém o die)
      local lote=0; (( ${#types[@]} > 1 || ${#langs[@]} > 1 )) && lote=1
      for t in "${types[@]}"; do for l in "${langs[@]}"; do
        f="${outf:-$CONTEST-$t.$l.$fmt}"
        if (( lote )); then
          if ( api_get_to_file "/contest/doc$(qc)&type=$(enc "$t")&lang=$(enc "$l")&fmt=$(enc "$fmt")" "$f" ) 2>/dev/null; then
            echo "$f ($(wc -c <"$f" | tr -d '[:space:]') bytes)"
          else echo "$t.$l: indisponível (não gerado, ou não publicado p/ o seu login)" >&2; fi
        else
          api_get_to_file "/contest/doc$(qc)&type=$(enc "$t")&lang=$(enc "$l")&fmt=$(enc "$fmt")" "$f"
          echo "$f ($(wc -c <"$f" | tr -d '[:space:]') bytes)"
        fi
      done; done;;
    publish|unpublish)
      [[ $# -ge 1 ]] || die "uso: docs $sub <info|caderno|times|editorial> [--lang pt|en] [--news]"
      local t; t="$(_doc_type "$1")"; shift
      local l=pt news=false a
      while [[ $# -gt 0 ]]; do a="$1"; shift
        case "$a" in --lang) l="$(_doc_lang "$1")"; shift;; --news|--noticia) news=true;; *) die "opção desconhecida: $a";; esac
      done
      api POST "/contest/admin/docs$(qc)" "$(jq -cn --arg a "$sub" --arg t "$t" --arg l "$l" --argjson n "$news" \
        '{action:$a,type:$t,lang:$l} + (if $a=="publish" then {news:$n} else {} end)')" \
        | out '"ok — publicados: \(if ((.published//[])|length)>0 then (.published|join(", ")) else "(nenhum)" end)\(if .news then "  + notícia criada" else "" end)"';;
    cover|capa)
      # docs cover <arquivo.pdf> [--lang pt]   |   docs cover --rm [--lang pt]
      local file="" rm=0 l=pt a
      while [[ $# -gt 0 ]]; do a="$1"; shift
        case "$a" in --lang) l="$(_doc_lang "$1")"; shift;; --rm|--remove) rm=1;; -*) die "opção desconhecida: $a";; *) file="$a";; esac
      done
      if [[ "$rm" == 1 ]]; then
        api POST "/contest/admin/docs$(qc)" "$(jq -cn --arg l "$l" '{action:"cover",lang:$l,remove:true}')" | out '"capa removida ('"$l"')"'
      else
        [[ -f "$file" ]] || die "uso: docs cover <arquivo.pdf> [--lang pt]   (ou --rm)"
        local tmp; tmp="$(mktemp)"
        jq -cn --arg l "$l" --arg b "$(_b64enc "$file")" '{action:"cover",lang:$l,pdf_b64:$b}' > "$tmp"
        api_post_file "/contest/admin/docs$(qc)" "$tmp" | out '"capa enviada ('"$l"'): \(.bytes) bytes — gere o caderno de novo"'
        rm -f "$tmp"
      fi;;
    set)
      [[ $# -ge 1 ]] || die "uso: docs set caderno_version=v1.2 [errata=…] [cover_note=…]"
      local body='{}' kv k v
      for kv in "$@"; do
        k="${kv%%=*}"; v="${kv#*=}"; [[ "$k" != "$kv" ]] || die "esperado k=v: $kv"
        case "$k" in
          caderno_version|errata|cover_note) body="$(jq -c --arg k "$k" --arg v "$v" '.[$k]=$v' <<<"$body")";;
          *) die "campo desconhecido: $k (caderno_version|errata|cover_note)";;
        esac
      done
      api POST "/contest/admin/docs$(qc)" "$(jq -c '. + {action:"config"}' <<<"$body")" | out '"salvo"';;
    text|texto)
      # docs text <info|capa> [--lang pt] [--show | --from <arquivo>|- | --reset]
      [[ $# -ge 1 ]] || die "uso: docs text <info|capa> [--lang pt] [--show | --from <arq>|- | --reset]"
      local which="$1" l=pt mode=show src="" a; shift
      case "$which" in info|info-sheet) which=info_sheet;; capa|cover) which=cover;; *) die "docs text: use 'info' ou 'capa'";; esac
      while [[ $# -gt 0 ]]; do a="$1"; shift
        case "$a" in
          --lang) l="$(_doc_lang "$1")"; shift;;
          --show) mode=show;;
          --reset) mode=reset;;
          --from) mode=set; src="$1"; shift;;
          *) die "opção desconhecida: $a";;
        esac
      done
      local key="${which}_${l}"
      case "$mode" in
        show) api GET "/contest/admin/docs$(qc)" | jq -r --arg k "$key" '.templates[$k] // ""';;
        reset) api POST "/contest/admin/docs$(qc)" "$(jq -cn --arg k "$key" '{action:"config"} + {($k):""}')" | out '"texto '"$key"' voltou ao padrão"';;
        set) local txt tmp
          if [[ "$src" == - ]]; then txt="$(cat)"; else [[ -f "$src" ]] || die "arquivo não existe: $src"; txt="$(cat "$src")"; fi
          tmp="$(mktemp)"; jq -cn --arg k "$key" --arg v "$txt" '{action:"config"} + {($k):$v}' > "$tmp"
          api_post_file "/contest/admin/docs$(qc)" "$tmp" | out '"texto '"$key"' salvo"'; rm -f "$tmp";;
      esac;;
    *) die "docs: sub desconhecido '$sub' (ls|gen|get|publish|unpublish|cover|set|text)";;
  esac; }

# ---- rodadas (aquecimento -> prova oficial no MESMO contest) --------------------------------
# `ls` vale p/ qualquer conta do contest (a sede acompanha); o resto exige .admin.
_rd_epoch(){ # aceita epoch, "+90m"/"+2h" (a partir de agora) ou "YYYY-MM-DD HH:MM"
  local v="$1"
  case "$v" in
    ''|0) printf 0;;
    +*m) printf '%s' $(( $(date +%s) + ${v#+} * 60 ));;
    +*h) printf '%s' $(( $(date +%s) + ${v%h} * 3600 ));;
    *[0-9]) [[ "$v" =~ ^[0-9]{9,}$ ]] && printf '%s' "$v" || date -d "$v" +%s 2>/dev/null || die "data inválida: $v";;
    *) die "data inválida: $v";;
  esac
}
cmd_rounds(){ need_contest; need_login; local sub="${1:-ls}"; shift || true
  case "$sub" in
    ls|list)
      api GET "/contest/admin/rounds$(qc)" > /tmp/.moj-rd.$$ 2>/dev/null \
        || { api GET "/contest/rounds$(qc)" | out '.rounds[]? |
               "\(.slug)\t\(.state)\t\(.kind//"")\t\(.name)"' | { column -t -s$'\t' 2>/dev/null || cat; }; return 0; }
      out '.rounds[]? | "\(.slug)\t\(.state)\t\(.kind//"")\t\((.start//0)|if .>0 then (.|todate) else "-" end)\t\((.end//0)|if .>0 then (.|todate) else "-" end)\t\((.problems//[])|length) prob\t\(.name)\(if .published then "\tPUBLICADA" else "" end)"' \
        < /tmp/.moj-rd.$$ | { column -t -s$'\t' 2>/dev/null || cat; }
      local pr; pr="$(jq -c '.promote_ready // {}' /tmp/.moj-rd.$$ 2>/dev/null)"
      if [[ -n "$pr" && "$pr" != '{}' ]]; then
        if [[ "$(jq -r '.ok' <<<"$pr")" == true ]]; then
          echo "próxima: $(jq -r '.next // "(nenhuma)"' /tmp/.moj-rd.$$) — pronta p/ promover" >&2
        else
          echo "próxima: $(jq -r '.next // "(nenhuma)"' /tmp/.moj-rd.$$) — BLOQUEADA:" >&2
          jq -r '.blockers[]? | "  ⛔ \(.code): \(.detail)"' <<<"$pr" >&2
        fi
      fi
      rm -f /tmp/.moj-rd.$$;;
    add)
      [[ $# -ge 1 ]] || die "uso: rounds add <slug> --name N --start <epoch|+90m|'AAAA-MM-DD HH:MM'> --end <…> [--freeze <…>] [--kind warmup|official|extra]"
      local slug="$1" nm="" st=0 en=0 fz=0 kd=official a; shift
      while [[ $# -gt 0 ]]; do a="$1"; shift
        case "$a" in
          --name) nm="$1"; shift;; --kind) kd="$1"; shift;;
          --start) st="$(_rd_epoch "$1")"; shift;; --end) en="$(_rd_epoch "$1")"; shift;;
          --freeze) fz="$(_rd_epoch "$1")"; shift;;
          *) die "opção desconhecida: $a";;
        esac
      done
      api POST "/contest/admin/rounds$(qc)" "$(jq -cn --arg s "$slug" --arg n "${nm:-$slug}" --arg k "$kd" \
        --argjson st "$st" --argjson en "$en" --argjson fz "$fz" \
        '{action:"add",slug:$s,name:$n,kind:$k,start:$st,end:$en,freeze:$fz}')" \
        | out '"criada: '"$slug"'"';;
    set)
      [[ $# -ge 1 ]] || die "uso: rounds set <slug> [--name N] [--start …] [--end …] [--freeze …] [--kind …]"
      local slug="$1" body a; shift
      body="$(jq -cn --arg s "$slug" '{action:"set",slug:$s}')"
      while [[ $# -gt 0 ]]; do a="$1"; shift
        case "$a" in
          --name) body="$(jq -c --arg v "$1" '.name=$v' <<<"$body")"; shift;;
          --kind) body="$(jq -c --arg v "$1" '.kind=$v' <<<"$body")"; shift;;
          --slug|--rename) body="$(jq -c --arg v "$1" '.new_slug=$v' <<<"$body")"; shift;;
          --start)  body="$(jq -c --argjson v "$(_rd_epoch "$1")" '.start=$v'  <<<"$body")"; shift;;
          --end)    body="$(jq -c --argjson v "$(_rd_epoch "$1")" '.end=$v'    <<<"$body")"; shift;;
          --freeze) body="$(jq -c --argjson v "$(_rd_epoch "$1")" '.freeze=$v' <<<"$body")"; shift;;
          *) die "opção desconhecida: $a";;
        esac
      done
      api POST "/contest/admin/rounds$(qc)" "$body" | out '"ok: \(.round.slug) \((.round.start)|todate) -> \((.round.end)|todate)"';;
    problems|probs)
      [[ $# -ge 1 ]] || die "uso: rounds problems <slug> [ls] | <slug> set <id>[,<id>…] | <slug> add <id> | <slug> rm <letra>"
      local slug="$1" op="${2:-ls}"; shift || true; shift || true
      local cur; cur="$(api GET "/contest/admin/rounds$(qc)" | jq -c --arg s "$slug" '(.rounds[]?|select(.slug==$s)|.problems) // []')"
      [[ -n "$cur" ]] || die "rodada '$slug' não encontrada"
      case "$op" in
        ls) jq -r '.[] | "\(.letter // "?")\t\(.name // "")\t\(.bank_id // .problem_id // "")"' <<<"$cur" \
              | { column -t -s$'\t' 2>/dev/null || cat; }; return 0;;
        set) [[ $# -ge 1 ]] || die "uso: rounds problems <slug> set <id>[,<id>…]"
             cur="$(jq -cn --arg v "$1" '$v | split(",") | map(select(length>0)) | to_entries
                    | map({bank_id:.value, letter:([65+.key]|implode)})')";;
        add) [[ $# -ge 1 ]] || die "uso: rounds problems <slug> add <id>"
             cur="$(jq -c --arg id "$1" '. + [{bank_id:$id}]' <<<"$cur")";;
        rm)  [[ $# -ge 1 ]] || die "uso: rounds problems <slug> rm <letra>"
             cur="$(jq -c --arg l "$1" '[ .[] | select((.letter // "") != $l) ]' <<<"$cur")";;
        *) die "rounds problems: use ls|set|add|rm";;
      esac
      local tmp; tmp="$(mktemp)"
      jq -cn --arg s "$slug" --argjson p "$cur" '{action:"problems",slug:$s,problems:$p}' > "$tmp"
      api_post_file "/contest/admin/rounds$(qc)" "$tmp" | out '"ok: \(.n) problema(s) na rodada '"$slug"'"'
      rm -f "$tmp";;
    promote)
      local force=false a
      for a in "$@"; do [[ "$a" == --force ]] && force=true; done
      local st; st="$(api GET "/contest/admin/rounds$(qc)")"
      local to; to="$(jq -r '.next // ""' <<<"$st")"
      [[ -n "$to" ]] || die "nenhuma rodada planejada: crie com 'rounds add <slug> …' antes"
      if [[ "$(jq -r '.promote_ready.ok' <<<"$st")" != true && "$force" != true ]]; then
        echo "a rodada no ar NÃO está pronta p/ ser promovida:" >&2
        jq -r '.promote_ready.blockers[]? | "  ⛔ \(.code): \(.detail)"' <<<"$st" >&2
        die "resolva os bloqueadores (ou use --force, que arquiva do mesmo jeito)"
      fi
      echo "isto ARQUIVA a rodada '$(jq -r '.active' <<<"$st")' e ZERA o placar; '$to' entra no ar." >&2
      local c; read -rp "confirme digitando o id do contest ($CONTEST): " c || true
      [[ "$c" == "$CONTEST" ]] || die "não confere — nada foi alterado."
      api POST "/contest/admin/rounds$(qc)" "$(jq -cn --arg t "$to" --argjson f "$force" '{action:"promote",to:$t,force:$f}')" \
        | out '"promovida: \(.from) -> \(.to)  (arquivadas \(.archived.submissions) submissões de \(.archived.users) contas)"';;
    publish|unpublish)
      [[ $# -ge 1 ]] || die "uso: rounds $sub <slug>"
      local on=true; [[ "$sub" == unpublish ]] && on=false
      api POST "/contest/admin/rounds$(qc)" "$(jq -cn --arg s "$1" --argjson on "$on" '{action:"publish",slug:$s,on:$on}')" \
        | out '"publicada: \(.published)"';;
    rm|remove)
      [[ $# -ge 1 ]] || die "uso: rounds rm <slug>   (só rodada planejada)"
      api POST "/contest/admin/rounds$(qc)" "$(jq -cn --arg s "$1" '{action:"remove",slug:$s}')" | out '"removida"';;
    archive|get)
      [[ $# -ge 1 ]] || die "uso: rounds archive <slug> [arquivo.tar.gz]"
      local slug="$1" outf="${2:-}"; [[ -n "$outf" ]] || outf="$CONTEST-$slug.tar.gz"
      api_get_to_file "/contest/admin/round-archive$(qc)&round=$(enc "$slug")" "$outf"
      echo "$outf ($(wc -c <"$outf" | tr -d '[:space:]') bytes) — inclui código-fonte e logs da rodada";;
    *) die "rounds: sub desconhecido '$sub' (ls|add|set|problems|promote|publish|unpublish|rm|archive)";;
  esac; }

# ---- máquinas (time x IP x User-Agent da rodada) --------------------------------------------
cmd_machines(){ need_contest; need_login
  local round="" csv=0 a
  while [[ $# -gt 0 ]]; do a="$1"; shift
    case "$a" in --round) round="$1"; shift;; --csv) csv=1;; *) die "opção desconhecida: $a";; esac
  done
  local r; r="$(api GET "/contest/admin/machines$(qc)$([[ -n "$round" ]] && printf '&round=%s' "$(enc "$round")")")"
  if [[ "$RAW" == 1 ]]; then printf '%s\n' "$r"; return 0; fi
  if (( csv )); then
    printf 'login,time,sede,ip,user_agent,logins,primeiro,ultimo,trocou\n'
    jq -r '.by_login[]? as $u | $u.pairs[]? |
      [$u.login,$u.name,$u.region,.ip,.ua,(.n|tostring),(.first|todate),(.last|todate),
       (if $u.changed then "sim" else "" end)] | @csv' <<<"$r"
    return 0
  fi
  jq -r '"rodada \(.round) · \(.totals.logins) conta(s) · \(.totals.ips) IP(s) · \(.totals.changed) trocaram de máquina · \(.totals.shared_ips) IP(s) compartilhado(s)"' <<<"$r" >&2
  jq -r '.by_login[]? | "\(.login)\t\(.name)\t\(.region // "-")\t\((.ips//[])|join(","))\t\((.uas//[])|length) UA\(if .changed then "\tTROCOU" elif .multi_ip then "\t~multi-ip" else "" end)"' <<<"$r" \
    | { column -t -s$'\t' 2>/dev/null || cat; }
  local sug; sug="$(jq -r '.ua_suggestion // ""' <<<"$r")"
  [[ -n "$sug" ]] && echo "substring comum dos navegadores (candidata ao gate): $sug" >&2
  return 0; }

# ---- coortes de placar (times oficiais × convidados) ---------------------------------------
cmd_cohorts(){ need_contest; need_login; local sub="${1:-ls}"; shift || true
  case "$sub" in
    ls|list)
      local r; r="$(api GET "/contest/admin/cohorts$(qc)")"
      if [[ "$RAW" == 1 ]]; then printf '%s\n' "$r"; return 0; fi
      jq -r '.cohorts[]? | "\(.id)\t\(if .public then "pública" else "PRIVADA" end)\t\(if .unranked then "extra-oficial" else "classifica" end)\t\(.regex // "-")\t\(.name)"' <<<"$r" \
        | { column -t -s$'\t' 2>/dev/null || cat; }
      jq -r '"times por coorte: " + ([.counts // {} | to_entries[] | "\(.key)=\(.value)"] | join("  "))
             + (if .results_released then "   [RESULTADOS LIBERADOS]" else "" end)' <<<"$r" >&2
      local nb; nb="$(jq -r '(.by_regex_only // []) | length' <<<"$r")"
      (( nb > 0 )) && echo "$nb time(s) só por regex (use 'cohorts materialize' p/ carimbar)" >&2
      return 0;;
    add|set)
      [[ $# -ge 1 ]] || die "uso: cohorts $sub <id> [--name N] [--regex R] [--private|--public] [--unranked|--ranked] [--sees a,b] [--default]"
      local id="$1" body a; shift
      body="$(jq -cn --arg a "$sub" --arg i "$id" '{action:$a, id:$i}')"
      while [[ $# -gt 0 ]]; do a="$1"; shift
        case "$a" in
          --name)  body="$(jq -c --arg v "$1" '.name=$v' <<<"$body")"; shift;;
          --regex) body="$(jq -c --arg v "$1" '.regex=$v' <<<"$body")"; shift;;
          --sees)  body="$(jq -c --arg v "$1" '.sees=($v|split(",")|map(select(length>0)))' <<<"$body")"; shift;;
          --private)  body="$(jq -c '.public=false' <<<"$body")";;
          --public)   body="$(jq -c '.public=true'  <<<"$body")";;
          --unranked) body="$(jq -c '.unranked=true' <<<"$body")";;
          --ranked)   body="$(jq -c '.unranked=false' <<<"$body")";;
          --default)  body="$(jq -c '.default=true' <<<"$body")";;
          *) die "opção desconhecida: $a";;
        esac
      done
      api POST "/contest/admin/cohorts$(qc)" "$body" | out '"ok: \([.cohorts[].id] | join(", "))"';;
    rm|remove)
      [[ $# -ge 1 ]] || die "uso: cohorts rm <id>   (a default não sai; coorte com time dá 409)"
      api POST "/contest/admin/cohorts$(qc)" "$(jq -cn --arg i "$1" '{action:"rm",id:$i}')" | out '"removida"';;
    assign)
      [[ $# -ge 1 ]] || die "uso: cohorts assign <login> <coorte>   (coorte vazia = volta p/ a regra)"
      api POST "/contest/admin/cohorts$(qc)" "$(jq -cn --arg l "$1" --arg c "${2:-}" '{action:"assign",login:$l,cohort:$c}')" \
        | out '"\(.login) -> \(if .cohort == "" then "(regra)" else .cohort end)"';;
    materialize)
      api POST "/contest/admin/cohorts$(qc)" '{"action":"materialize"}' | out '"carimbados: \(.materialized)"';;
    release)
      local on=true; [[ "${1:-on}" == off ]] && on=false
      if [[ "$on" == true ]]; then
        echo "isto LIBERA os resultados: todos os times passam a ver todos (inclusive convidados)." >&2
        local c; read -rp "confirme digitando o id do contest ($CONTEST): " c || true
        [[ "$c" == "$CONTEST" ]] || die "não confere — nada foi alterado."
      fi
      api POST "/contest/admin/cohorts$(qc)" "$(jq -cn --argjson on "$on" '{action:"release",on:$on}')" \
        | out '"resultados liberados: \(.results_released)"';;
    *) die "cohorts: sub desconhecido '$sub' (ls|add|set|rm|assign|materialize|release)";;
  esac; }

# ---- gate de navegador por sede ------------------------------------------------------------
cmd_ua_gate(){ need_contest; need_login; local sub="${1:-show}"; shift || true
  case "$sub" in
    show|get)
      local r; r="$(api GET "/contest/admin/ua-gate$(qc)")"
      if [[ "$RAW" == 1 ]]; then printf '%s\n' "$r"; return 0; fi
      jq -r '.gate | "modo: \(.mode)",
        "do login: " + (if .from_login == null then "(nenhuma)" else "\(.from_login.regex)  ->  \(.from_login.expect)" end),
        "por sede: " + (if (.by_region|length) == 0 then "(nenhuma)" else ([.by_region | to_entries[] | "\(.key)=\(.value)"] | join("  ")) end),
        "por regex: " + (if (.by_regex|length) == 0 then "(nenhuma)" else ([.by_regex[] | "\(.regex)->\(.expect)"] | join("  ")) end),
        "isentos: " + (if (.exempt|length) == 0 then "(nenhum)" else (.exempt|join("  ")) end),
        "fallback: " + (if (.fallback // "") == "" then "(nenhum)" else .fallback end)' <<<"$r"
      local lg; lg="$(jq -r '.legacy // ""' <<<"$r")"
      [[ -n "$lg" ]] && echo "LOGIN_UA_SUBSTRING (legado, usado quando nada acima casa): $lg" >&2
      return 0;;
    set)
      local body='{"action":"set"}' a
      while [[ $# -gt 0 ]]; do a="$1"; shift
        case "$a" in
          --mode) body="$(jq -c --arg v "$1" '.mode=$v' <<<"$body")"; shift;;
          --from-login) body="$(jq -c --arg v "$1" '.from_login=((.from_login // {}) + {regex:$v})' <<<"$body")"; shift;;
          --expect) body="$(jq -c --arg v "$1" '.from_login=((.from_login // {}) + {expect:$v})' <<<"$body")"; shift;;
          --no-from-login) body="$(jq -c '.from_login=null' <<<"$body")";;
          --region) # --region 'Sede=substring' (repetível)
            [[ "$1" == *=* ]] || die "use --region 'Sede=substring'"
            body="$(jq -c --arg k "${1%%=*}" --arg v "${1#*=}" '.by_region=((.by_region // {}) + {($k):$v})' <<<"$body")"; shift;;
          --regex) # --regex 'REGEX=substring' (repetível)
            [[ "$1" == *=* ]] || die "use --regex 'REGEX=substring'"
            body="$(jq -c --arg k "${1%%=*}" --arg v "${1#*=}" '.by_regex=((.by_regex // []) + [{regex:$k, expect:$v}])' <<<"$body")"; shift;;
          --exempt) body="$(jq -c --arg v "$1" '.exempt=((.exempt // []) + [$v])' <<<"$body")"; shift;;
          --fallback) body="$(jq -c --arg v "$1" '.fallback=$v' <<<"$body")"; shift;;
          *) die "opção desconhecida: $a";;
        esac
      done
      # --region/--regex/--exempt SUBSTITUEM a lista inteira: junte o que já existe se quiser somar
      api POST "/contest/admin/ua-gate$(qc)" "$body" | out '"ok: modo \(.gate.mode), \(.gate.by_region|length) sede(s), \(.gate.exempt|length) isento(s)"';;
    check)
      [[ $# -ge 1 ]] || die "uso: ua-gate check <login>"
      api GET "/contest/admin/ua-gate$(qc)&login=$(enc "$1")" \
        | out '.check | "\(.login): \(if .gated then "espera \"" + .expected + "\"" else "SEM GATE (isento/papel/sem regra)" end)\(if .region != "" then "  [sede: " + .region + "]" else "" end)"';;
    *) die "ua-gate: sub desconhecido '$sub' (show|set|check)";;
  esac; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  login) cmd_login "$@";; logout) cmd_logout "$@";; whoami) cmd_whoami "$@";;
  create) cmd_create "$@";; list|ls) cmd_list "$@";; show) cmd_show "$@";;
  export) cmd_export "$@";; duplicate|dup) cmd_duplicate "$@";; template|tpl) cmd_template "$@";;
  remove) cmd_remove "$@";;
  settings|config) cmd_settings "$@";; extend) cmd_extend "$@";;
  problems|prob) cmd_problems "$@";; users|user) cmd_users "$@";;
  sessions) cmd_sessions "$@";; dashboard|dash) cmd_dashboard "$@";; score) cmd_score "$@";;
  report) cmd_report "$@";;
  audit) cmd_audit "$@";; access) cmd_access "$@";; news) cmd_news "$@";;
  docs|doc|documentos) cmd_docs "$@";;
  rounds|rodadas|round) cmd_rounds "$@";;
  cohorts|coortes) cmd_cohorts "$@";;
  ua-gate|uagate) cmd_ua_gate "$@";;
  machines|maquinas) cmd_machines "$@";;
  help|-h|--help) sed -n '2,70p' "$0" | sed 's/^# \{0,1\}//';;
  *) die "comando desconhecido: $cmd (veja 'moj-contest help')";;
esac
